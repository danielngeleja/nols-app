{
  "name": "nolsaf",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared",
    "packages/prisma"
  ],
  "devDependencies": {
    "@prisma/adapter-mariadb": "7.9.1",
    "@prisma/client": "7.9.1",
    "@prisma/debug": "7.9.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/coverage-v8": "4.1.4",
    "concurrently": "^9.0.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "snyk": "^1.1300.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-minimatch-compat.mjs && prisma generate",
    "dev": "npm --workspace=@nolsaf/web run predev && concurrently -n api,web -c green,cyan \"npm --workspace=@nolsaf/api run dev\" \"npm --workspace=@nolsaf/web run dev\"",
    "dev:flow": "powershell -NoProfile -ExecutionPolicy Bypass -File start-dev.ps1",
    "dev:npm": "npm --workspace=@nolsaf/web run predev && concurrently -n api,web -c green,cyan \"npm --workspace=@nolsaf/api run dev\" \"npm --workspace=@nolsaf/web run dev\"",
    "build": "npm run --workspaces --if-present build",
    "lint": "npm run --workspaces --if-present lint",
    "pretypecheck": "npm run --workspace=@nolsaf/shared build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "bootstrap:admin": "npm --workspace=@nolsaf/api run bootstrap:admin --",
    "bootstrap:admin:staging": "npm --workspace=@nolsaf/api run bootstrap:admin:staging",
    "bootstrap:admin:production": "npm --workspace=@nolsaf/api run bootstrap:admin:production",
    "prisma:generate": "npm run --workspace=@nolsaf/prisma generate",
    "prisma:push": "npx prisma db push --schema=prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:migrate:status": "npx prisma migrate status --schema=prisma/schema.prisma",
    "prisma:migrate:staging": "node scripts/prisma-migrate-staging.mjs",
    "prisma:migrate:staging:status": "node scripts/prisma-migrate-staging.mjs --status-only",
    "prisma:migrate:staging:cleanup": "node scripts/prisma-migrate-staging.mjs --cleanup-failed-baseline-artifacts --status-only",
    "prisma:migrate:case-recovery": "node scripts/prisma-migrate-case-recovery.mjs",
    "migrations:checksums": "node scripts/check-migration-integrity.mjs",
    "migrations:checksums:update": "node scripts/check-migration-integrity.mjs --write",
    "migrations:coverage": "node scripts/audit-schema-migration-coverage.mjs",
    "schema:check:local": "node scripts/check-physical-schema.mjs --target=local",
    "schema:check:staging": "node scripts/check-physical-schema.mjs --target=staging",
    "schema:check:clone": "node scripts/check-physical-schema.mjs --target=clone",
    "migration:validate:reconciliation": "node scripts/validate-forward-reconciliation.mjs",
    "prisma:studio": "npx prisma studio --schema=prisma/schema.prisma",
    "smoke-test": "node scripts/smoke-test.mjs",
    "smoke:driver-payouts": "npm --workspace=@nolsaf/api run smoke:driver-payouts",
    "smoke-test:staging": "API_URL=$npm_config_api_url node scripts/smoke-test.mjs",
    "uptime:check": "node scripts/uptime-check.mjs",
    "no4p-otp:cleanup": "node scripts/cleanup-no4p-otp.mjs",
    "backfill:tour-operations": "tsx scripts/backfill-tour-operations.ts"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "dotenv": "^17.2.3",
    "pdf-parse": "^2.4.5",
    "prisma": "7.9.1"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.16.0",
      "africastalking>axios": "1.16.0",
      "africastalking>lodash": "4.18.1",
      "africastalking": {
        "axios": "1.16.0",
        "lodash": "4.18.1"
      },
      "deepmerge-ts": "^8.0.2",
      "diff": "4.0.4",
      "hono": "^4.12.25",
      "@hono/node-server": "2.0.12",
      "archiver": "8.0.0",
      "brace-expansion": "5.0.9",
      "dompurify": "3.4.13",
      "esbuild": "0.28.1",
      "sanitize-html": "^2.17.4",
      "mailparser": "3.9.3",
      "js-yaml": "4.3.1",
      "jspdf": "4.2.1",
      "lodash": "4.18.1",
      "minimatch": "10.2.6",
      "nodemailer": "9.0.1",
      "postcss": "8.5.24",
      "qs": "^6.15.2",
      "sharp": "0.35.3",
      "shell-quote": "^1.8.4",
      "unzipper": "0.12.5",
      "uuid": "11.1.1",
      "xcode": {
        "uuid": "^11.1.1"
      },
      "svix": ">=1.92.0"
    }
  },
  "overrides": {
    "axios": "^1.16.0",
    "africastalking": {
      "axios": "1.16.0",
      "lodash": "4.18.1"
    },
    "deepmerge-ts": "^8.0.2",
    "diff": "4.0.4",
    "hono": "^4.12.25",
    "@hono/node-server": "2.0.12",
    "archiver": "8.0.0",
    "brace-expansion": "5.0.9",
    "dompurify": "3.4.13",
    "esbuild": "0.28.1",
    "sanitize-html": "^2.17.4",
    "magicast": "0.5.2",
    "mailparser": "3.9.3",
    "js-yaml": "4.3.1",
    "jspdf": "4.2.1",
    "lodash": "4.18.1",
    "minimatch": "10.2.6",
    "nodemailer": "9.0.1",
    "postcss": "8.5.24",
    "qs": "^6.15.2",
    "sharp": "0.35.3",
    "shell-quote": "^1.8.4",
    "unzipper": "0.12.5",
    "uuid": "11.1.1",
    "xcode": {
      "uuid": "^11.1.1"
    },
    "svix": ">=1.92.0"
  }
}
