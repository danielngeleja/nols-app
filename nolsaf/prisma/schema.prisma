  status    String   @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties NrmsPortfolioProperty[]

  @@unique([ownerId, name])
  @@index([ownerId, status])
  @@map("nrms_portfolio")
