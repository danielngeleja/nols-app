// =========================================================
//  USER DOCUMENT MODEL - For KYC/document management
// =========================================================
model UserDocument {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String? // ID, PASSPORT, BUSINESS_LICENSE, etc.
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reason    String?  @db.Text // Rejection reason
  url       String?  @db.Text // Document URL/storage key
  metadata  Json? // Additional document metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Merchant applications that attached this upload as evidence.
  merchantApplicationLinks MerchantApplicationDocument[]

  @@index([userId])
  @@index([status])
  @@map("userdocument")
}

// =========================================================
//  PASSKEY MODEL - For passwordless authentication
// =========================================================
model Passkey {
  id           Int      @id @default(autoincrement())
  userId       Int
  credentialId String   @unique // Unique credential identifier
  publicKey    String   @db.Text // Public key for verification
  transports   Json? // Array of transport methods
  signCount    Int      @default(0) // Signature count for replay protection
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialId])
  @@map("passkey")
}

// =========================================================
//  GROUP BOOKING MODEL - For managing group accommodation reservations
// =========================================================
model GroupBooking {
  id Int @id @default(autoincrement())

  /// Foreign key to User who created this booking
  userId Int

  /// Type of group: family, workers, event, students, team, other
  groupType String

  // ==================== Origin Information ====================
  /// Origin country (optional - where the group is coming from)
  fromCountry  String?
  /// Origin region (optional - where the group is coming from, only for Tanzania)
  fromRegion   String?
  /// Origin district within the region
  fromDistrict String?
  /// Origin ward/mtaa
  fromWard     String?
  /// Exact origin location (street address, landmark, GPS coordinates)
  fromLocation String?

  // ==================== Destination Information ====================
  /// Destination region (required - where accommodation is needed)
  toRegion   String
  /// Destination district within the region
  toDistrict String?
  /// Destination ward/mtaa
  toWard     String?
  /// Exact destination location (street address, landmark, GPS coordinates)
  toLocation String?

  // ==================== Accommodation Details ====================
  /// Type of accommodation: villa, apartment, hotel, hostel, lodge, etc.
  accommodationType String
  /// Minimum acceptable hotel comfort level when accommodationType is hotel
  /// Uses the same labels as owner listings: basic|simple|moderate|high|luxury
  minHotelStarLabel String? @db.VarChar(20)
  /// Total number of people in the group
  headcount         Int
  /// Number of males in the group (for accommodation planning)
  maleCount         Int?
  /// Number of females in the group (for accommodation planning)
  femaleCount       Int?
  /// Number of other/prefer not to say in the group (for accommodation planning)
  otherCount        Int?
  /// Number of persons per room (1-4)
  roomSize          Int
  /// Calculated number of rooms needed based on headcount and room size
  roomsNeeded       Int
  /// Whether private rooms are requested
  needsPrivateRoom  Boolean @default(false)
  /// Number of private rooms requested (if applicable)
  privateRoomCount  Int     @default(0)

  // ==================== Date Information ====================
  /// Check-in date and time
  checkIn  DateTime?
  /// Check-out date and time
  checkOut DateTime?
  /// Whether specific dates are being used (false = flexible dates)
  useDates Boolean   @default(true)

  // ==================== Arrangements ====================
  /// Airport/station pickup service requested
  arrPickup    Boolean @default(false)
  /// Transport between sites requested
  arrTransport Boolean @default(false)
  /// Meals included requested
  arrMeals     Boolean @default(false)
  /// On-site guide/staff requested
  arrGuide     Boolean @default(false)
  /// Special equipment requested
  arrEquipment Boolean @default(false)

  /// Pickup location details (airport terminal, hotel, etc.)
  pickupLocation   String? @db.Text
  /// Pickup time in 12-hour format (e.g., "02:30 PM")
  pickupTime       String?
  /// Additional notes about arrangements
  arrangementNotes String? @db.Text

  // ==================== Passenger Roster ====================
  /// JSON array of passenger details (firstname, lastname, phone, age, gender, nationality)
  /// Stored as JSON for flexibility; separate table available for structured queries
  roster Json?

  // ==================== Property Recommendations ====================
  /// JSON array of recommended property IDs (admin can attach 1-2 properties)
  recommendedPropertyIds Json? // Array of property IDs: [1, 2]
  /// Property ID that user confirmed (after viewing recommendations)
  confirmedPropertyId    Int?
  /// Timestamp when user confirmed a property
  propertyConfirmedAt    DateTime?
  /// Owner ID assigned to handle this group stay (admin assigns)
  assignedOwnerId        Int?
  /// Timestamp when owner was assigned
  ownerAssignedAt        DateTime?
  /// Whether this group stay is open for owners to claim (admin can open for competitive bidding)
  isOpenForClaims        Boolean   @default(false)
  /// Timestamp when opened for claims
  openedForClaimsAt      DateTime?

  // ==================== Status & Financial ====================
  /// Booking status: PENDING, AWAITING_DEPOSIT, CONFIRMED, PROCESSING, CANCELED, COMPLETED
  status            String    @default("PENDING")
  /// Total estimated or confirmed amount for the booking
  totalAmount       Decimal?  @db.Decimal(12, 2)
  /// Currency code (default: TZS)
  currency          String    @default("TZS")
  /// Deposit amount required to confirm the booking. For group stay auctions this is the NoLSAF commission amount.
  depositAmount     Decimal?  @db.Decimal(12, 2)
  /// Whether the deposit has been paid
  depositPaid       Boolean   @default(false)
  /// Timestamp when the deposit was paid
  depositPaidAt     DateTime?
  /// Deadline to pay the deposit before the offer expires (set to 24h after AWAITING_DEPOSIT)
  depositDueAt      DateTime?
  /// Owner's payout amount for this stay (their offered/discounted total, before commission markup)
  ownerAmount       Decimal?  @db.Decimal(12, 2)
  /// Commission percentage applied on top of ownerAmount to derive totalAmount (snapshot at confirm time)
  commissionPercent Decimal?  @db.Decimal(5, 2)
  /// Gateway merchant reference for the deposit payment (set when payment is initiated)
  paymentRef        String?   @unique @db.VarChar(80)
  /// AzamPay transactionId for the deposit checkout
  checkoutSessionId String?   @unique @db.VarChar(120)
  /// Phone number used to pay the deposit
  payerPhone        String?   @db.VarChar(40)
  /// Payment provider used for the deposit (e.g. AZAMPAY)
  paymentProvider   String?   @db.VarChar(40)

  // ==================== Owner Payout (group stay) ====================
  /// Timestamp when the assigned owner marked the group as checked in (triggers the payout obligation)
  checkedInAt       DateTime?
  /// Owner's payout owed by NoLSAF after check-in (deposit minus commission). The remaining balance is
  /// collected by the owner directly from the guest at the property.
  ownerPayoutAmount Decimal?  @db.Decimal(12, 2)
  /// Owner payout lifecycle: NONE | PENDING | PAID
  ownerPayoutStatus String    @default("NONE") @db.VarChar(20)
  /// Timestamp when NoLSAF marked the owner payout as paid
  ownerPayoutPaidAt DateTime?
  /// Reference for the manual payout transfer (bank/mobile money ref) recorded by admin
  ownerPayoutRef    String?   @db.VarChar(120)

  // ==================== Administrative Notes ====================
  /// Internal admin notes about this booking
  adminNotes   String?   @db.Text
  /// Reason for cancellation (if status = CANCELED)
  cancelReason String?   @db.Text
  /// Timestamp when booking was canceled
  canceledAt   DateTime?
  /// Timestamp when booking was confirmed
  confirmedAt  DateTime?

  // ==================== Metadata ====================
  /// Record creation timestamp
  createdAt DateTime @default(now())
  /// Record last update timestamp
  updatedAt DateTime @updatedAt

  // ==================== Relations ====================
  /// User who created this booking
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Owner assigned to handle this group stay
  assignedOwner     User?                   @relation("GroupBookingOwner", fields: [assignedOwnerId], references: [id], onDelete: SetNull)
  /// Property confirmed for this group stay
  confirmedProperty Property?               @relation(fields: [confirmedPropertyId], references: [id], onDelete: SetNull)
  /// Individual passenger records (alternative to JSON roster)
  passengers        GroupBookingPassenger[]
  /// Audit logs for this booking
  auditLogs         GroupBookingAudit[]
  /// Messages in the conversation
  messages          GroupBookingMessage[]
  /// Owner claims/offers for this group stay
  claims            GroupBookingClaim[]
  /// Payment events for the deposit
  paymentEvents     PaymentEvent[]

  // ==================== Indexes ====================
  @@index([userId])
  @@index([status])
  @@index([groupType])
  @@index([toRegion])
  @@index([checkIn, checkOut])
  @@index([createdAt])
  @@index([assignedOwnerId])
  @@index([confirmedPropertyId])
  @@index([ownerPayoutStatus])
  @@map("group_bookings")
}

// =========================================================
//  GROUP BOOKING AUDIT MODEL - Track admin actions
// =========================================================
model GroupBookingAudit {
  id             Int      @id @default(autoincrement())
  groupBookingId Int
  adminId        Int // Admin who performed the action
  action         String   @db.VarChar(100) // e.g., STATUS_CHANGED, MESSAGE_SENT, PROPERTY_RECOMMENDED, SUGGESTIONS_PROVIDED
  description    String?  @db.Text // Human-readable description
  metadata       Json? // Additional data (old status, new status, message content, etc.)
  createdAt      DateTime @default(now())

  // Relations
  groupBooking GroupBooking @relation(fields: [groupBookingId], references: [id], onDelete: Cascade)
  admin        User         @relation("GroupBookingAudits", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([groupBookingId])
  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("groupbookingaudit")
}

// =========================================================
//  GROUP BOOKING MESSAGE MODEL - Conversation messages
// =========================================================
model GroupBookingMessage {
  id             Int @id @default(autoincrement())
  groupBookingId Int

  /// Sender information
  senderId   Int? // User ID if sender is authenticated (admin or customer)
  senderRole String  @db.VarChar(20) // ADMIN, USER, SYSTEM
  senderName String? @db.VarChar(200) // Name for display (if not authenticated)

  /// Message content
  messageType String? @db.VarChar(50) // "Ask for Feedback", "Admin Response", etc.
  body        String  @db.Text // Message content (sanitized)

  /// Metadata
  isInternal Boolean  @default(false) // Internal notes not shown to customers
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  groupBooking GroupBooking @relation(fields: [groupBookingId], references: [id], onDelete: Cascade)
  sender       User?        @relation("GroupBookingMessages", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([groupBookingId])
  @@index([senderId])
  @@index([senderRole])
  @@index([createdAt])
  @@index([groupBookingId, createdAt])
  @@map("group_booking_messages")
}

// =========================================================
//  GROUP BOOKING CLAIM MODEL - Owner competitive offers
// =========================================================
model GroupBookingClaim {
  id Int @id @default(autoincrement())

  /// Foreign key to group booking
  groupBookingId Int
  /// Owner who submitted the claim
  ownerId        Int
  /// Property being offered
  propertyId     Int

  // ==================== Offer Details ====================
  /// Owner's base price per room/night before any offer discount
  offeredPricePerNight Decimal  @db.Decimal(12, 2)
  /// Discount percentage (e.g., 15 for 15% off)
  discountPercent      Decimal? @db.Decimal(5, 2)
  /// Special offers/favors (free breakfast, airport pickup, etc.)
  specialOffers        String?  @db.Text
  /// Additional notes from owner
  notes                String?  @db.Text
  /// Total owner amount for the stay after discount, before NoLSAF commission
  totalAmount          Decimal  @db.Decimal(12, 2)
  /// Currency code
  currency             String   @default("TZS")

  // ==================== Status ====================
  /// Claim status: PENDING, ACCEPTED, REJECTED, WITHDRAWN
  status     String    @default("PENDING")
  /// Timestamp when claim was accepted/rejected
  reviewedAt DateTime?
  /// Admin who reviewed the claim
  reviewedBy Int?

  // ==================== Metadata ====================
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==================== Relations ====================
  groupBooking GroupBooking @relation(fields: [groupBookingId], references: [id], onDelete: Cascade)
  owner        User         @relation("GroupBookingClaims", fields: [ownerId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reviewer     User?        @relation("GroupBookingClaimReviews", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([groupBookingId, ownerId]) // One claim per owner per group booking
  @@index([groupBookingId])
  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@map("group_booking_claims")
}

/// Individual passenger record for group bookings
/// Alternative to storing all passengers in JSON; enables structured queries
model GroupBookingPassenger {
