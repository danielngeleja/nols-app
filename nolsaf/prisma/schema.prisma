model NrmsLoyaltyLedger {
  id             Int      @id @default(autoincrement())
  accountId      Int
  reservationId  Int?
  kind           String   @db.VarChar(20)
  points         Int
  balanceAfter   Int
  reason         String   @db.VarChar(300)
  idempotencyKey String   @unique @db.VarChar(120)
  createdById    Int?
  createdAt      DateTime @default(now())

