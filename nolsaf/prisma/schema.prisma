  @@map("nrms_admin_export")
}

// =========================================================
//  NRMS AGENT B2B - approved external travel agents booking
//  against live hotel inventory. Portfolio model: one agency
//  identity, per-hotel terms. See .local-reports plan doc.
// =========================================================

/// A travel agency's platform-wide identity + KYC. Captured once, verified
/// centrally by NoLSAF, and reused across every hotel that links it. Holds NO
/// hotel-specific rates or terms - those live on NrmsAgentPropertyLink.
model NrmsAgentAccount {
  id Int @id @default(autoincrement())

  /// The agency's login user (User.role = NRMS_AGENT).
  primaryUserId Int @unique

  legalName      String  @db.VarChar(200)
  tradingName    String? @db.VarChar(200)
  registrationNo String? @db.VarChar(80)
  tin            String? @db.VarChar(50)
  licenseNo      String? @db.VarChar(80)

  contactName  String? @db.VarChar(160)
  contactEmail String? @db.VarChar(200)
  contactPhone String? @db.VarChar(40)
  address      String? @db.VarChar(500)
  countryCode  String  @default("TZ") @db.VarChar(2)
  /// Nationality / country of the agency (e.g. "Tanzanian"). Captured at invite.
  nationality  String? @db.VarChar(80)

  /// KYC document uploads: array of { type, url, uploadedAt } (Cloudinary refs).
  documents   Json?
  /// Refund/settlement bank details (JSON). Not payment credentials.
  bankDetails Json?

  /// Global lifecycle: ACTIVE, SUSPENDED.
  status String @default("ACTIVE") @db.VarChar(20)

  /// Central NoLSAF verification: PENDING, VERIFIED, REJECTED. Actor stored as a
  /// plain id (same convention as OwnerPaygAccount.frozenByAdminId).
  verificationStatus String    @default("PENDING") @db.VarChar(20)
  verifiedByAdminId  Int?
  verifiedAt         DateTime?
  verificationNote   String?   @db.VarChar(500)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryUser   User                    @relation("NrmsAgentPrimaryUser", fields: [primaryUserId], references: [id], onDelete: Restrict)
  propertyLinks NrmsAgentPropertyLink[]

  @@index([status, verificationStatus])
  @@index([registrationNo])
  @@index([tin])
  @@map("nrms_agent_account")
}

/// The per-hotel relationship (join layer). One row per (agency x property):
/// each hotel independently approves and sets its own commercial terms. Rates,
/// bookings and (future) ledger scope to THIS row, never the account. This is
/// what keeps a shared agency's hotels isolated from each other.
model NrmsAgentPropertyLink {
  id             Int @id @default(autoincrement())
  agentAccountId Int
  propertyId     Int

  /// Legacy-compatible lifecycle: INVITED, REQUESTED, AGENT_ACCEPTED, ACTIVE,
  /// SUSPENDED, REJECTED, TERMINATED. Consent fields below are authoritative
  /// for new bilateral requests; legacy rows are backfilled without status rewrites.
  status String @default("INVITED") @db.VarChar(20)

  /// Who initiated this relationship: HOTEL, AGENT, or ADMIN.
  initiatedBy       String   @default("HOTEL") @db.VarChar(20)
  requestedByUserId Int?
  requestedAt       DateTime @default(now())

  /// Explicit bilateral consent. PENDING, ACCEPTED, DECLINED, or WITHDRAWN.
  hotelConsentStatus     String    @default("ACCEPTED") @db.VarChar(20)
  hotelConsentedByUserId Int?
  hotelConsentedAt       DateTime?
  agentConsentStatus     String    @default("PENDING") @db.VarChar(20)
  agentConsentedByUserId Int?
  agentConsentedAt       DateTime?

  activatedAt         DateTime?
  suspendedAt         DateTime?
  /// Authority that imposed the current suspension: HOTEL or ADMIN. An
  /// ADMIN suspension can only be cleared through the guarded admin workflow.
  suspensionAuthority String?   @db.VarChar(20)
  terminatedAt        DateTime?
  terminationReason   String?   @db.VarChar(300)

  currency     String  @default("TZS") @db.VarChar(3)
  /// PREPAID (v1). CREDIT reserved for a later phase.
  paymentTerms String  @default("PREPAID") @db.VarChar(20)
  /// REQUEST (request-to-book) or INSTANT (instant confirm).
  bookingMode  String  @default("REQUEST") @db.VarChar(20)
  /// On-account credit ceiling. 0 in v1 (prepaid only); reserved for later.
  creditLimit  Decimal @default(0.00) @db.Decimal(12, 2)

  /// Hotel owner/user who approved or rejected (plain-id actor convention).
  decidedByUserId Int?
  decidedAt       DateTime?
  decisionReason  String?   @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentAccount    NrmsAgentAccount          @relation(fields: [agentAccountId], references: [id], onDelete: Cascade)
  property        Property                  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rateAccess      NrmsAgentRateAccess[]
  bookingRequests NrmsAgentBookingRequest[]
  reservations    Reservation[]

  @@unique([agentAccountId, propertyId])
  @@index([propertyId, status])
  @@index([agentAccountId, status])
  @@index([initiatedBy, status])
  @@map("nrms_agent_property_link")
}

/// Which rate plans + room types an agent may sell AT ONE HOTEL. Scopes the
/// portal's price and inventory visibility. FK to the link, not the account.
model NrmsAgentRateAccess {
  id         Int  @id @default(autoincrement())
  linkId     Int
  ratePlanId Int
  roomTypeId Int?

  createdAt DateTime @default(now())

  link     NrmsAgentPropertyLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  ratePlan NrmsRatePlan          @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  roomType RoomType?             @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([linkId, ratePlanId, roomTypeId])
  @@index([linkId])
  @@index([ratePlanId])
  @@map("nrms_agent_rate_access")
}

/// Owner-reviewed agent booking request. A PENDING row holds inventory via a
/// short-lived allocation until the hotel decides or holdExpiresAt passes.
model NrmsAgentBookingRequest {
  id               Int     @id @default(autoincrement())
  linkId           Int
  propertyId       Int
  /// Stable browser mutation identifier. Scoped to the hotel partnership so a
  /// network retry returns the original hold instead of consuming inventory a
  /// second time.
  clientMutationId String? @db.VarChar(120)

  /// PENDING, CONFIRMED, DECLINED, EXPIRED, CANCELLED.
  status String @default("PENDING") @db.VarChar(20)

  checkIn        DateTime
  checkOut       DateTime
  adults         Int      @default(1)
  children       Int      @default(0)
  roomTypeId     Int?
  roomsRequested Int      @default(1)

  /// Snapshot of the quoted agent price at request time.
  currency    String  @default("TZS") @db.VarChar(3)
  quotedTotal Decimal @default(0.00) @db.Decimal(12, 2)

  holdExpiresAt DateTime?
  /// The reservation this request holds/produced. For request-to-book it is set
  /// at creation (a HELD reservation) and confirmed in place; for instant it is
  /// the CONFIRMED reservation. Unique: one request per reservation.
  reservationId Int?      @unique

  decidedByUserId Int?
  decidedAt       DateTime?
  decisionReason  String?   @db.VarChar(300)

  notes String? @db.Text

  /// Who pays hotel incidentals outside the prepaid room charge:
  /// AGENCY or INDIVIDUAL_GUEST. Required for new agent bookings.
  incidentalBilling String? @db.VarChar(30)

  /// How far the agency's cover reaches when it pays: ALL for every extra the
  /// hotel sells, SELECTED for the categories named in `incidentalCategories`.
  /// Null while the travellers settle their own extras.
  incidentalScope String? @db.VarChar(20)

  /// Charge categories the agency absorbs when the scope is SELECTED, drawn
  /// from NRMS_CHARGE_CATEGORIES. Empty or null under any other scope.
  incidentalCategories Json?

  /// Optional ceiling on the agency's cover. Anything above it stays the
  /// traveller's own bill, so the desk knows where to stop.
  incidentalCapAmount Decimal? @db.Decimal(12, 2)

  /// What the cap is measured against: PER_TRAVELLER_PER_NIGHT,
  /// PER_TRAVELLER_STAY or BOOKING_TOTAL. Required whenever a cap is set.
  incidentalCapBasis String? @db.VarChar(30)

  /// NOT_STARTED, IN_PROGRESS, SUBMITTED, CHANGES_REQUESTED, VERIFIED.
  /// Payment secures inventory independently; VERIFIED is the check-in gate.
  guestManifestStatus       String    @default("NOT_STARTED") @db.VarChar(30)
  guestManifestSubmittedAt  DateTime?
  guestManifestReviewedAt   DateTime?
  guestManifestReviewedById Int?
  guestManifestReviewNote   String?   @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  link                     NrmsAgentPropertyLink   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  reservation              Reservation?            @relation("NrmsAgentBookingRequestReservation", fields: [reservationId], references: [id], onDelete: SetNull)
  materializedReservations Reservation[]           @relation("NrmsAgentBookingMaterializedReservations")
  guests                   NrmsAgentBookingGuest[]
  masterFolio              NrmsMasterFolio?

  @@unique([linkId, clientMutationId], map: "nrms_agent_booking_request_linkId_clientMutationId_key")
  @@index([linkId, status])
  @@index([propertyId, status])
  @@index([status, holdExpiresAt])
  @@map("nrms_agent_booking_request")
}

/// One traveller declared by the agency for an already secured agent booking.
/// These rows describe occupants only; they never allocate inventory or create
/// additional reservations. Identity documents are stored as authenticated
/// object keys and delivered through scoped, signed endpoints.
model NrmsAgentBookingGuest {
  id               Int     @id @default(autoincrement())
  bookingRequestId Int
  /// The exact per-room stay this traveller occupies after manifest
  /// verification. Several travellers may share the same reservation.
  reservationId    Int?
  roomNumber       Int
  guestType        String  @db.VarChar(10) // ADULT, CHILD
  isLead           Boolean @default(false)

  fullName             String?   @db.VarChar(160)
  phone                String?   @db.VarChar(40)
  email                String?   @db.VarChar(160)
  nationality          String?   @db.VarChar(80)
  dateOfBirth          DateTime?
  documentType         String?   @db.VarChar(30) // PASSPORT, NATIONAL_ID, OTHER
  documentNumber       String?   @db.VarChar(100)
  documentExpiry       DateTime?
  documentKey          String?   @db.VarChar(255)
  documentMimeType     String?   @db.VarChar(100)
  documentResourceType String    @default("image") @db.VarChar(20)

  /// PENDING, ACCEPTED, CHANGES_REQUESTED.
  status     String  @default("PENDING") @db.VarChar(30)
  reviewNote String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingRequest NrmsAgentBookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  reservation    Reservation?            @relation("NrmsAgentBookingGuestReservation", fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([bookingRequestId, status])
  @@index([bookingRequestId, roomNumber])
  @@index([reservationId])
  @@map("nrms_agent_booking_guest")
}

// =========================================================
//  NRMS - Market readiness operations (non-OTA)
//  Open API and external accounting integrations are intentionally excluded.
// =========================================================

/// Reusable sellable price product. The base room rate remains on RoomType;
/// plans describe cancellation, meals, occupancy and adjustment policy.
model NrmsRatePlan {
  id                 Int      @id @default(autoincrement())
  propertyId         Int
  roomTypeId         Int?
  code               String   @db.VarChar(40)
  name               String   @db.VarChar(120)
  description        String?  @db.VarChar(500)
  currency           String   @default("TZS") @db.VarChar(3)
  adjustmentType     String   @default("BASE") @db.VarChar(20) // BASE, FIXED, OFFSET, PERCENT
  adjustment         Decimal  @default(0.00) @db.Decimal(12, 2)
