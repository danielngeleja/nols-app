/// Audit record for sensitive support/reconciliation exports.
model NrmsAdminExport {
  id           Int       @id @default(autoincrement())
  adminId      Int
  propertyId   Int?
  kind         String    @db.VarChar(40)
  purpose      String    @db.VarChar(300)
  fromAt       DateTime?
  toAt         DateTime?
  expiresAt    DateTime
  downloadedAt DateTime?
  ipAddress    String?   @db.VarChar(80)
  userAgent    String?   @db.VarChar(255)
  sessionRef   String?   @db.VarChar(128)
