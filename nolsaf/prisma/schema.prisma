model NrmsBillingStatementItem {
  id           Int      @id @default(autoincrement())
  statementId  Int
  usageEventId Int      @unique
  amount       Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  statement  NrmsBillingStatement @relation(fields: [statementId], references: [id], onDelete: Restrict)
  usageEvent NrmsUsageEvent       @relation(fields: [usageEventId], references: [id], onDelete: Restrict)

  @@index([statementId])
  @@map("nrms_billing_statement_item")
}

model NrmsServicePaymentToken {
  id                Int      @id @default(autoincrement())
  statementId       Int
  token             String   @unique @db.VarChar(80)
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("TZS") @db.VarChar(3)
  status            String   @default("PENDING") @db.VarChar(20) // PENDING, PROCESSING, PAID, FAILED, EXPIRED, VOID
  method            String?  @db.VarChar(30)
  // AzamPay transactionId from the synchronous initiate response. Matched directly against
  // the webhook's own eventId - same pattern as Invoice/GroupBooking/TourBooking - since
  // AzamPay's MNO callback does not reliably echo back the additionalProperties we sent.
  checkoutSessionId String?  @unique @db.VarChar(120)
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  statement NrmsBillingStatement @relation(fields: [statementId], references: [id], onDelete: Restrict)
  payment   NrmsServicePayment?

  @@index([statementId, status])
  @@map("nrms_service_payment_token")
}

model NrmsServicePayment {
  id             Int       @id @default(autoincrement())
  tokenId        Int       @unique
  provider       String    @db.VarChar(30)
  providerRef    String    @unique @db.VarChar(120)
  idempotencyKey String    @unique @db.VarChar(120)
  amount         Decimal   @db.Decimal(12, 2)
  currency       String    @default("TZS") @db.VarChar(3)
  status         String    @db.VarChar(20)
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())

  /// TZS per 1 unit of `currency`, frozen at verification time. Reporting only,
  /// see the same pair on TourBooking. NULL on pre-migration rows.
  fxTzsPerUnit Decimal?  @db.Decimal(18, 6)
  fxCapturedAt DateTime?

  token NrmsServicePaymentToken @relation(fields: [tokenId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("nrms_service_payment")
}

/// Daily, explainable integrity observations for admin review. Signals never
/// punish a property automatically and can be acknowledged without deletion.
model NrmsIntegritySignal {
  id           Int       @id @default(autoincrement())
  propertyId   Int
  kind         String    @db.VarChar(60)
  severity     String    @default("ATTENTION") @db.VarChar(20)
  status       String    @default("OPEN") @db.VarChar(20)
  metricValue  Decimal?  @db.Decimal(14, 4)
  baseline     Decimal?  @db.Decimal(14, 4)
  details      Json?
  observedFrom DateTime
  observedTo   DateTime
  detectedAt   DateTime  @default(now())
  reviewedAt   DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, kind, observedTo])
  @@index([status, severity, detectedAt])
  @@index([propertyId, detectedAt])
  @@map("nrms_integrity_signal")
}

/// Persistent counters for public NRMS traffic that needs abuse review.
