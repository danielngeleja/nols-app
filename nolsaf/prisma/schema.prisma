model NrmsPortfolioProperty {
  id          Int      @id @default(autoincrement())
  portfolioId Int
  propertyId  Int
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  portfolio NrmsPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  property  Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, propertyId])
  @@index([propertyId])
  @@map("nrms_portfolio_property")
}

model NrmsForecastSnapshot {
  id             Int      @id @default(autoincrement())
  propertyId     Int
  forecastDate   DateTime @db.Date
  horizonDays    Int      @default(30)
  sellableNights Int
