// =========================================================
//  NOLSCOPE – Smart Travel Cost Estimation Engine
// =========================================================

/// Stores every trip cost estimate request and its result.
/// One estimate can later be linked to a Booking for conversion tracking.
model TripEstimate {
  id Int @id @default(autoincrement())

  // ── Request parameters ──────────────────────────────────────────────
  destination         String   @db.VarChar(120) // "Serengeti", "Zanzibar"
  destinationType     String?  @db.VarChar(40) // "park" | "island" | "city" | "region"
  startDate           DateTime @db.Date
  endDate             DateTime @db.Date
  travelers           Int      @default(1)
  accommodationLevel  String   @db.VarChar(20) // "budget" | "mid-range" | "luxury"
  transportPreference String?  @db.VarChar(30) // "shared" | "private" | "flight" | "bus"
  nationality         String   @default("US") @db.VarChar(5) // ISO 3166-1 alpha-2
  currency            String   @default("USD") @db.VarChar(3) // ISO 4217
  /// Activity codes requested, e.g. ["safari-full-day","diving-2-tank"]
  requestedActivities Json?

  // ── Calculation results ─────────────────────────────────────────────
  totalCost  Decimal  @db.Decimal(12, 2)
  confidence Decimal  @db.Decimal(3, 2) // 0.00 – 1.00
  /// Full cost breakdown object
  /// { visa, accommodation, transport, activities, parkFees, serviceCharges }
  breakdown  Json
  minCost    Decimal? @db.Decimal(12, 2)
  maxCost    Decimal? @db.Decimal(12, 2)

  // ── Seasonality ─────────────────────────────────────────────────────
  currentSeason  String?  @db.VarChar(20) // "peak" | "shoulder" | "off-peak"
  offPeakCost    Decimal? @db.Decimal(12, 2)
  offPeakSavings Decimal? @db.Decimal(12, 2)
  /// e.g. [{"type":"timing","message":"Travel in May saves $300","savings":300}]
  suggestions    Json?

  // ── Validity ────────────────────────────────────────────────────────
  validUntil      DateTime
  /// e.g. ["nolsaf-listings","static-park-fees","market-rates"]
  dataSourcesUsed Json?

  // ── User tracking ───────────────────────────────────────────────────
  userId    Int?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String? @db.VarChar(128) // anonymous users
  ipAddress String? @db.VarChar(45) // IPv4 or IPv6

  // ── Conversion tracking ─────────────────────────────────────────────
  convertedToBooking Boolean  @default(false)
  bookingId          Int?
  booking            Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  // ── Analytics ───────────────────────────────────────────────────────
  viewCount    Int      @default(1)
  lastViewedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([destination, startDate])
  @@index([userId])
  @@index([sessionId])
  @@index([convertedToBooking])
  @@index([createdAt])
  @@map("trip_estimates")
}

// ─────────────────────────────────────────────────────────────────────────────
//  VISA FEES  (updated quarterly from immigration.go.tz)
// ─────────────────────────────────────────────────────────────────────────────
model VisaFee {
  id Int @id @default(autoincrement())

  /// ISO 3166-1 alpha-2 country code, e.g. "US", "UK", "KE"
  nationality  String @db.VarChar(5)
  visaType     String @default("tourist") @db.VarChar(30) // "tourist" | "business" | "transit"
  entries      String @default("single") @db.VarChar(20) // "single" | "multiple"
  durationDays Int    @default(90)

  amount         Decimal @db.Decimal(10, 2)
  currency       String  @default("USD") @db.VarChar(3)
  description    String? @db.VarChar(500)
  processingTime String? @db.VarChar(80) // "on-arrival" | "7-14 days"
  /// e.g. ["passport","photo","yellow-fever-certificate"]
  requirements   Json?

  validFrom    DateTime  @default(now())
  validUntil   DateTime?
  lastVerified DateTime  @default(now())
  isActive     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nationality, visaType, entries])
  @@index([nationality])
  @@index([isActive])
  @@map("visa_fees")
}

// ─────────────────────────────────────────────────────────────────────────────
//  PARK / ATTRACTION FEES  (updated when TANAPA publishes new fee schedule)
// ─────────────────────────────────────────────────────────────────────────────
model ParkFee {
  id Int @id @default(autoincrement())

  parkName String @db.VarChar(200)
  parkCode String @unique @db.VarChar(30) // "SERENP", "NGORO", "KILIM"
  category String @db.VarChar(40) // "national-park" | "conservation-area" | "marine-park"
  region   String @db.VarChar(100) // "Northern Circuit" | "Zanzibar" | "Southern"

  /// Per-person per-day entry fees
  adultForeignerFee Decimal  @db.Decimal(10, 2)
  adultResidentFee  Decimal? @db.Decimal(10, 2)
  childForeignerFee Decimal? @db.Decimal(10, 2)
  childResidentFee  Decimal? @db.Decimal(10, 2)
  currency          String   @default("USD") @db.VarChar(3)

  vehicleFee Decimal? @db.Decimal(10, 2) // per vehicle per day
  guideFee   Decimal? @db.Decimal(10, 2) // mandatory guide fee where applicable
  campingFee Decimal? @db.Decimal(10, 2) // per person per night

  requiresGuide Boolean @default(false)
  minimumDays   Int?

  description     String?  @db.Text
  officialWebsite String?  @db.VarChar(300)
  lastVerified    DateTime @default(now())
  isActive        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([region])
  @@index([isActive])
  @@map("park_fees")
}

// ─────────────────────────────────────────────────────────────────────────────
//  TRANSPORT COST AVERAGES  (updated monthly)
// ─────────────────────────────────────────────────────────────────────────────
model TransportCostAverage {
  id Int @id @default(autoincrement())

  fromLocation  String @db.VarChar(120)
  toLocation    String @db.VarChar(120)
  transportType String @db.VarChar(30) // "flight" | "bus" | "private-car" | "shared-taxi" | "ferry"

  minCost     Decimal @db.Decimal(10, 2)
  maxCost     Decimal @db.Decimal(10, 2)
  averageCost Decimal @db.Decimal(10, 2)
  currency    String  @default("USD") @db.VarChar(3)

  durationHours Decimal? @db.Decimal(5, 1)
  distanceKm    Int?
  frequency     String?  @db.VarChar(60) // "daily" | "3x-weekly" | "on-demand"

  peakMultiplier    Decimal @default(1.00) @db.Decimal(3, 2)
  offPeakMultiplier Decimal @default(1.00) @db.Decimal(3, 2)

  description     String? @db.VarChar(500)
  provider        String? @db.VarChar(200)
  requiresBooking Boolean @default(false)
  bookingLeadDays Int?

  /// Confidence in this estimate (0–1)
  confidence  Decimal  @default(0.80) @db.Decimal(3, 2)
  dataSource  String?  @db.VarChar(60) // "provider-api" | "manual-entry" | "aggregator"
  lastUpdated DateTime @default(now())
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromLocation, toLocation, transportType])
  @@index([fromLocation, toLocation])
  @@index([transportType])
  @@index([isActive])
  @@map("transport_cost_averages")
}

// ─────────────────────────────────────────────────────────────────────────────
//  ACTIVITY COSTS  (safaris, water sports, cultural tours, adventure)
// ─────────────────────────────────────────────────────────────────────────────
model ActivityCost {
  id Int @id @default(autoincrement())

  activityCode String @unique @db.VarChar(80) // "safari-full-day", "diving-2-tank"
  activityName String @db.VarChar(200)
  category     String @db.VarChar(40) // "safari" | "water-sports" | "cultural" | "adventure"
  destination  String @db.VarChar(120)

  minCost     Decimal @db.Decimal(10, 2)
  maxCost     Decimal @db.Decimal(10, 2)
  averageCost Decimal @db.Decimal(10, 2)
  currency    String  @default("USD") @db.VarChar(3)
  priceUnit   String  @default("per-person") @db.VarChar(30) // "per-person" | "per-group" | "per-vehicle"

  duration      String?  @db.VarChar(40) // "full-day" | "half-day" | "3-hours"
  durationHours Decimal? @db.Decimal(4, 1)
  groupSize     String?  @db.VarChar(60) // "2-6 people" | "private" | "shared"
  difficulty    String?  @db.VarChar(20) // "easy" | "moderate" | "challenging"

  /// e.g. ["guide","equipment","lunch","transport"]
  includes     Json?
  /// e.g. ["park-fees","tips","drinks"]
  excludes     Json?
  /// e.g. ["padi-certified","medical-clearance"]
  requirements Json?

  seasonalActivity Boolean @default(false)
  /// Months activity is available (1–12)
  availableMonths  Json?
  requiresBooking  Boolean @default(true)
  bookingLeadDays  Int?    @default(3)

  peakMultiplier    Decimal @default(1.00) @db.Decimal(3, 2)
  offPeakMultiplier Decimal @default(1.00) @db.Decimal(3, 2)

  description String? @db.Text
  provider    String? @db.VarChar(200)
  website     String? @db.VarChar(300)
  /// Popularity score 1–100
  popularity  Int     @default(50)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([destination, category])
  @@index([category])
  @@index([isActive])
  @@map("activity_costs")
}

// ─────────────────────────────────────────────────────────────────────────────
//  PRICING RULES  (seasonal multipliers and demand-based adjustments)
// ─────────────────────────────────────────────────────────────────────────────
model PricingRule {
  id Int @id @default(autoincrement())

  ruleName String @unique @db.VarChar(120)
  ruleType String @db.VarChar(30) // "seasonal" | "demand-based" | "special-event"

  /// NULL = applies to all destinations
  destination String? @db.VarChar(120)
  /// NULL = applies to all cost categories
  category    String? @db.VarChar(40) // "accommodation" | "transport" | "activity"

  seasonName    String? @db.VarChar(30) // "peak" | "shoulder" | "off-peak"
  startMonth    Int? // 1–12
  endMonth      Int? // 1–12
  /// Date-range overrides, e.g. [{"start":"2026-12-20","end":"2027-01-05"}]
  specificDates Json?

  /// e.g. 1.25 = 25% markup, 0.90 = 10% discount
  priceMultiplier Decimal @db.Decimal(4, 2)

  minTravelers  Int?
  maxTravelers  Int?
  /// Only apply when trip is booked at least N days in advance
  daysInAdvance Int?

  /// Higher number = evaluated first
  priority   Int       @default(100)
  isActive   Boolean   @default(true)
  validFrom  DateTime  @default(now())
  validUntil DateTime?

  description String? @db.Text
  createdBy   String? @db.VarChar(80)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([destination, seasonName])
  @@index([isActive, priority])
  @@map("pricing_rules")
}

// ─────────────────────────────────────────────────────────────────────────────
//  TRIP DESTINATIONS  (master reference list for the cost estimator)
// ─────────────────────────────────────────────────────────────────────────────
model TripDestination {
  id Int @id @default(autoincrement())

  destinationCode String  @unique @db.VarChar(30) // "SERENP", "ZANZIBAR", "ARUSHA"
  destinationName String  @db.VarChar(120) // "Serengeti", "Zanzibar"
  displayName     String? @db.VarChar(200) // "Serengeti National Park"
  destinationType String  @db.VarChar(30) // "park" | "island" | "city" | "region"

  country     String @default("Tanzania") @db.VarChar(80)
  region      String @db.VarChar(100) // "Northern Circuit" | "Zanzibar" | "Southern"
  /// e.g. {"lat": -2.333, "lng": 34.833}
  coordinates Json?
  timezone    String @default("Africa/Dar_es_Salaam") @db.VarChar(60)

  mainAirport      String? @db.VarChar(100) // "Seronera Airstrip (SEU)"
  nearestCity      String? @db.VarChar(80)
  accessDifficulty String  @default("moderate") @db.VarChar(20) // "easy" | "moderate" | "difficult"

  /// Best months to visit (1–12)
  bestMonths    Json?
  /// Rainy/green season months (1–12)
  rainyMonths   Json?
  /// Peak pricing months (1–12)
  peakMonths    Json?
  /// Off-peak/discount months (1–12)
  offPeakMonths Json?

  /// Multiplier applied to accommodation base price for this destination
  accommodationMultiplier Decimal  @default(1.00) @db.Decimal(3, 2)
  /// Base transport cost in USD from the nearest major hub
  transportBaseUsd        Decimal? @db.Decimal(10, 2)
  /// Typical length of stay (days)
  avgStayDays             Int?

  description     String? @db.Text
  imageUrl        String? @db.VarChar(500)
  officialWebsite String? @db.VarChar(300)
  /// Popularity score 1–100
  popularity      Int     @default(50)
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([destinationType])
  @@index([region])
  @@index([isActive, popularity])
  @@map("trip_destinations")
}

// =========================================================
//  TRANSPORT PICKUP POINT MODEL - Airports, bus terminals,
//  ferry ports and train stations used as pickup locations
// =========================================================
model TransportPickupPoint {
  id          Int      @id @default(autoincrement())
  /// Stable unique code, e.g. JNIA, BUS_UBUNGO, FERRY_KIVUKONI
  code        String   @unique @db.VarChar(64)
  /// Full display name
  name        String   @db.VarChar(200)
  /// Short label for compact UI lists
  shortLabel  String   @db.VarChar(120)
  city        String   @db.VarChar(120)
  /// airport | bus_terminal | ferry_port | train_station
  category    String   @db.VarChar(20)
  /// FLIGHT | BUS | FERRY | TRAIN
  arrivalType String   @db.VarChar(20)
  latitude    Decimal  @db.Decimal(10, 6)
  longitude   Decimal  @db.Decimal(10, 6)
  /// IATA code for airports
  iataCode    String?  @db.VarChar(8)
  /// Coordinates confirmed against a trusted source
  verified    Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, category])
  @@index([city])
  @@map("transport_pickup_points")
}

// =========================================================
//  LIFECYCLE OBSERVATION MODELS
//  Read models only. They never replace native booking/payment state.
// =========================================================
model LifecycleSnapshot {
  id                  Int      @id @default(autoincrement())
  serviceType         String   @db.VarChar(20) // PROPERTY | GROUP_STAY | TOUR
  bookingId           Int
  bookingStage        String   @db.VarChar(30)
  paymentStage        String   @db.VarChar(30)
  receiptStage        String   @db.VarChar(30)
  responsibilityStage String   @db.VarChar(30)
  caseStage           String   @db.VarChar(30)
  requiredAction      String   @db.VarChar(40)
  consistencyStatus   String   @db.VarChar(20) // CONSISTENT | REVIEW_REQUIRED
  issueFingerprint    String?  @db.VarChar(128)
  issues              Json?
  calculatedAt        DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([serviceType, bookingId])
  @@index([consistencyStatus, calculatedAt])
  @@index([serviceType, calculatedAt])
  @@index([requiredAction, calculatedAt])
  @@map("lifecycle_snapshots")
}

model LifecycleException {
  id             Int       @id @default(autoincrement())
  serviceType    String    @db.VarChar(20)
  bookingId      Int
  code           String    @db.VarChar(80)
  severity       String    @db.VarChar(20) // WARNING | ERROR
  status         String    @default("OPEN") @db.VarChar(20) // OPEN | ACKNOWLEDGED | RESOLVED | IGNORED
  fingerprint    String    @db.VarChar(128)
  message        String    @db.Text
  metadata       Json?
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  ignoredAt      DateTime?
  acknowledgedBy Int?
  resolvedBy     Int?
  ignoredBy      Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([serviceType, bookingId, fingerprint])
  @@index([status, severity, lastSeenAt])
  @@index([serviceType, bookingId])
  @@index([code, status])
  @@map("lifecycle_exceptions")
}

// =========================================================
//  NRMS - NoLSAF Rooms Management System
//  Reference: docs/NOLSAF_ROOMS_MANAGEMENT_SYSTEM.md
//  Phase 1: entitlement + normalized room inventory
//  Phase 2: external reservations, stays, guests, payments
//  PAYG billing models arrive with Phase 3 (doc section 15).
//  Booking remains the commercial source of truth for marketplace
//  stays; PropertyAvailabilityBlock keeps serving Type A owners.
// =========================================================

/// A NoLSAF service product an owner can enroll in (doc section 5).
/// First row: code NRMS_PAYG (usage-based subscription, no base fee).
model ServicePlan {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(40) // e.g. NRMS_PAYG
  name        String  @db.VarChar(120)
  description String? @db.Text
  status      String  @default("ACTIVE") @db.VarChar(20) // DRAFT, ACTIVE, RETIRED
  /// Plan-level configuration (trial days, links to versioned pricing policy).
  /// Commercial numbers must live in versioned policy, not hard-coded (doc 8.7).
  config      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments OwnerServiceEnrollment[]

  @@index([status])
  @@map("service_plan")
}

/// Owner enrollment into a service plan (doc section 5). Workspace mode is
/// derived from this, never stored separately: an ACTIVE or eligible TRIAL
/// NRMS enrollment = MARKETPLACE_NRMS, otherwise MARKETPLACE_ONLY.
/// Cancelling must never erase room/reservation/guest history (doc 5).
model OwnerServiceEnrollment {
  id      Int    @id @default(autoincrement())
  ownerId Int
  planId  Int
  status  String @default("PENDING") @db.VarChar(20) // PENDING, TRIAL, ACTIVE, PAST_DUE, SUSPENDED, CANCELLED

  trialStartsAt DateTime?
  trialEndsAt   DateTime?
  activatedAt   DateTime?
  suspendedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?   @db.VarChar(300)
  notes         String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User        @relation("OwnerServiceEnrollments", fields: [ownerId], references: [id], onDelete: Cascade)
  plan  ServicePlan @relation(fields: [planId], references: [id])

  @@unique([ownerId, planId])
  @@index([status])
  @@index([planId, status])
  @@map("owner_service_enrollment")
}

/// Normalized room category for a property (doc 7.1, 9.2).
/// Replaces reads of Property.roomsSpec over time; roomsSpec stays until all
/// dependent reads are migrated (doc 10.4). sourceSpecKey ties a type back to
/// its roomsSpec entry for the reconciliation report.
model RoomType {
  id          Int     @id @default(autoincrement())
  propertyId  Int
  name        String  @db.VarChar(120)
  description String? @db.Text

  capacityAdults   Int     @default(2)
  capacityChildren Int     @default(0)
  /// Human-readable bed setup, e.g. "1 queen and 1 single"
  bedSetup         String? @db.VarChar(200)

  baseRate Decimal? @db.Decimal(12, 2) // standard rate per night
  currency String   @default("TZS") @db.VarChar(3)

  images    Json? // Array of URLs
  amenities Json? // Array of strings

  status    String @default("ACTIVE") @db.VarChar(20) // ACTIVE, INACTIVE
  sortOrder Int    @default(0)

  /// Key of the originating entry in Property.roomsSpec (migration audit)
  sourceSpecKey String? @db.VarChar(120)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property            Property                    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  units               RoomUnit[]
  allocations         ReservationRoomAllocation[]
  channelRoomMappings ChannelRoomMapping[]
  channelRateMappings ChannelRateMapping[]
  ratePlans           NrmsRatePlan[]
  rateRestrictions    NrmsRateRestriction[]
  pricingGuidance     NrmsPricingRecommendation[]
  groupBlockRooms     NrmsGroupBlockRoom[]
  calendarFeeds       ChannelCalendarFeed[]
  agentRateAccess     NrmsAgentRateAccess[]
  guestInquiries      NrmsGuestInquiry[]

  @@unique([propertyId, name])
  @@index([propertyId, status])
  @@map("room_type")
}

/// An individual physical room (doc 7.1, 9.2). Status here is inventory
/// state; owner-use and temporary closures stay in PropertyAvailabilityBlock
/// because blocks are not reservations and are never billable (doc 4).
model RoomUnit {
  id         Int     @id @default(autoincrement())
  propertyId Int
  roomTypeId Int
  /// Room number/code shown on the door, e.g. "R101"
  code       String  @db.VarChar(30)
  floor      Int?
  status     String  @default("ACTIVE") @db.VarChar(20) // ACTIVE, INACTIVE, MAINTENANCE, OUT_OF_SERVICE
  notes      String? @db.VarChar(500)
  /// Physical sleeping places used by NBS accommodation statistics.
  bedCount   Int     @default(1)

  /// Cleanliness state (doc 9.2): operational axis, independent of the
  /// inventory `status` above. CLEAN, DIRTY, IN_PROGRESS, INSPECTED.
  housekeepingStatus    String    @default("CLEAN") @db.VarChar(20)
  housekeepingUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property           Property                    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType           RoomType                    @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  statusHistory      RoomUnitStatusHistory[]
  allocations        ReservationRoomAllocation[]
  availabilityBlocks PropertyAvailabilityBlock[]
  housekeepingTasks  NrmsHousekeepingTask[]
  orderPoints        NrmsOrderPoint[]
  serviceCases       NrmsServiceCase[]

  @@unique([propertyId, code])
  @@index([roomTypeId, status])
  @@index([propertyId, status])
  @@index([propertyId, housekeepingStatus])
  @@map("room_unit")
}

/// Audit trail of room unit status changes (doc 9.2, 14).
model RoomUnitStatusHistory {
  id          Int     @id @default(autoincrement())
  roomUnitId  Int
  fromStatus  String  @db.VarChar(20)
  toStatus    String  @db.VarChar(20)
  reason      String? @db.VarChar(300)
  changedById Int?

  createdAt DateTime @default(now())

  roomUnit  RoomUnit @relation(fields: [roomUnitId], references: [id], onDelete: Cascade)
  changedBy User?    @relation("RoomUnitStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([roomUnitId, createdAt])
  @@map("room_unit_status_history")
}

/// Property-scoped guest record (doc 7.6). Tenant-isolated: one owner must
/// never see another owner's guests (doc 4). Promotional consent is stored in
/// GuestSmsPreference by canonical owner + phone, never inferred from a booking.
model GuestProfile {
  id          Int     @id @default(autoincrement())
  propertyId  Int
  ownerId     Int
  fullName    String  @db.VarChar(160)
  phone       String? @db.VarChar(40)
  email       String? @db.VarChar(160)
  nationality String? @db.VarChar(80)
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property              Property                    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner                 User                        @relation("NrmsGuestProfileOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  reservations          Reservation[]
  smsCampaignRecipients GuestSmsCampaignRecipient[]
  serviceCases          NrmsServiceCase[]
  loyaltyAccounts       NrmsLoyaltyAccount[]
  reviewRequests        NrmsReviewRequest[]
  journeyDeliveries     NrmsJourneyDelivery[]

  @@index([propertyId, phone])
  @@index([propertyId, fullName])
  @@index([ownerId])
  @@map("guest_profile")
}

/// Owner-level marketing consent keyed by canonical phone number. Keeping this
/// separate from GuestProfile prevents duplicate profiles/properties from
/// disagreeing about whether the same person opted in or out.
model GuestSmsPreference {
  id              Int       @id @default(autoincrement())
  ownerId         Int
  normalizedPhone String    @db.VarChar(24)
  status          String    @default("UNKNOWN") @db.VarChar(20) // UNKNOWN, OPTED_IN, OPTED_OUT
  consentSource   String?   @db.VarChar(40)
  consentAt       DateTime?
  optedOutAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner User @relation("GuestSmsPreferenceOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, normalizedPhone])
  @@index([ownerId, status])
  @@map("guest_sms_preference")
}

/// One auditable promotional send request. Recipients are snapshotted when the
/// campaign is queued so later guest/profile edits cannot silently change it.
model GuestSmsCampaign {
  id             Int       @id @default(autoincrement())
  ownerId        Int
  propertyId     Int
  name           String    @db.VarChar(120)
  kind           String    @db.VarChar(30) // OFFER, RETURN_INVITATION
  message        String    @db.VarChar(612)
  audienceType   String    @db.VarChar(30) // SELECTED, ALL_ELIGIBLE, INACTIVE_90, INACTIVE_180, INACTIVE_365, REPEAT_GUESTS
  audienceFilter Json?
  status         String    @default("DRAFT") @db.VarChar(20) // DRAFT, QUEUED, SENDING, COMPLETED, PARTIAL, FAILED, CANCELLED
  totalCount     Int       @default(0)
  eligibleCount  Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  skippedCount   Int       @default(0)
  queuedAt       DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner      User                        @relation("GuestSmsCampaignOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  property   Property                    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  recipients GuestSmsCampaignRecipient[]

  @@index([ownerId, createdAt])
  @@index([propertyId, status])
  @@map("guest_sms_campaign")
}

/// Delivery record for one unique phone in one campaign. The unique key stops
/// duplicate guest profiles from receiving the same campaign more than once.
model GuestSmsCampaignRecipient {
  id                Int       @id @default(autoincrement())
  campaignId        Int
  guestProfileId    Int?
  normalizedPhone   String    @db.VarChar(24)
  guestName         String    @db.VarChar(160)
  status            String    @default("QUEUED") @db.VarChar(20) // QUEUED, SENDING, SENT, FAILED, SKIPPED
  skipReason        String?   @db.VarChar(40)
  provider          String?   @db.VarChar(30)
  providerMessageId String?   @db.VarChar(160)
  errorMessage      String?   @db.VarChar(500)
  quotaYear         Int?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  campaign     GuestSmsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  guestProfile GuestProfile?    @relation(fields: [guestProfileId], references: [id], onDelete: SetNull)

  @@unique([campaignId, normalizedPhone])
  @@index([status, createdAt])
  @@index([guestProfileId])
  @@map("guest_sms_campaign_recipient")
}

/// Atomic reservation counter for the maximum three promotional messages per
/// owner, phone number, and calendar year.
model GuestSmsAnnualQuota {
  id              Int      @id @default(autoincrement())
  ownerId         Int
  normalizedPhone String   @db.VarChar(24)
  year            Int
  usedCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner User @relation("GuestSmsAnnualQuotaOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, normalizedPhone, year])
  @@index([ownerId, year])
  @@map("guest_sms_annual_quota")
}

/// NRMS operational reservation (doc 6.3, 6.4, 9.3).
/// External/direct/walk-in stays use this as their source of truth.
/// A NoLSAF marketplace stay links here via bookingId as an operational view
/// only; Booking keeps payment/commission/payout authority (doc 6.5).
/// Lifecycle: DRAFT -> HELD -> CONFIRMED -> CHECKED_IN -> CHECKED_OUT,
/// terminal alternatives CANCELLED, NO_SHOW, EXPIRED. HELD consumes inventory
/// until holdExpiresAt; CANCELLED/EXPIRED/NO_SHOW do not (doc 6.4).
model Reservation {
  id                                Int  @id @default(autoincrement())
  propertyId                        Int
  ownerId                           Int
  guestProfileId                    Int?
  groupId                           Int?
  /// 1:1 link to the marketplace booking when source is NOLSAF
  bookingId                         Int? @unique
  /// Set when this reservation was booked by an approved travel agent through
  /// the B2B agent portal. Carries both the agency and the hotel context.
  agentPropertyLinkId               Int?
  /// Set on the real per-room stays created after an agent manifest is
  /// verified. The booking request's legacy reservationId continues to point
  /// at the anonymous inventory placeholder for audit history; this field is
  /// the durable one-to-many operational handover.
  materializedAgentBookingRequestId Int?

  source      String  @default("WALK_IN") @db.VarChar(20) // NOLSAF, WALK_IN, PHONE, DIRECT, AIRBNB, BOOKING_COM, EXPEDIA, OTHER
  /// Commercial attribution (doc 7.10): NOLSAF_MARKETPLACE, OWNER_DIRECT, EXTERNAL_RECORDED
  attribution String? @db.VarChar(30)
  /// Reference in the external system (e.g. Airbnb confirmation code)
  externalRef String? @db.VarChar(120)

  status        String    @default("DRAFT") @db.VarChar(20) // DRAFT, HELD, CONFIRMED, CHECKED_IN, CHECKED_OUT, CANCELLED, NO_SHOW, EXPIRED
  holdExpiresAt DateTime?

  checkIn  DateTime
  checkOut DateTime
  adults   Int      @default(1)
  children Int      @default(0)

  // Price snapshot for external stays (doc 4: snapshot when applied).
  // Marketplace money stays on Booking/Invoice; these fields are NULL/0 for
  // source NOLSAF reservations.
  currency       String   @default("TZS") @db.VarChar(3)
  roomRate       Decimal? @db.Decimal(12, 2) // quoted rate per night
  discountAmount Decimal  @default(0.00) @db.Decimal(12, 2)
  taxAmount      Decimal  @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal  @default(0.00) @db.Decimal(12, 2)
  depositAmount  Decimal  @default(0.00) @db.Decimal(12, 2)
  /// Denormalized sum of non-voided ExternalPaymentRecord rows
  amountPaid     Decimal  @default(0.00) @db.Decimal(12, 2)
  /// Denormalized sum of non-voided ReservationCharge rows (guest folio extras)
  chargesTotal   Decimal  @default(0.00) @db.Decimal(12, 2)

  // Lifecycle timestamps (actual, not scheduled)
  confirmedAt  DateTime?
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  cancelledAt  DateTime?
  cancelReason String?   @db.VarChar(300)
  noShowAt     DateTime?

  notes       String? @db.Text
  createdById Int?

  /// Stable number printed on NRMS invoices/receipts and encoded in Code 128.
  receiptNumber String? @unique @db.VarChar(32)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property                        Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner                           User                     @relation("NrmsReservationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  guestProfile                    GuestProfile?            @relation(fields: [guestProfileId], references: [id], onDelete: SetNull)
  group                           NrmsReservationGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  booking                         Booking?                 @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdBy                       User?                    @relation("NrmsReservationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  agentPropertyLink               NrmsAgentPropertyLink?   @relation(fields: [agentPropertyLinkId], references: [id], onDelete: SetNull)
  agentBookingRequest             NrmsAgentBookingRequest? @relation("NrmsAgentBookingRequestReservation")
  materializedAgentBookingRequest NrmsAgentBookingRequest? @relation("NrmsAgentBookingMaterializedReservations", fields: [materializedAgentBookingRequestId], references: [id], onDelete: SetNull)
  agentBookingGuests              NrmsAgentBookingGuest[]  @relation("NrmsAgentBookingGuestReservation")

  allocations               ReservationRoomAllocation[]
  events                    ReservationEvent[]
  roomingListRow            NrmsRoomingListRow?
  channelInboundEvents      ChannelInboundEvent[]
  channelOutboundDeliveries ChannelOutboundDelivery[]
  channelCalendarEvents     ChannelCalendarEventMap[]
  payments                  ExternalPaymentRecord[]
  charges                   ReservationCharge[]
  masterFolioItems          NrmsMasterFolioItem[]
  outletOrders              NrmsOutletOrder[]
  nrmsUsageEvents           NrmsUsageEvent[]
  housekeepingTasks         NrmsHousekeepingTask[]
  serviceCases              NrmsServiceCase[]
  paymentRequests           NrmsGuestPaymentRequest[]
  reviewRequests            NrmsReviewRequest[]
  journeyDeliveries         NrmsJourneyDelivery[]
  guestInquiry              NrmsGuestInquiry?
  /// Legacy availability block this reservation was migrated from (doc 10.2)
  legacyBlock               PropertyAvailabilityBlock?  @relation("BlockMigratedReservation")

  @@unique([propertyId, source, externalRef], map: "reservation_property_source_external_ref_key")
  @@index([propertyId, checkIn, checkOut])
  @@index([propertyId, status])
  @@index([ownerId, status])
  @@index([guestProfileId])
  @@index([groupId, status])
  @@index([source])
  @@index([status, holdExpiresAt])
  @@index([agentPropertyLinkId])
  @@index([materializedAgentBookingRequestId, status], map: "reservation_materializedAgentBookingRequestId_status_idx")
  @@map("reservation")
}

/// Front-desk grouping for families, delegations and tour parties. A group
/// coordinates operations; every member remains an ordinary Reservation and
/// therefore consumes the same property inventory as every other channel.
model NrmsReservationGroup {
  id          Int     @id @default(autoincrement())
  propertyId  Int
  ownerId     Int
  reference   String  @unique @db.VarChar(32)
  name        String  @db.VarChar(160)
  notes       String? @db.Text
  status      String  @default("ACTIVE") @db.VarChar(30) // ACTIVE, PARTIALLY_CHECKED_IN, CHECKED_IN, PARTIALLY_CHECKED_OUT, CHECKED_OUT, CANCELLED
  createdById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property     Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner        User            @relation("NrmsReservationGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy    User?           @relation("NrmsReservationGroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reservations Reservation[]
  block        NrmsGroupBlock?

  @@index([propertyId, status])
  @@index([ownerId, createdAt])
  @@map("nrms_reservation_group")
}

/// A group block (allotment): rooms held for a party before any guest names
/// exist. This is the first half of the standard group flow. The second half is
/// the rooming list, where the agency supplies who occupies which room, and
/// pickup, where those names materialise into real Reservations.
///
/// Inventory: an un-picked-up block room consumes capacity exactly like a
/// reservation does, so the desk cannot oversell rooms it has promised. Once a
/// room is picked up, the Reservation consumes it instead and the block stops
/// counting that one, otherwise the same room would be counted twice.
///
/// Cut-off is evaluated lazily, the same way a HELD reservation's holdExpiresAt
/// is: past cutOffAt the block simply stops consuming and the rooms return to
/// sale. No worker has to run for inventory to be correct.
model NrmsGroupBlock {
  id         Int  @id @default(autoincrement())
  propertyId Int
  ownerId    Int
  /// Set once the first room is picked up: the operational group that the
  /// materialised reservations are worked through at the front desk.
  groupId    Int? @unique

  reference String @unique @db.VarChar(32)
  name      String @db.VarChar(160)

  /// Who the block was agreed with. A tour operator is the common case.
  agencyName   String? @db.VarChar(160)
  contactName  String? @db.VarChar(160)
  contactPhone String? @db.VarChar(40)
  contactEmail String? @db.VarChar(160)

  checkIn  DateTime @db.Date
  checkOut DateTime @db.Date
  /// Rooms still unnamed after this moment release back to sale.
  cutOffAt DateTime

  /// HELD, PARTIALLY_PICKED_UP, PICKED_UP, RELEASED, CANCELLED
  status      String @default("HELD") @db.VarChar(30)
  currency    String @default("TZS") @db.VarChar(3)
  /// MASTER, SPLIT, INDIVIDUAL. Recorded from the start so the commercial terms
  /// are captured at agreement time; the master folio that MASTER and SPLIT
  /// need arrives with the group billing work.
  billingMode String @default("INDIVIDUAL") @db.VarChar(20)

  /// The qualification rule frozen when the agreement was created. Standard
  /// groups meet this room count; smaller contracted parties require an owner
  /// approval reason. Existing groups are never reclassified later.
  groupMinimumRooms        Int       @default(5)
  agreedRoomsAtCreation    Int?
  smallGroupApprovedAt     DateTime?
  smallGroupApprovalReason String?   @db.VarChar(300)

  notes       String?   @db.Text
  createdById Int?
  releasedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property    Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner       User                  @relation("NrmsGroupBlockOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy   User?                 @relation("NrmsGroupBlockCreator", fields: [createdById], references: [id], onDelete: SetNull)
  group       NrmsReservationGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  rooms       NrmsGroupBlockRoom[]
  roomingList NrmsRoomingList?
  masterFolio NrmsMasterFolio?

  @@index([propertyId, status])
  @@index([ownerId, createdAt])
  @@index([status, cutOffAt])
  @@map("nrms_group_block")
}

/// One line of a block: how many rooms of a type, at what agreed nightly rate.
/// `pickedUp` is the count already materialised into reservations, so the rooms
/// still being held is always `quantity - pickedUp`.
model NrmsGroupBlockRoom {
  id          Int     @id @default(autoincrement())
  blockId     Int
  roomTypeId  Int
  ratePlanId  Int?
  quantity    Int     @default(1)
  pickedUp    Int     @default(0)
  nightlyRate Decimal @default(0.00) @db.Decimal(12, 2)
  mealPlan    String? @db.VarChar(20)

  block           NrmsGroupBlock       @relation(fields: [blockId], references: [id], onDelete: Cascade)
  roomType        RoomType             @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  ratePlan        NrmsRatePlan?        @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)
  roomingListRows NrmsRoomingListRow[]

  @@unique([blockId, roomTypeId, ratePlanId], map: "nrms_group_block_room_line_key")
  @@index([roomTypeId])
  @@map("nrms_group_block_room")
}

/// The rooming list: a capability link the desk shares with the agency or group
/// leader so they fill in who is staying, instead of the desk typing twenty
/// names off a phone call.
///
/// `publicToken` is a bearer credential, handled exactly like
/// NrmsGuestPaymentRequest.publicToken: no-store, no-referrer, noindex.
///
/// Submitting NEVER touches inventory. Rows land in staging and only the desk
/// pressing confirm materialises reservations, otherwise an agency submitting
/// at midnight could oversell the property.
model NrmsRoomingList {
  id      Int @id @default(autoincrement())
  blockId Int @unique

  publicToken  String    @unique @db.VarChar(80)
  /// DRAFT, SENT, SUBMITTED, RETURNED, CONFIRMED, REVOKED
  status       String    @default("DRAFT") @db.VarChar(20)
  expiresAt    DateTime
  sentAt       DateTime?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById Int?

  /// Who filled it in, captured on submit so the desk knows who to call back.
  submitterName  String? @db.VarChar(160)
  submitterEmail String? @db.VarChar(160)
  /// Desk feedback shown to the agency when a list is sent back for fixing.
  deskNotes      String? @db.Text
  /// Instructions the desk writes for the agency, shown on the public page.
  instructions   String? @db.Text

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  block      NrmsGroupBlock       @relation(fields: [blockId], references: [id], onDelete: Cascade)
  createdBy  User?                @relation("NrmsRoomingListCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy User?                @relation("NrmsRoomingListReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  rows       NrmsRoomingListRow[]

  @@index([status, expiresAt])
  @@map("nrms_rooming_list")
}

/// One proposed occupant. Staging only: a row is just text until the desk
/// accepts it and pickup turns it into a Reservation, which is recorded here as
/// `reservationId` so a confirmed row can never be picked up twice.
model NrmsRoomingListRow {
  id            Int  @id @default(autoincrement())
  roomingListId Int
  /// Which block line the agency wants this guest in. Nullable because the
  /// agency may leave the choice to the desk.
  blockRoomId   Int?

  fullName    String  @db.VarChar(160)
  phone       String? @db.VarChar(40)
  email       String? @db.VarChar(160)
  nationality String? @db.VarChar(80)
  adults      Int     @default(1)
  children    Int     @default(0)
  /// Free text from the agency, e.g. "sharing with Amina Juma".
  sharingWith String? @db.VarChar(160)
  notes       String? @db.Text

  /// PENDING, ACCEPTED, REJECTED
  status          String  @default("PENDING") @db.VarChar(20)
  rejectionReason String? @db.VarChar(300)
  reservationId   Int?    @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomingList NrmsRoomingList     @relation(fields: [roomingListId], references: [id], onDelete: Cascade)
  blockRoom   NrmsGroupBlockRoom? @relation(fields: [blockRoomId], references: [id], onDelete: SetNull)
  reservation Reservation?        @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([roomingListId, status])
  @@map("nrms_rooming_list_row")
}

/// The commercial bill for a group block or approved agent booking. Guest reservations retain their
/// original room and charge values for revenue reporting; items here record
/// which of those values the agency or group organiser accepted liability for.
/// One agency payment settles this folio directly and is never fanned out into
/// invented per-reservation payment rows.
model NrmsMasterFolio {
  id                    Int  @id @default(autoincrement())
  blockId               Int? @unique
  agentBookingRequestId Int? @unique
  propertyId            Int
  ownerId               Int

  reference        String @unique @db.VarChar(40)
  /// SPLIT or MASTER. Snapshotted on first pickup and frozen afterwards.
  billingMode      String @db.VarChar(20)
  currency         String @default("TZS") @db.VarChar(3)
  /// OPEN while money remains due, SETTLED at zero, CREDIT after a later void
  /// leaves the agency overpaid and the refund still unresolved.
  status           String @default("OPEN") @db.VarChar(20)
  /// The first implementation is deliberately strict. APPROVED_CREDIT is
  /// reserved for a future agency-credit account with limits and approval.
  settlementPolicy String @default("PAY_BEFORE_DEPARTURE") @db.VarChar(30)

  /// Bill-to snapshot: later edits to the block must not rewrite an issued bill.
  billToName   String    @db.VarChar(160)
  contactName  String?   @db.VarChar(160)
  contactPhone String?   @db.VarChar(40)
  contactEmail String?   @db.VarChar(160)
  settledAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  block               NrmsGroupBlock?           @relation(fields: [blockId], references: [id], onDelete: Cascade)
  agentBookingRequest NrmsAgentBookingRequest?  @relation(fields: [agentBookingRequestId], references: [id], onDelete: Cascade)
  property            Property                  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner               User                      @relation("NrmsMasterFolioOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  items               NrmsMasterFolioItem[]
  payments            NrmsMasterFolioPayment[]
  refunds             NrmsMasterFolioRefund[]
  proFormas           NrmsMasterFolioProForma[]

  @@index([propertyId, status])
  @@index([ownerId, createdAt])
  @@map("nrms_master_folio")
}

/// An amount routed from a source reservation onto its group's master bill.
/// sourceKey makes automatic posting idempotent across retries and concurrency.
model NrmsMasterFolioItem {
  id                  Int  @id @default(autoincrement())
  masterFolioId       Int
  reservationId       Int
  reservationChargeId Int? @unique

  sourceKey   String  @unique @db.VarChar(80)
  kind        String  @db.VarChar(20) // ROOM, EXTRA
  description String? @db.VarChar(300)
  amount      Decimal @db.Decimal(12, 2)
  currency    String  @default("TZS") @db.VarChar(3)

  voidedAt   DateTime?
  voidReason String?   @db.VarChar(300)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  masterFolio       NrmsMasterFolio    @relation(fields: [masterFolioId], references: [id], onDelete: Cascade)
  reservation       Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reservationCharge ReservationCharge? @relation(fields: [reservationChargeId], references: [id], onDelete: SetNull)

  @@index([masterFolioId, voidedAt])
  @@index([reservationId, voidedAt])
  @@map("nrms_master_folio_item")
}

/// One real payment from the agency/group organiser. Corrections retain the
/// original row and mark it void, mirroring guest folio payments.
model NrmsMasterFolioPayment {
  id             Int     @id @default(autoincrement())
  masterFolioId  Int
  amount         Decimal @db.Decimal(12, 2)
  currency       String  @default("TZS") @db.VarChar(3)
  method         String  @db.VarChar(30)
  reference      String? @db.VarChar(120)
  idempotencyKey String? @db.VarChar(120)
  receiptNumber  String  @unique @db.VarChar(40)
  note           String? @db.VarChar(300)
  recordedById   Int?

  voidedAt   DateTime?
  voidReason String?   @db.VarChar(300)
  createdAt  DateTime  @default(now())

  masterFolio NrmsMasterFolio @relation(fields: [masterFolioId], references: [id], onDelete: Cascade)
  recordedBy  User?           @relation("NrmsMasterPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([masterFolioId, idempotencyKey])
  @@index([masterFolioId, createdAt])
  @@index([method])
  @@map("nrms_master_folio_payment")
}

/// Money actually returned to the agency or group organiser. Refunds are kept
/// separate from receipts so the original payment and every correction remain
/// visible in the audit trail. Voiding a mistaken refund restores the payment.
model NrmsMasterFolioRefund {
  id            Int     @id @default(autoincrement())
  masterFolioId Int
  amount        Decimal @db.Decimal(12, 2)
  currency      String  @default("TZS") @db.VarChar(3)
  method        String  @db.VarChar(30)
  reference     String? @db.VarChar(120)
  refundNumber  String  @unique @db.VarChar(40)
  reason        String  @db.VarChar(300)
  recordedById  Int?

  voidedAt   DateTime?
  voidReason String?   @db.VarChar(300)
  createdAt  DateTime  @default(now())

  masterFolio NrmsMasterFolio @relation(fields: [masterFolioId], references: [id], onDelete: Cascade)
  recordedBy  User?           @relation("NrmsMasterRefundRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([masterFolioId, createdAt])
  @@index([method])
  @@map("nrms_master_folio_refund")
}

/// Property-owned manual bank instructions used only on NRMS Pro Forma
/// documents when the bank is outside supported payout rails. This is not a
/// PayoutAccount, is never sent to AzamPay, and must never be represented as
/// verified by NoLSAF. The account number is encrypted at rest and the owner
/// acceptance is retained as an audit record.
model NrmsProFormaBankAccount {
  id         Int @id @default(autoincrement())
  propertyId Int @unique
  ownerId    Int

  bankName         String  @db.VarChar(120)
  accountName      String  @db.VarChar(160)
  accountNumberEnc String  @db.Text
  accountCurrency  String  @default("TZS") @db.VarChar(3)
  branchName       String? @db.VarChar(120)
  bankAddress      String? @db.VarChar(240)
  swiftCode        String? @db.VarChar(32)
  iban             String? @db.VarChar(64)
  routingCode      String? @db.VarChar(64)
  instructions     String? @db.VarChar(500)
  active           Boolean @default(true)

  policyVersion      String   @db.VarChar(30)
  policyAcceptedAt   DateTime
  policyAcceptedById Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner            User     @relation("NrmsProFormaBankOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  policyAcceptedBy User     @relation("NrmsProFormaBankPolicyAcceptedBy", fields: [policyAcceptedById], references: [id], onDelete: Restrict)

  @@index([ownerId, active])
  @@map("nrms_pro_forma_bank_account")
}

/// An immutable payment request issued by the property to the agency. Charges,
/// payments, bill-to details and the verified receiving account are snapshotted
/// at generation time so an old PDF never changes when the block or profile is
/// edited later. The QR token opens a read-only verification page; NoLSAF does
/// not collect or hold the agency's payment.
model NrmsMasterFolioProForma {
  id            Int    @id @default(autoincrement())
  masterFolioId Int
  number        String @unique @db.VarChar(48)
  revision      Int    @default(1)
  status        String @default("DRAFT") @db.VarChar(20)
  currency      String @default("TZS") @db.VarChar(3)

  issuedAt   DateTime @default(now())
  dueAt      DateTime @db.Date
  validUntil DateTime @db.Date

  billToName   String  @db.VarChar(160)
  contactName  String  @db.VarChar(160)
  contactEmail String  @db.VarChar(160)
  contactPhone String? @db.VarChar(40)

  propertyName     String  @db.VarChar(200)
  propertyLocation String? @db.VarChar(500)
  propertyTin      String? @db.VarChar(50)
  propertyEmail    String? @db.VarChar(160)
  propertyPhone    String? @db.VarChar(40)

  bankName             String  @db.VarChar(80)
  bankAccountName      String  @db.VarChar(160)
  bankAccountNumberEnc String  @db.Text
  bankBranch           String? @db.VarChar(120)
  bankSource           String  @default("VERIFIED_PAYOUT") @db.VarChar(30)
  bankCurrency         String? @db.VarChar(3)
  bankAddress          String? @db.VarChar(240)
  bankSwiftCode        String? @db.VarChar(32)
  bankIban             String? @db.VarChar(64)
  bankRoutingCode      String? @db.VarChar(64)
  bankInstructions     String? @db.VarChar(500)

  itemsSnapshot    Json
  paymentsSnapshot Json
  quotedTotal      Decimal @db.Decimal(12, 2)
  paidAtIssue      Decimal @db.Decimal(12, 2)
  balanceDue       Decimal @db.Decimal(12, 2)
  notes            String? @db.VarChar(1000)

  publicToken  String    @unique @db.VarChar(96)
  viewCount    Int       @default(0)
  lastViewedAt DateTime?

  createdById       Int?
  sentById          Int?
  sentAt            DateTime?
  sentToEmail       String?   @db.VarChar(160)
  deliveryProvider  String?   @db.VarChar(30)
  deliveryMessageId String?   @db.VarChar(160)
  supersededAt      DateTime?

  /// Agency declaration only. It never settles the ledger; the property must
  /// inspect its account and record the received payment separately.
  /// payerPaymentAccountName is the account the agency says it paid FROM, so
  /// the property can match the credit. It is null for a CASH declaration.
  payerMarkedPaidAt       DateTime?
  payerMarkedPaidById     Int?
  payerPaymentReference   String?   @db.VarChar(120)
  payerPaymentMethod      String?   @db.VarChar(20)
  payerPaymentAccountName String?   @db.VarChar(160)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  masterFolio NrmsMasterFolio @relation(fields: [masterFolioId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation("NrmsProFormaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sentBy      User?           @relation("NrmsProFormaSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  @@unique([masterFolioId, revision])
  @@index([masterFolioId, status, createdAt])
  @@index([contactEmail, sentAt])
  @@map("nrms_master_folio_pro_forma")
}

/// Room-type or room-unit allocation for a reservation (doc 9.3). One row per
/// allocated room; a room move releases the old row and creates a new one so
/// history is preserved (doc 4, 7.4). Date-range rows are what the shared
/// availability kernel queries (doc 6.1).
model ReservationRoomAllocation {
  id            Int  @id @default(autoincrement())
  reservationId Int
  roomTypeId    Int
  roomUnitId    Int?

  startDate DateTime
  endDate   DateTime // exclusive, like checkout

  status String @default("ACTIVE") @db.VarChar(20) // ACTIVE, RELEASED

  /// The rate plan this room was sold on. Lives here rather than on
  /// Reservation because that is the granularity the industry uses: a family
  /// on two rooms can sit on two different plans, and a mid-stay plan change
  /// is already handled by the release-and-recreate rule above, which makes
  /// these rows a per-night rate detail by another name.
  ratePlanId Int?

  /// ROOM_ONLY | BREAKFAST | HALF_BOARD | FULL_BOARD | ALL_INCLUSIVE, copied
  /// from the rate plan at the moment the room was sold. Snapshot, not a
  /// join: editing a rate plan in March must not silently rewrite what a
  /// January guest was entitled to, exactly as Reservation snapshots price
  /// when applied. NULL means the stay predates this column or arrived
  /// without a plan; the breakfast list prints those as "verify" rather than
  /// dropping the guest, because a guest turned away at the buffet is a
  /// complaint and a guest fed by mistake is only a cost.
  mealPlan String? @db.VarChar(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservation     Reservation      @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  roomType        RoomType         @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  roomUnit        RoomUnit?        @relation(fields: [roomUnitId], references: [id], onDelete: SetNull)
  ratePlan        NrmsRatePlan?    @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)
  nrmsUsageEvents NrmsUsageEvent[]

  @@index([reservationId])
  @@index([ratePlanId])
  @@index([roomUnitId, status, startDate, endDate], map: "rra_unit_status_start_end_idx")
  @@index([roomTypeId, status, startDate, endDate], map: "rra_type_status_start_end_idx")
  @@map("reservation_room_allocation")
}

/// Immutable audit timeline for a reservation/stay (doc 9.3 StayEvent, 14).
model ReservationEvent {
  id            Int    @id @default(autoincrement())
  reservationId Int
  type          String @db.VarChar(40) // CREATED, CONFIRMED, ROOM_ASSIGNED, ROOM_MOVED, CHECKED_IN, CHECKED_OUT, CANCELLED, NO_SHOW, EXPIRED, PAYMENT_RECORDED, PAYMENT_VOIDED, CHARGE_POSTED, CHARGE_VOIDED, EDITED
  data          Json?
  actorId       Int?

  createdAt DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  actor       User?       @relation("NrmsReservationEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([reservationId, createdAt])
  @@index([type])
  @@map("reservation_event")
}

// =========================================================
//  NRMS - Provider-neutral OTA channel foundation
//  Phase 0 of docs/NRMS_MARKET_READINESS_PRIVATE.md
// =========================================================

/// A supported distribution provider. Provider-specific behavior belongs in
/// connector code; this catalog remains stable across property connections.
model ChannelProvider {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(40) // BOOKING_COM, AIRBNB, EXPEDIA
  name      String   @db.VarChar(120)
  status    String   @default("ACTIVE") @db.VarChar(20) // ACTIVE, DISABLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connections ChannelConnection[]

  @@index([status])
  @@map("channel_provider")
}

/// One property-scoped connection to one provider. This is the tenant
/// boundary for all channel state and is deliberately provider-neutral.
model ChannelConnection {
  id                 Int       @id @default(autoincrement())
  propertyId         Int
  providerId         Int
  connectionType     String    @default("API") @db.VarChar(20) // API, ICAL
  status             String    @default("DISCONNECTED") @db.VarChar(20) // DISCONNECTED, PENDING, ACTIVE, STALE, ERROR, PAUSED
  trustTier          String    @default("UNTRUSTED") @db.VarChar(20) // UNTRUSTED, PILOT, CERTIFIED, DELAYED
  externalPropertyId String?   @db.VarChar(160)
  lastInboundAt      DateTime?
  lastOutboundAt     DateTime?
  lastSuccessAt      DateTime?
  lastFailureAt      DateTime?
  lastErrorCode      String?   @db.VarChar(80)
  lastErrorMessage   String?   @db.VarChar(1000)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  property             Property                     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  provider             ChannelProvider              @relation(fields: [providerId], references: [id], onDelete: Restrict)
  propertyMapping      ChannelPropertyMapping?
  roomMappings         ChannelRoomMapping[]
  rateMappings         ChannelRateMapping[]
  credentialVersions   ChannelCredentialVersion[]
  syncCursors          ChannelSyncCursor[]
  inboundEvents        ChannelInboundEvent[]
  outboundDeliveries   ChannelOutboundDelivery[]
  syncRuns             ChannelSyncRun[]
  reconciliationIssues ChannelReconciliationIssue[]
  calendarFeeds        ChannelCalendarFeed[]
  operationalSnapshots ChannelOperationalSnapshot[]
  operationalAlerts    ChannelOperationalAlert[]
  alertRoute           ChannelAlertRoute?
  stopSellRequests     ChannelStopSellRequest[]

  @@unique([propertyId, providerId])
  @@index([propertyId, status])
  @@index([providerId, status])
  @@index([status, lastSuccessAt])
  @@map("channel_connection")
}

/// Maps the provider property/listing identity to an NRMS property.
model ChannelPropertyMapping {
  id             Int      @id @default(autoincrement())
  connectionId   Int      @unique
  externalId     String   @db.VarChar(160)
  externalName   String?  @db.VarChar(200)
  status         String   @default("UNMAPPED") @db.VarChar(20) // UNMAPPED, MAPPED, INVALID
  mappingVersion Int      @default(1)
  metadata       Json?
  createdById    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdBy  User?             @relation("ChannelPropertyMappingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([externalId])
  @@index([status])
  @@map("channel_property_mapping")
}

/// Maps a provider room/product to an NRMS room type.
model ChannelRoomMapping {
  id             Int      @id @default(autoincrement())
  connectionId   Int
  roomTypeId     Int
  externalId     String   @db.VarChar(160)
  externalName   String?  @db.VarChar(200)
  status         String   @default("UNMAPPED") @db.VarChar(20) // UNMAPPED, MAPPED, INVALID
  mappingVersion Int      @default(1)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  roomType   RoomType          @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([connectionId, roomTypeId])
  @@unique([connectionId, roomTypeId, externalId])
  @@index([roomTypeId, status])
  @@map("channel_room_mapping")
}

/// Maps a provider rate plan to an NRMS room type/rate identity. The rate
/// plan is intentionally metadata-driven until the reusable NRMS rate-plan
/// domain is introduced in the next roadmap phase.
model ChannelRateMapping {
  id             Int      @id @default(autoincrement())
  connectionId   Int
  roomTypeId     Int?
  externalId     String   @db.VarChar(160)
  externalName   String?  @db.VarChar(200)
  currency       String?  @db.VarChar(3)
  status         String   @default("UNMAPPED") @db.VarChar(20) // UNMAPPED, MAPPED, INVALID
  mappingVersion Int      @default(1)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  roomType   RoomType?         @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)

  @@unique([connectionId, externalId])
  @@index([connectionId, roomTypeId, status])
  @@map("channel_rate_mapping")
}

/// Versioned provider credentials. The application must encrypt the payload
/// before persistence; plaintext credentials must never enter logs or JSON
/// responses.
model ChannelCredentialVersion {
  id               Int       @id @default(autoincrement())
  connectionId     Int
  version          Int
  status           String    @default("STAGED") @db.VarChar(20) // STAGED, ACTIVE, REVOKED
  encryptedData    String    @db.Text
  activatedAt      DateTime?
  revokedAt        DateTime?
  validationStatus String    @default("UNTESTED") @db.VarChar(20) // UNTESTED, VALIDATED, FAILED
  validatedAt      DateTime?
  validationError  String?   @db.VarChar(500)
  stagedExpiresAt  DateTime?
  createdById      Int?
  createdAt        DateTime  @default(now())

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdBy  User?             @relation("ChannelCredentialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([connectionId, version])
  @@index([connectionId, status])
  @@map("channel_credential_version")
}

/// Periodic operational evidence used for SLO, lag and queue trend reporting.
model ChannelOperationalSnapshot {
  id                 Int       @id @default(autoincrement())
  connectionId       Int
  capturedAt         DateTime  @default(now())
  healthState        String    @db.VarChar(20)
  lagMinutes         Int?
  pendingDeliveries  Int       @default(0)
  sendingDeliveries  Int       @default(0)
  failedDeliveries   Int       @default(0)
  deadLetters        Int       @default(0)
  openIssues         Int       @default(0)
  criticalIssues     Int       @default(0)
  deliverySuccessBps Int?
  lastSuccessAt      DateTime?

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, capturedAt])
  @@index([healthState, capturedAt])
  @@map("channel_operational_snapshot")
}

/// Per-connection destinations and throttling policy for automatic alerts.
model ChannelAlertRoute {
  id              Int      @id @default(autoincrement())
  connectionId    Int      @unique
  adminsEnabled   Boolean  @default(true)
  ownerEnabled    Boolean  @default(true)
  minimumSeverity String   @default("ATTENTION") @db.VarChar(20)
  cooldownMinutes Int      @default(30)
  updatedById     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([minimumSeverity])
  @@map("channel_alert_route")
}

/// Deduplicated operational incident. activeKey is cleared when resolved so
/// later recurrences retain separate incident history.
model ChannelOperationalAlert {
  id              Int       @id @default(autoincrement())
  connectionId    Int
  activeKey       String?   @unique @db.VarChar(160)
  kind            String    @db.VarChar(60)
  severity        String    @db.VarChar(20)
  status          String    @default("OPEN") @db.VarChar(20) // OPEN, RESOLVED
  occurrenceCount Int       @default(1)
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  lastNotifiedAt  DateTime?
  resolvedAt      DateTime?
  details         Json?

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, status, severity])
  @@index([status, lastSeenAt])
  @@map("channel_operational_alert")
}

/// Dual-control emergency stop-sell or inventory-release request. Provider
/// acknowledgement is retained as evidence instead of treating queueing as success.
model ChannelStopSellRequest {
  id                  Int       @id @default(autoincrement())
  connectionId        Int
  action              String    @db.VarChar(20) // APPLY, RELEASE
  status              String    @default("PENDING_APPROVAL") @db.VarChar(24) // PENDING_APPROVAL, QUEUED, CONFIRMED, REJECTED, FAILED, CANCELLED
  fromDate            DateTime
  toDate              DateTime
  reason              String    @db.VarChar(500)
  requestedById       Int
  approvedById        Int?
  rejectedById        Int?
  decisionReason      String?   @db.VarChar(500)
  deliveryId          Int?
  requestedAt         DateTime  @default(now())
  decidedAt           DateTime?
  providerConfirmedAt DateTime?
  failedAt            DateTime?
  failureMessage      String?   @db.VarChar(1000)

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, requestedAt])
  @@index([status, requestedAt])
  @@index([deliveryId])
  @@map("channel_stop_sell_request")
}

/// Provider cursor/checkpoint by stream. Values are opaque to the shared
/// foundation and interpreted by the provider connector.
model ChannelSyncCursor {
  id           Int       @id @default(autoincrement())
  connectionId Int
  scope        String    @db.VarChar(60) // RESERVATIONS, ARI, CONTENT, CALENDAR
  cursor       String?   @db.Text
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, scope])
  @@index([scope, lastSyncedAt])
  @@map("channel_sync_cursor")
}

/// Inbound inbox row. Store first, normalize later, and use the provider event
/// identity/idempotency key to make replay safe.
model ChannelInboundEvent {
  id                  Int       @id @default(autoincrement())
  connectionId        Int
  providerEventId     String    @db.VarChar(200)
  idempotencyKey      String    @db.VarChar(200)
  eventType           String    @db.VarChar(80)
  payloadHash         String    @db.VarChar(128)
  payload             Json
  status              String    @default("RECEIVED") @db.VarChar(20) // RECEIVED, PROCESSING, PROCESSED, FAILED, IGNORED
  reservationId       Int?
  receivedAt          DateTime  @default(now())
  processingStartedAt DateTime?
  attemptCount        Int       @default(0)
  processedAt         DateTime?
  errorMessage        String?   @db.VarChar(1000)

  connection  ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  reservation Reservation?      @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@unique([connectionId, providerEventId])
  @@unique([connectionId, idempotencyKey])
  @@index([connectionId, status, receivedAt])
  @@index([reservationId])
  @@map("channel_inbound_event")
}

/// Outbox row for an inventory/reservation mutation that must be delivered to
/// a provider. Retries retain the same idempotency identity.
model ChannelOutboundDelivery {
  id             Int       @id @default(autoincrement())
  connectionId   Int
  idempotencyKey String    @db.VarChar(200)
  eventType      String    @db.VarChar(80)
  payload        Json
  status         String    @default("PENDING") @db.VarChar(20) // PENDING, SENDING, ACKNOWLEDGED, FAILED, DEAD_LETTER
  attemptCount   Int       @default(0)
  nextAttemptAt  DateTime?
  lastAttemptAt  DateTime?
  acknowledgedAt DateTime?
  reservationId  Int?
  lastError      String?   @db.VarChar(1000)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  connection  ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  reservation Reservation?      @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@unique([connectionId, idempotencyKey])
  @@index([connectionId, status, nextAttemptAt])
  @@index([reservationId])
  @@map("channel_outbound_delivery")
}

/// One observable synchronization attempt, including full resync and
/// reconciliation runs.
model ChannelSyncRun {
  id           Int       @id @default(autoincrement())
  connectionId Int
  kind         String    @db.VarChar(30) // FULL, DELTA, RECONCILIATION, HEALTH_CHECK
  status       String    @default("RUNNING") @db.VarChar(20) // RUNNING, SUCCEEDED, FAILED, CANCELLED
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  itemCount    Int       @default(0)
  successCount Int       @default(0)
  failureCount Int       @default(0)
  details      Json?
  errorMessage String?   @db.VarChar(1000)

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
  @@index([status, startedAt])
  @@map("channel_sync_run")
}

/// Durable mismatch record shown in the Channels command center.
model ChannelReconciliationIssue {
  id           Int       @id @default(autoincrement())
  connectionId Int
  kind         String    @db.VarChar(40) // UNMAPPED, STALE, INVENTORY_MISMATCH, RESERVATION_MISMATCH, DELIVERY_REJECTED
  severity     String    @default("WARNING") @db.VarChar(20) // INFO, WARNING, CRITICAL
  status       String    @default("OPEN") @db.VarChar(20) // OPEN, ACKNOWLEDGED, RESOLVED, IGNORED
  externalRef  String?   @db.VarChar(200)
  internalRef  String?   @db.VarChar(200)
  details      Json?
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById Int?

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  resolvedBy User?             @relation("ChannelIssueResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([connectionId, status, severity])
  @@index([kind, status])
  @@index([externalRef])
  @@index([internalRef])
  @@map("channel_reconciliation_issue")
}

/// Calendar feed metadata used by iCal channels. URLs are encrypted by the
/// application; urlFingerprint supports safe lookup and rotation.
model ChannelCalendarFeed {
  id             Int       @id @default(autoincrement())
  connectionId   Int
  /// The room type this calendar speaks for. An OTA issues one calendar per
  /// listing and a listing is one room type here, so an imported busy period
  /// and an exported one both belong to exactly one type.
  roomTypeId     Int?
  /// Owner-facing name, normally the listing title on the provider's side.
  label          String?   @db.VarChar(160)
  /// EXPORT only. Rooms of this type withheld from the provider as a safety
  /// margin: the calendar publishes a night as busy once availability falls to
  /// this number, not to zero. Covers the window where the provider is still
  /// selling a room sold here minutes ago. Must stay below the type's capacity
  /// or the listing is closed permanently.
  exportBuffer   Int       @default(0)
  direction      String    @db.VarChar(10) // IMPORT, EXPORT
  status         String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, PAUSED, ERROR, REVOKED
  /// IMPORT holds the provider URL that NRMS polls. EXPORT holds the secret
  /// token of the URL NRMS serves; both are encrypted at rest and EXPORT is
  /// found by urlFingerprint, never by decrypting rows one at a time.
  encryptedUrl   String?   @db.Text
  urlFingerprint String?   @db.VarChar(128)
  lastPolledAt   DateTime?
  lastSuccessAt  DateTime?
  nextPollAt     DateTime?
  lastError      String?   @db.VarChar(1000)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  connection ChannelConnection         @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  roomType   RoomType?                 @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  events     ChannelCalendarEventMap[]

  @@index([connectionId, direction, status])
  @@index([status, nextPollAt])
  @@index([roomTypeId])
  @@index([urlFingerprint])
  @@map("channel_calendar_feed")
}

/// Deduplicated external calendar events. Disappearance is handled by the
/// polling worker with a grace period and must never be mistaken for a guest.
model ChannelCalendarEventMap {
  id                  Int      @id @default(autoincrement())
  feedId              Int
  externalEventId     String   @db.VarChar(200)
  eventHash           String   @db.VarChar(128)
  /// Legacy calendar imports briefly used reservations. New imports are
  /// availability-only and point at a PropertyAvailabilityBlock instead.
  reservationId       Int?
  availabilityBlockId Int?     @unique
  lastSeenAt          DateTime @default(now())
  /// An event must be absent from several complete snapshots before its hold
  /// is released. This protects inventory from transient/partial provider feeds.
  missingCount        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  feed              ChannelCalendarFeed        @relation(fields: [feedId], references: [id], onDelete: Cascade)
  reservation       Reservation?               @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  availabilityBlock PropertyAvailabilityBlock? @relation(fields: [availabilityBlockId], references: [id], onDelete: SetNull)

  @@unique([feedId, externalEventId])
  @@index([reservationId])
  @@index([feedId, lastSeenAt])
  @@map("channel_calendar_event_map")
}

/// Recorded external payment against an NRMS reservation (doc 7.7, 9.4).
/// NRMS records these; it is not the merchant or collector (doc 7.7).
/// Rows are never deleted or edited after creation: corrections use voidedAt
/// plus a replacement row (immutable change history, doc 7.7).
model ExternalPaymentRecord {
  id             Int     @id @default(autoincrement())
  reservationId  Int
  amount         Decimal @db.Decimal(12, 2)
  currency       String  @default("TZS") @db.VarChar(3)
  method         String  @db.VarChar(30) // CASH, MOBILE_MONEY, BANK, CARD, OTHER
  reference      String? @db.VarChar(120)
  idempotencyKey String? @db.VarChar(120)
  note           String? @db.VarChar(300)
  recordedById   Int?

  voidedAt   DateTime?
  voidReason String?   @db.VarChar(300)

  createdAt DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  recordedBy  User?       @relation("NrmsPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([reservationId, idempotencyKey])
  @@index([reservationId, createdAt])
  @@index([method])
  @@map("external_payment_record")
}

/// Extra guest charge posted to an NRMS reservation folio (restaurant, bar,
/// laundry, minibar, room service, transport, damage, other). Sits on top of
/// the room-stay totalAmount: guest balance = totalAmount + chargesTotal -
/// amountPaid. Rows are never deleted or edited after creation: corrections
/// use voidedAt plus a replacement row, mirroring ExternalPaymentRecord.
model ReservationCharge {
  id            Int     @id @default(autoincrement())
  reservationId Int
  category      String  @db.VarChar(30) // RESTAURANT, BAR, LAUNDRY, MINIBAR, ROOM_SERVICE, TRANSPORT, DAMAGE, OTHER
  description   String? @db.VarChar(300)
  amount        Decimal @db.Decimal(12, 2)
  currency      String  @default("TZS") @db.VarChar(3)
  postedById    Int?

  voidedAt   DateTime?
  voidReason String?   @db.VarChar(300)

  createdAt DateTime @default(now())

  reservation     Reservation          @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  postedBy        User?                @relation("NrmsChargePostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  outletOrder     NrmsOutletOrder?     @relation("NrmsOrderFolioCharge")
  masterFolioItem NrmsMasterFolioItem?

  @@index([reservationId, createdAt])
  @@index([category])
  @@map("reservation_charge")
}

/// Operating expense recorded against an NRMS property (staff wages,
/// utilities, supplies, maintenance, marketing, rent, licensing, other).
/// Posts to the general ledger at Night Audit close the same way charges and
/// payments do, debiting the matching EXPENSE account and crediting the
/// settlement account (cash/bank/mobile money/card) or accounts payable when
/// left unpaid. Rows are never edited after creation: corrections use
/// voidedAt plus a replacement row, mirroring ReservationCharge.
model NrmsExpense {
  id            Int      @id @default(autoincrement())
  propertyId    Int
  category      String   @db.VarChar(30) // STAFF_WAGES, UTILITIES, SUPPLIES, MAINTENANCE, MARKETING, RENT, LICENSING, OTHER
  description   String   @db.VarChar(300)
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("TZS") @db.VarChar(3)
  paymentMethod String?  @db.VarChar(30) // CASH, MOBILE_MONEY, BANK, CARD, OTHER; null = accrued, unpaid at time of recording
  incurredAt    DateTime // the business date this expense belongs to, distinct from createdAt
  recordedById  Int?

  voidedAt   DateTime?
  voidReason String?   @db.VarChar(300)

  createdAt DateTime @default(now())

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  recordedBy User?    @relation("NrmsExpenseRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([propertyId, incurredAt])
  @@index([category])
  @@map("nrms_expense")
}

/// Property-scoped restaurant, bar, or service outlet operating only inside NRMS.
model NrmsOutlet {
  id                 Int     @id @default(autoincrement())
  propertyId         Int
  name               String  @db.VarChar(120)
  code               String  @db.VarChar(24)
  type               String  @db.VarChar(30) // RESTAURANT, BAR, OTHER
  status             String  @default("ACTIVE") @db.VarChar(20)
  currency           String  @default("TZS") @db.VarChar(3)
  /// Ordered array of category names controlling browse order on menus.
  categoryOrder      Json?
  /// When true, guest QR orders skip PLACED and enter the queue as CONFIRMED.
  autoAcceptQrOrders Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property      Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  menuItems     NrmsMenuItem[]
  memberships   NrmsStaffMembership[]
  orders        NrmsOutletOrder[]
  merchantLinks MerchantPropertyLink[]

  @@unique([propertyId, code])
  @@index([propertyId, type, status])
  @@map("nrms_outlet")
}

/// A user may operate only the assigned property/outlet; this never grants OWNER access.
model NrmsStaffMembership {
  id            Int       @id @default(autoincrement())
  propertyId    Int
  userId        Int
  outletId      Int?
  role          String    @db.VarChar(30) // MANAGER, FRONT_DESK, HOUSEKEEPER, RESTAURANT, BAR, OUTLET_SUPERVISOR
  status        String    @default("PENDING") @db.VarChar(20)
  inviteVersion Int       @default(0)
  confirmedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User        @relation("NrmsStaffUser", fields: [userId], references: [id], onDelete: Cascade)
  outlet   NrmsOutlet? @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@unique([propertyId, userId])
  @@index([userId, status])
  @@index([outletId, status])
  @@map("nrms_staff_membership")
}

/// A scannable point (room or table) that guests use to access the menu and
/// place orders. Each point carries a cryptographically random token embedded
/// in a QR code URL. Revoking a token deactivates the point; rotating it
/// generates a fresh token and reactivates.
model NrmsOrderPoint {
  id              Int     @id @default(autoincrement())
  propertyId      Int
  type            String  @db.VarChar(10) // ROOM, TABLE, PREVIEW
  label           String  @db.VarChar(60)
  roomUnitId      Int?
  token           String  @unique @db.VarChar(48)
  active          Boolean @default(true)
  /// False only for the one system-created PREVIEW point per property: a
  /// public, unauthenticated visitor can browse the live menu but never place
  /// an order from it. Enforced server-side in public.nrmsMenu.ts, not just
  /// hidden in the UI.
  orderingEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomUnit RoomUnit?         @relation(fields: [roomUnitId], references: [id], onDelete: SetNull)
  orders   NrmsOutletOrder[]

  @@unique([propertyId, type, label])
  @@index([propertyId, active])
  @@index([roomUnitId])
  @@map("nrms_order_point")
}

/// One unit of housekeeping work for a physical room: turnover after
/// checkout, a daily clean, a deep clean, or a maintenance note. Rows are the
/// audit of who cleaned what and when; the room's live cleanliness state is
/// RoomUnit.housekeepingStatus. Checkout auto-creates a TURNOVER task.
model NrmsHousekeepingTask {
  id            Int  @id @default(autoincrement())
  propertyId    Int
  roomUnitId    Int
  /// Stay that triggered the task (TURNOVER); null for ad-hoc tasks.
  reservationId Int?

  type        String    @db.VarChar(20) // TURNOVER, DAILY_CLEAN, DEEP_CLEAN, MAINTENANCE
  status      String    @default("OPEN") @db.VarChar(20) // OPEN, IN_PROGRESS, DONE, CANCELLED
  priority    String    @default("NORMAL") @db.VarChar(10) // NORMAL, HIGH
  note        String?   @db.VarChar(500)
  /// Local service day (stored as that day's UTC instant) for idempotent
  /// scheduled work. Null for turnover and manually created tasks.
  serviceDate DateTime?

  assignedToId  Int?
  createdById   Int?
  completedById Int?
  startedAt     DateTime?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomUnit    RoomUnit     @relation(fields: [roomUnitId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  assignedTo  User?        @relation("NrmsHkTaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("NrmsHkTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy User?        @relation("NrmsHkTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([roomUnitId, type, serviceDate], map: "uq_nrms_hk_room_type_service_date")
  @@index([propertyId, status, createdAt])
  @@index([roomUnitId, status])
  @@index([assignedToId, status])
  @@map("nrms_housekeeping_task")
}

model NrmsMenuItem {
  id       Int     @id @default(autoincrement())
  outletId Int
  name     String  @db.VarChar(160)
  category String? @db.VarChar(80)
  sku      String? @db.VarChar(50)
  price    Decimal @db.Decimal(12, 2)
  status   String  @default("ACTIVE") @db.VarChar(20)

  /// Guest-facing copy shown on the QR menu page (doc NRMS_QR_ORDERING.md m2).
  description       String? @db.VarChar(500)
  imageUrl          String? @db.VarChar(500)
  /// Daily availability toggle, independent of the lifecycle `status`.
  inStock           Boolean @default(true)
  /// Counted inventory. Null = not tracked (availability is the toggle alone).
  /// Tracked items decrement on every sale and auto-flip inStock at zero.
  stockQuantity     Int?
  /// Tracked quantity at or below this level shows as "running low".
  lowStockThreshold Int     @default(5)
  sortOrder         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet     NrmsOutlet            @relation(fields: [outletId], references: [id], onDelete: Cascade)
  orderItems NrmsOutletOrderItem[]

  @@unique([outletId, sku])
  @@index([outletId, status, category])
  @@map("nrms_menu_item")
}

/// Itemised outlet order. A room-folio order links to exactly one immutable
/// charge. reservationId is null for walk-in / non-resident sales, which can
/// only settle as direct outlet payments and carry a customerLabel instead.
model NrmsOutletOrder {
  id                    Int       @id @default(autoincrement())
  propertyId            Int
  outletId              Int
  reservationId         Int?
  /// Who the order is for when there is no reservation, e.g. "Table 4", "Walk-in".
  customerLabel         String?   @db.VarChar(120)
  /// Set when the order arrived through a QR scan (guest self-ordering).
  orderPointId          Int?
  /// Random capability code for the guest's status page. Public but unguessable.
  publicCode            String?   @unique @db.VarChar(40)
  folioChargeId         Int?      @unique
  orderNumber           String    @unique @db.VarChar(40)
  /// PLACED (guest QR order awaiting staff accept) -> CONFIRMED -> PREPARING -> ...
  status                String    @default("CONFIRMED") @db.VarChar(30)
  settlementMode        String    @default("ROOM_FOLIO") @db.VarChar(30)
  currency              String    @default("TZS") @db.VarChar(3)
  subtotal              Decimal   @db.Decimal(12, 2)
  total                 Decimal   @db.Decimal(12, 2)
  note                  String?   @db.VarChar(300)
  createdById           Int?
  confirmedById         Int?
  /// Tender used when settlementMode is OUTLET_PAYMENT.
  settlementMethod      String?   @db.VarChar(30) // CASH, MOBILE_MONEY, BANK, CARD, OTHER
  /// Payment method selected by the guest before sending a QR order.
  /// This is intent only; settlementMethod remains the attendant-confirmed tender.
  guestPaymentMethod    String?   @db.VarChar(30) // CASH, MOBILE_MONEY, BANK, CARD, OTHER
  settledById           Int?
  /// Optional post-service feedback submitted through the guest order capability.
  guestRating           Int?
  guestFeedback         String?   @db.VarChar(500)
  tipIntent             String?   @db.VarChar(20) // NONE, INTERESTED
  tipSuggestedAmount    Decimal?  @db.Decimal(12, 2)
  feedbackAt            DateTime?
  /// Actual collection is separate from guest intent: overpayment may be change.
  paymentAmountReceived Decimal?  @db.Decimal(12, 2)
  tipAmount             Decimal?  @db.Decimal(12, 2)
  tipRecipientId        Int?
  tipConfirmedById      Int?
  tipMethod             String?   @db.VarChar(30)
  tipConfirmedAt        DateTime?

  placedAt    DateTime?
  confirmedAt DateTime?
  preparingAt DateTime?
  /// When an attendant leaves the outlet to deliver/serve the prepared order.
  servingAt   DateTime?
  servedAt    DateTime?
  postedAt    DateTime?
  settledAt   DateTime?
  cancelledAt DateTime?
  voidedAt    DateTime?
  voidReason  String?   @db.VarChar(300)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  property       Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  outlet         NrmsOutlet            @relation(fields: [outletId], references: [id], onDelete: Restrict)
  reservation    Reservation?          @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  orderPoint     NrmsOrderPoint?       @relation(fields: [orderPointId], references: [id], onDelete: SetNull)
  folioCharge    ReservationCharge?    @relation("NrmsOrderFolioCharge", fields: [folioChargeId], references: [id], onDelete: SetNull)
  createdBy      User?                 @relation("NrmsOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedBy    User?                 @relation("NrmsOrderConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  settledBy      User?                 @relation("NrmsOrderSettledBy", fields: [settledById], references: [id], onDelete: SetNull)
  tipRecipient   User?                 @relation("NrmsOrderTipRecipient", fields: [tipRecipientId], references: [id], onDelete: SetNull)
  tipConfirmedBy User?                 @relation("NrmsOrderTipConfirmedBy", fields: [tipConfirmedById], references: [id], onDelete: SetNull)
  items          NrmsOutletOrderItem[]

  @@index([propertyId, status, createdAt])
  @@index([outletId, status, createdAt])
  @@index([reservationId, createdAt])
  @@index([orderPointId, status])
  @@index([settledById])
  @@index([tipRecipientId])
  @@index([tipConfirmedById])
  @@map("nrms_outlet_order")
}

/// One controlled operating date per property. A CLOSED date is immutable.
model NrmsBusinessDay {
  id           Int       @id @default(autoincrement())
  propertyId   Int
  businessDate DateTime  @db.Date
  status       String    @default("OPEN") @db.VarChar(20) // OPEN, CLOSING, CLOSED
  openedById   Int?
  closedById   Int?
  openedAt     DateTime  @default(now())
  closedAt     DateTime?

  property      Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  openedBy      User?                   @relation("NrmsBusinessDayOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  closedBy      User?                   @relation("NrmsBusinessDayClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  nightAudits   NrmsNightAuditRun[]
  cashierShifts NrmsCashierShift[]
  transactions  NrmsLedgerTransaction[]

  @@unique([propertyId, businessDate])
  @@index([propertyId, status, businessDate])
  @@map("nrms_business_day")
}

/// Immutable record of each attempted and completed Night Audit.
model NrmsNightAuditRun {
  id            Int       @id @default(autoincrement())
  propertyId    Int
  businessDayId Int
  status        String    @default("DRAFT") @db.VarChar(20) // DRAFT, BLOCKED, CLOSED, FAILED
  reportNumber  String    @unique @db.VarChar(48)
  blockers      Json?
  warnings      Json?
  summary       Json?
  startedById   Int?
  closedById    Int?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  property     Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  businessDay  NrmsBusinessDay         @relation(fields: [businessDayId], references: [id], onDelete: Restrict)
  startedBy    User?                   @relation("NrmsNightAuditStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  closedBy     User?                   @relation("NrmsNightAuditClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  transactions NrmsLedgerTransaction[]

  @@index([propertyId, startedAt])
  @@index([businessDayId, status])
  @@map("nrms_night_audit_run")
}

/// Cash accountability for one operator and business date.
model NrmsCashierShift {
  id                 Int       @id @default(autoincrement())
  propertyId         Int
  businessDayId      Int
  userId             Int
  businessDate       DateTime  @db.Date
  currency           String    @default("TZS") @db.VarChar(3)
  status             String    @default("OPEN") @db.VarChar(20) // OPEN, CLOSED
  openingFloat       Decimal   @default(0.00) @db.Decimal(12, 2)
  expectedCash       Decimal   @default(0.00) @db.Decimal(12, 2)
  declaredCash       Decimal?  @db.Decimal(12, 2)
  variance           Decimal?  @db.Decimal(12, 2)
  closeNote          String?   @db.VarChar(300)
  approvedById       Int?
  /// Server-computed classification frozen at close: sales by tender, folio
  /// postings and unpaid orders as the attendee reviewed them before handover.
  closeSummary       Json?
  /// Set when this shift was opened by confirming a drawer handover. Unique so a
  /// closed drawer can be taken over by exactly one successor.
  handoverFromId     Int?      @unique
  openedAt           DateTime  @default(now())
  closedAt           DateTime?
  /// Owner/manager acknowledgment that this closed shift's sales are authentic.
  /// Distinct from approvedById, which is just whoever closed the shift.
  ownerSignedOffAt   DateTime?
  ownerSignedOffById Int?

  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  businessDay      NrmsBusinessDay   @relation(fields: [businessDayId], references: [id], onDelete: Restrict)
  user             User              @relation("NrmsCashierShiftUser", fields: [userId], references: [id], onDelete: Restrict)
  approvedBy       User?             @relation("NrmsCashierShiftApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  ownerSignedOffBy User?             @relation("NrmsCashierShiftSignedOffBy", fields: [ownerSignedOffById], references: [id], onDelete: SetNull)
  handoverFrom     NrmsCashierShift? @relation("NrmsShiftHandover", fields: [handoverFromId], references: [id], onDelete: SetNull)
  handoverTo       NrmsCashierShift? @relation("NrmsShiftHandover")

  @@index([propertyId, businessDate, status])
  @@index([userId, openedAt])
  @@map("nrms_cashier_shift")
}

/// Header for an immutable double-entry accounting event.
model NrmsLedgerTransaction {
  id                Int      @id @default(autoincrement())
  propertyId        Int
  businessDayId     Int
  nightAuditRunId   Int?
  transactionNumber String   @unique @db.VarChar(48)
  sourceKey         String   @unique @db.VarChar(100)
  sourceType        String   @db.VarChar(30)
  sourceId          Int?
  description       String   @db.VarChar(300)
  currency          String   @default("TZS") @db.VarChar(3)
  occurredAt        DateTime
  createdAt         DateTime @default(now())

  property      Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  businessDay   NrmsBusinessDay    @relation(fields: [businessDayId], references: [id], onDelete: Restrict)
  nightAuditRun NrmsNightAuditRun? @relation(fields: [nightAuditRunId], references: [id], onDelete: SetNull)
  entries       NrmsLedgerEntry[]

  @@index([propertyId, occurredAt])
  @@index([businessDayId, sourceType])
  @@map("nrms_ledger_transaction")
}

model NrmsLedgerEntry {
  id            Int     @id @default(autoincrement())
  transactionId Int
  accountCode   String  @db.VarChar(20)
  accountName   String  @db.VarChar(100)
  accountType   String  @db.VarChar(20) // ASSET, LIABILITY, REVENUE, EXPENSE, EQUITY
  debit         Decimal @default(0.00) @db.Decimal(12, 2)
  credit        Decimal @default(0.00) @db.Decimal(12, 2)
  description   String? @db.VarChar(300)

  transaction NrmsLedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([accountCode, transactionId])
  @@map("nrms_ledger_entry")
}

/// Owner-activated TRA fiscal receipting (VFD). No row means the property has
/// never touched the feature, which is every property today and the majority of
/// them permanently: most guesthouses are below the VAT threshold and are not
/// required to fiscalise at all. See docs/NRMS_FISCAL_RECEIPTS.md.
///
/// NoLSAF is not the taxpayer here. The property registers with TRA under its own
/// TIN and VRN, and NRMS transmits on that registration.
model NrmsFiscalConnection {
  id                  Int     @id @default(autoincrement())
  propertyId          Int     @unique
  regime              String  @default("TZ_TRA") @db.VarChar(20)
  mode                String  @default("OFF") @db.VarChar(20) // OFF, ON_REQUEST, ALWAYS
  pendingMode         String? @db.VarChar(20)
  status              String  @default("DISABLED") @db.VarChar(20) // DISABLED, PENDING, VALIDATED, ACTIVE, FAILED, SUSPENDED
  suspendedFromStatus String? @db.VarChar(20)

  /// Taxpayer identity. Not secret: it is printed on every receipt.
  tin          String? @db.VarChar(20)
  vrn          String? @db.VarChar(20)
  businessName String? @db.VarChar(180)
  taxOffice    String? @db.VarChar(120)

  /// Issued by TRA at registration and required on every document afterwards.
  regId        String? @db.VarChar(60)
  receiptCode  String? @db.VarChar(40)
  serialNumber String? @db.VarChar(60)

  /// Counters TRA validates, which we generate rather than receive. Global starts
  /// at 1, never resets, and always equals the receipt number. Daily resets at
  /// CALENDAR midnight, deliberately NOT at business-day close: a sale rung at
  /// 01:30 belongs to yesterday's business day and to today's fiscal day.
  globalCounter    Int       @default(0)
  dailyCounter     Int       @default(0)
  dailyCounterDate DateTime? @db.Date
  lastZReportDate  DateTime? @db.Date

  /// Switching on or off lands on a business-day boundary so no day ever closes
  /// half fiscalised. Stored as the business date rather than a day id so the
  /// intent survives a business-day row being reopened or recreated.
  activatesOnBusinessDate   DateTime? @db.Date
  deactivatesOnBusinessDate DateTime? @db.Date

  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastError     String?   @db.VarChar(1000)
  /// Set when a failure first survives a cashier-shift boundary. Drives the
  /// undismissable banner; cleared on the next success.
  escalatedAt   DateTime?

  /// The owner accepts in writing that they are the taxpayer of record and NoLSAF
  /// is only transmitting. Not skippable.
  acknowledgedAt         DateTime?
  acknowledgedById       Int?
  acknowledgementVersion String?   @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property           Property                      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  acknowledgedBy     User?                         @relation("NrmsFiscalAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  credentialVersions NrmsFiscalCredentialVersion[]
  receipts           NrmsFiscalReceipt[]

  @@index([status, mode])
  @@map("nrms_fiscal_connection")
}

/// Versioned, encrypted TRA credentials. Same staging/activation shape as
/// ChannelCredentialVersion so rotation works the same way it already does for
/// channels. Secrets are never returned by any endpoint, owner or admin.
model NrmsFiscalCredentialVersion {
  id           Int    @id @default(autoincrement())
  connectionId Int
  version      Int
  status       String @default("STAGED") @db.VarChar(20) // STAGED, ACTIVE, REVOKED

  /// AES-256-GCM (lib/crypto.ts) over JSON holding the token-grant username and
  /// password AND the PKCS12 bundle plus its passphrase: every document is signed
  /// with that private key, so the certificate is a credential, not a setting.
  encryptedData String @db.Text

  validationStatus String    @default("UNTESTED") @db.VarChar(20) // UNTESTED, VALIDATED, FAILED
  validatedAt      DateTime?
  validationError  String?   @db.VarChar(500)
  /// Signing certificate expiry, so the health strip warns before it lapses
  /// rather than after receipts start failing.
  expiresAt        DateTime?
  activatedAt      DateTime?
  revokedAt        DateTime?
  createdById      Int?
  createdAt        DateTime  @default(now())

  connection NrmsFiscalConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  createdBy  User?                @relation("NrmsFiscalCredentialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([connectionId, version])
  @@index([connectionId, status])
  @@map("nrms_fiscal_credential_version")
}

/// One fiscalisation attempt and its outcome. Created at settle, delivered by a
/// worker, because a guest at the counter cannot wait for night audit.
///
/// A row is never deleted and its counters are never re-issued. A settlement that
/// fails after allocation leaves a BURNED row, which is what makes the burn
/// auditable instead of invisible.
model NrmsFiscalReceipt {
  id           Int @id @default(autoincrement())
  propertyId   Int
  connectionId Int

  /// Shared identity with the night-audit ledger posting for the same money
  /// movement, e.g. "PAYMENT:12:3391" or "OUTLET:12:8842". Lets the two systems
  /// be reconciled without either one knowing about the other.
  sourceKey  String @db.VarChar(100)
  sourceType String @db.VarChar(40)
  sourceId   Int?

  kind          String @default("RECEIPT") @db.VarChar(20) // RECEIPT, CREDIT_NOTE
  status        String @default("PENDING") @db.VarChar(20) // PENDING, SENDING, CONFIRMED, FAILED, DEAD_LETTER, BURNED
  /// Stable across retries. The TRA adapter must use this as the provider-side
  /// idempotency/reconciliation key so a crash after submission cannot duplicate
  /// a fiscal document.
  submissionKey String @unique @default(uuid()) @db.VarChar(36)

  /// Allocated inside the committing transaction. receiptNumber == globalCounter
  /// by TRA's rule; both are kept because the document carries them separately.
  receiptNumber Int
  globalCounter Int
  dailyCounter  Int
  /// Calendar day the counters belong to. NOT the business date.
  fiscalDate    DateTime @db.Date

  /// When the money actually moved, which is not the issue date when a guest
  /// comes back on Wednesday for Monday's receipt.
  saleOccurredAt DateTime
  /// When TRA confirmed it.
  issuedAt       DateTime?

  currency     String  @default("TZS") @db.VarChar(3)
  grossAmount  Decimal @db.Decimal(12, 2)
  taxAmount    Decimal @default(0.00) @db.Decimal(12, 2)
  taxBreakdown Json?
  /// The document we built, secrets and signature excluded.
  payload      Json?

  /// Returned by TRA. verificationUrl is what the printed QR encodes; we generate
  /// that QR ourselves, TRA does not supply an image.
  fiscalReceiptNumber String? @db.VarChar(60)
  verificationCode    String? @db.VarChar(80)
  verificationUrl     String? @db.VarChar(500)
  signature           String? @db.Text
  /// Digest only. Raw provider payloads are not retained, matching the decision
  /// already taken for channel reservations.
  responseDigest      String? @db.VarChar(64)

  attemptCount           Int       @default(0)
  nextAttemptAt          DateTime?
  lastAttemptAt          DateTime?
  lastError              String?   @db.VarChar(1000)
  deliveryLeaseToken     String?   @db.VarChar(36)
  deliveryLeaseExpiresAt DateTime?
  burnReason             String?   @db.VarChar(300)

  replacesReceiptId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property   Property             @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  connection NrmsFiscalConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  replaces   NrmsFiscalReceipt?   @relation("NrmsFiscalReceiptReplaces", fields: [replacesReceiptId], references: [id], onDelete: SetNull)
  replacedBy NrmsFiscalReceipt[]  @relation("NrmsFiscalReceiptReplaces")

  /// One fiscal document per money movement, enforced by the database rather
  /// than by remembering to check.
  @@unique([propertyId, sourceKey, kind])
  /// The counter series cannot fork, even under concurrent settlements.
  @@unique([connectionId, globalCounter])
  @@index([connectionId, status, nextAttemptAt])
  @@index([status, deliveryLeaseExpiresAt])
  @@index([propertyId, fiscalDate])
  @@index([replacesReceiptId])
  @@map("nrms_fiscal_receipt")
}

model NrmsOutletOrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int
  menuItemId   Int?
  nameSnapshot String   @db.VarChar(160)
  quantity     Int
  unitPrice    Decimal  @db.Decimal(12, 2)
  lineTotal    Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  order    NrmsOutletOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem NrmsMenuItem?   @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([menuItemId])
  @@map("nrms_outlet_order_item")
}

/// Immutable, effective-dated NRMS charging policy. A new price creates a new
/// row/version; historical usage always points to the policy that priced it.
model NrmsUsageChargePolicy {
  id             Int       @id @default(autoincrement())
  version        String    @unique @db.VarChar(60)
  status         String    @default("ACTIVE") @db.VarChar(20)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  currency       String    @default("TZS") @db.VarChar(3)
  roomNightPrice Decimal   @db.Decimal(12, 2)
  trialDays      Int       @default(45)
  reminderAmount Decimal   @default(25000.00) @db.Decimal(12, 2)
  warningAmount  Decimal   @default(40000.00) @db.Decimal(12, 2)
  unpaidLimit    Decimal   @default(50000.00) @db.Decimal(12, 2)
  graceDays      Int       @default(3)
  createdAt      DateTime  @default(now())

  accounts OwnerPaygAccount[]
  events   NrmsUsageEvent[]

  @@index([status, effectiveFrom])
  @@map("nrms_usage_charge_policy")
}

/// Property-level trial, PAYG balance and service state. Enrollment grants the
/// product; this account governs one property's operational/billing access.
model OwnerPaygAccount {
  id                         Int       @id @default(autoincrement())
  propertyId                 Int       @unique
  ownerId                    Int
  policyId                   Int
  status                     String    @default("TRIAL") @db.VarChar(30) // TRIAL, ACTIVE, WARNING, PAYMENT_REQUIRED, PAYMENT_PENDING, FROZEN, CLOSED
  trialStartsAt              DateTime
  trialEndsAt                DateTime
  unpaidBalance              Decimal   @default(0.00) @db.Decimal(12, 2)
  unpaidLimit                Decimal   @default(50000.00) @db.Decimal(12, 2)
  maxStaff                   Int       @default(100)
  maxOutlets                 Int       @default(50)
  maxMenuItems               Int       @default(500)
  maxOrderPoints             Int       @default(1000)
  maxRooms                   Int       @default(500)
  /// Max approved travel agents (active NrmsAgentPropertyLink rows) for this
  /// property. Admin-controlled upsell lever: hotels contact NoLSAF to raise it.
  maxAgents                  Int       @default(5)
  limitReachedAt             DateTime?
  reminderNotifiedAt         DateTime?
  warningNotifiedAt          DateTime?
  freezeNotifiedAt           DateTime?
  /// Temporary admin freeze state. The prior billing state is retained so an
  /// unfreeze cannot accidentally reactivate a delinquent account.
  freezePreviousStatus       String?   @db.VarChar(30)
  frozenAt                   DateTime?
  frozenByAdminId            Int?
  frozenReason               String?   @db.VarChar(300)
  retentionClosedAt          DateTime?
  guestDataAnonymizedAt      DateTime?
  operationalDataMinimizedAt DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  property   Property               @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  owner      User                   @relation("NrmsPaygAccountOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  policy     NrmsUsageChargePolicy  @relation(fields: [policyId], references: [id], onDelete: Restrict)
  events     NrmsUsageEvent[]
  statements NrmsBillingStatement[]

  @@index([ownerId, status])
  @@index([status, unpaidBalance])
  @@map("owner_payg_account")
}

/// One immutable classification/charge per room allocation and service date.
model NrmsUsageEvent {
  id             Int      @id @default(autoincrement())
  accountId      Int
  propertyId     Int
  reservationId  Int?
  allocationId   Int?
  policyId       Int
  serviceDate    DateTime @db.Date
  classification String   @db.VarChar(30) // BILLABLE_EXTERNAL, BILLABLE_AGENT, TRIAL_FREE, COMMISSION_ONLY, REVERSAL
  source         String   @db.VarChar(20)
  currency       String   @default("TZS") @db.VarChar(3)
  amount         Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  account       OwnerPaygAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  property      Property                   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reservation   Reservation?               @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  allocation    ReservationRoomAllocation? @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  policy        NrmsUsageChargePolicy      @relation(fields: [policyId], references: [id], onDelete: Restrict)
  statementItem NrmsBillingStatementItem?

  @@unique([allocationId, serviceDate, policyId])
  @@index([accountId, createdAt])
  @@index([propertyId, serviceDate])
  @@map("nrms_usage_event")
}

model NrmsBillingStatement {
  id        Int       @id @default(autoincrement())
  accountId Int
  status    String    @default("PAYABLE") @db.VarChar(20)
  currency  String    @default("TZS") @db.VarChar(3)
  amount    Decimal   @db.Decimal(12, 2)
