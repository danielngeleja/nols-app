  metricDate DateTime @db.Date
  kind       String   @db.VarChar(40)
  count      Int      @default(0)
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, metricDate, kind])
  @@index([metricDate, kind])
  @@map("nrms_public_metric")
}

/// Last known state of each NRMS worker. This is deliberately persistent so
