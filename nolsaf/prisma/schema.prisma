// =========================================================
//  SALES PARTNER WORKSPACE
//  Entitlement-based workspace for sales partners who onboard properties
//  onto NRMS and the NoLSAF marketplace. Sales partners are ordinary NoLSAF
//  users. No new primary role is introduced: access is granted through
//  UserWorkspaceAccess and gated by an active contract.
//
//  Not to be confused with the Agent model above, which represents tour
//  operators (User.role = 'AGENT').
// =========================================================

/// Grants a registered user access to an additional workspace alias.
/// workspace: NORMAL, SALES, ACCOMMODATION. ACCOMMODATION is an additive
/// capability used by established operators/agents; it never replaces User.role.
/// status: PENDING, ACTIVE, SUSPENDED, EXPIRED, REVOKED
model UserWorkspaceAccess {
  id        Int    @id @default(autoincrement())
  userId    Int
  workspace String @db.VarChar(20)
  status    String @default("PENDING") @db.VarChar(20)

  grantedById Int?
  grantedAt   DateTime?
  suspendedAt DateTime?
  /// Mirrors the contract expiry so entitlement checks stay cheap. The
  /// contract itself remains authoritative.
  expiresAt   DateTime?

  revokedAt    DateTime?
  revokedById  Int?
  statusReason String?   @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User  @relation("WorkspaceUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("WorkspaceGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy User? @relation("WorkspaceRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([userId, workspace])
  @@index([workspace, status])
  @@index([status, expiresAt])
  @@map("user_workspace_access")
}

/// One-to-one sales identity attached to an existing User.
/// status: PENDING, ACTIVE, SUSPENDED, EXPIRED, TERMINATED
/// level: STARTER, GROWTH, PROFESSIONAL, SENIOR, REGIONAL_LEAD
model SalesPartnerProfile {
  id     Int @id @default(autoincrement())
  userId Int @unique

  /// Server-generated business identifier, for example NSA-DAR-0042
  agentCode String @unique @db.VarChar(30)
  status    String @default("PENDING") @db.VarChar(20)
  level     String @default("STARTER") @db.VarChar(30)

  region    String? @db.VarChar(120)
  territory String? @db.VarChar(200)
  phone     String? @db.VarChar(40)

  /// Payout destination. The account number is stored in full and masked at
  /// the API boundary. It is never returned to anyone but the partner.
  payoutName    String? @db.VarChar(160)
  payoutMethod  String? @db.VarChar(40)
  payoutAccount String? @db.VarChar(80)

  activatedAt  DateTime?
  suspendedAt  DateTime?
  terminatedAt DateTime?

  /// Set by the level recalculation job so promotions stay traceable.
  levelUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                       @relation("SalesPartnerUser", fields: [userId], references: [id], onDelete: Cascade)
  contracts      SalesPartnerContract[]
  leads          SalesLead[]
  attributions   PropertySalesAttribution[]
  commissions    SalesCommission[]
  payoutRequests SalesPayoutRequest[]

  @@index([status])
  @@index([level])
  @@index([region])
  @@map("sales_partner_profile")
}

/// Digital contract governing a partner's commission rates and access window.
/// status: DRAFT, SENT, VIEWED, SIGNED, ACTIVE, EXPIRING, EXPIRED, TERMINATED, RENEWED
model SalesPartnerContract {
  id             Int    @id @default(autoincrement())
  salesPartnerId Int
  contractNumber String @unique @db.VarChar(40)
  status         String @default("DRAFT") @db.VarChar(20)

  startsAt  DateTime
  expiresAt DateTime

  /// Rates are read from the contract at commission time and snapshotted onto
  /// each SalesCommission row. Never hard-code these in calculation code.
  nrmsCommissionRate     Decimal @db.Decimal(5, 2)
  marketplaceRevenueRate Decimal @db.Decimal(5, 2)

  territory       String? @db.VarChar(200)
  contractFileUrl String? @db.VarChar(500)
  contractVersion String? @db.VarChar(20)

  /// Exact partner-signed rendering and values. These are written once at
  /// acceptance, then finalized only by the NoLSAF countersignature during
  /// activation. Downloads never rebuild an executed agreement from mutable
  /// profile data.
  renderedContractBody  String? @db.LongText
  renderedFieldSnapshot Json?
  acceptedTermsHash     String? @db.VarChar(64)
  renderedBodyHash      String? @db.VarChar(64)
  pdfSha256             String? @db.VarChar(64)

  sentAt       DateTime?
  viewedAt     DateTime?
  signedAt     DateTime?
  activatedAt  DateTime?
  terminatedAt DateTime?

  /// Login-bound agreement invitation. Only the SHA-256 digest is stored;
  /// the raw token exists only in the delivery link. The token opens the
  /// authenticated contract flow but never authorizes acceptance by itself.
  invitationTokenHash String?   @unique @db.VarChar(64)
  invitationSentAt    DateTime?
  invitationExpiresAt DateTime?
  invitationUsedAt    DateTime?

  /// Evidence of digital acceptance. acceptanceHash is a SHA-256 over the
  /// acceptedTermsHash plus canonical acceptance metadata, so the accepted
  /// terms and signer evidence cannot be altered independently after signing.
  acceptedIpAddress String? @db.VarChar(64)
  acceptedUserAgent String? @db.VarChar(255)
  acceptanceHash    String? @db.VarChar(128)
  acceptedName      String? @db.VarChar(160)

  /// Expiry reminder bookkeeping so the scheduled job stays idempotent.
  reminder60SentAt DateTime?
  reminder30SentAt DateTime?
  reminder7SentAt  DateTime?

  /// Set when this contract was superseded by a renewal.
  renewedByContractId Int?
  terminationReason   String? @db.VarChar(300)

  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salesPartner SalesPartnerProfile        @relation(fields: [salesPartnerId], references: [id], onDelete: Cascade)
  createdBy    User                       @relation("SalesContractCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  attributions PropertySalesAttribution[]
  commissions  SalesCommission[]

  @@index([salesPartnerId, status])
  @@index([expiresAt])
  @@index([status, expiresAt])
  @@index([invitationExpiresAt])
  @@map("sales_partner_contract")
}

/// A prospective property a partner is working, registered before onboarding
/// so first contact is recorded and the claim is protected.
/// status: NEW, CONTACTED, MEETING_SCHEDULED, PROPOSAL_SENT, DOCUMENTS_PENDING,
///         TRIAL_STARTED, CONVERSION_REQUESTED, CONVERTED, LOST, CANCELLED
/// proposedProduct: NRMS, MARKETPLACE, NRMS_AND_MARKETPLACE
model SalesLead {
  id             Int @id @default(autoincrement())
  salesPartnerId Int

  propertyName                 String  @db.VarChar(200)
  /// Canonical matching fields are written by the API. They make duplicate
  /// checks indexed and deterministic without changing the partner's display
  /// spelling or formatting.
  propertyNameNormalized       String  @db.VarChar(200)
  contactPerson                String? @db.VarChar(160)
  contactPhone                 String? @db.VarChar(40)
  contactPhoneNormalized       String? @db.VarChar(40)
  contactEmail                 String? @db.VarChar(190)
  contactEmailNormalized       String? @db.VarChar(190)
  location                     String? @db.VarChar(200)
  locationNormalized           String? @db.VarChar(200)
  region                       String? @db.VarChar(120)
  district                     String? @db.VarChar(120)
  ward                         String? @db.VarChar(120)
  propertyType                 String? @db.VarChar(60)
  estimatedRooms               Int?
  registrationNumber           String? @db.VarChar(80)
  registrationNumberNormalized String? @db.VarChar(80)
  taxNumber                    String? @db.VarChar(80)
  taxNumberNormalized          String? @db.VarChar(80)

  proposedProduct       String @db.VarChar(30)
  status                String @default("NEW") @db.VarChar(30)
  /// CLEAR or POSSIBLE_DUPLICATE. An admin decision can later move this to
  /// REVIEWED_CLEAR or REVIEWED_MATCH without deleting either partner's lead.
  duplicateReviewStatus String @default("CLEAR") @db.VarChar(30)
  /// Internal candidate ids and matched fields. Partner responses expose only
  /// a generic warning so another partner's prospect data never leaks.
  duplicateEvidence     Json?

  nextFollowUpAt DateTime?
  notes          String?   @db.Text
  lostReason     String?   @db.VarChar(300)

  /// Claim protection window. While it is open, no other partner may register
  /// the same property without admin review.
  protectionStartsAt  DateTime  @default(now())
  protectionExpiresAt DateTime?

  /// Raised by the partner, cleared by an admin. Partners never verify their
  /// own conversion.
  conversionRequestedAt DateTime?
  convertedPropertyId   Int?
  convertedAt           DateTime?
  convertedById         Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesPartner      SalesPartnerProfile        @relation(fields: [salesPartnerId], references: [id], onDelete: Cascade)
  convertedProperty Property?                  @relation("SalesLeadConvertedProperty", fields: [convertedPropertyId], references: [id], onDelete: SetNull)
  convertedBy       User?                      @relation("SalesLeadConvertedBy", fields: [convertedById], references: [id], onDelete: SetNull)
  activities        SalesLeadActivity[]
  attributions      PropertySalesAttribution[]

  @@index([salesPartnerId, status])
  @@index([status, nextFollowUpAt])
  @@index([contactPhoneNormalized])
  @@index([contactEmailNormalized])
  @@index([propertyNameNormalized])
  @@index([registrationNumberNormalized])
  @@index([taxNumberNormalized])
  @@index([protectionExpiresAt])
  @@map("sales_lead")
}

/// Append-only timeline entry on a lead.
/// type: NOTE, CALL, EMAIL, MEETING, FOLLOW_UP, DOCUMENT_RECEIVED,
///       PROPOSAL_SENT, STATUS_CHANGED, ADMIN_COMMENT
model SalesLeadActivity {
  id          Int      @id @default(autoincrement())
  leadId      Int
  createdById Int
  type        String   @db.VarChar(30)
  description String   @db.Text
  /// Optional supporting document uploaded alongside the activity.
  fileUrl     String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  lead      SalesLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User      @relation("SalesLeadActivityAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@map("sales_lead_activity")
}

/// Binds a property and one product line to the partner who onboarded it.
/// The unique constraint on (propertyId, productType) is what prevents two
/// partners from earning on the same property and product at the same time.
/// status: PENDING, VERIFIED, ACTIVE, DISPUTED, REASSIGNED, EXPIRED, REVOKED
/// productType: NRMS, MARKETPLACE
model PropertySalesAttribution {
  id             Int  @id @default(autoincrement())
  propertyId     Int
  salesPartnerId Int
  leadId         Int?
  contractId     Int?

  productType String @db.VarChar(20)
  status      String @default("PENDING") @db.VarChar(20)

  attributedAt DateTime  @default(now())
  verifiedAt   DateTime?
  verifiedById Int?

  /// Commission accrual window. commissionEndsAt is set when the attribution
  /// is revoked or reassigned, or when the governing contract lapses without
  /// renewal.
  commissionStartsAt DateTime?
  commissionEndsAt   DateTime?

  /// Populated when an admin moves the property to a different partner. The
  /// unique property/product row is updated in place; immutable before/after
  /// ownership evidence is retained in AuditLog.
  reassignedAt          DateTime?
  reassignedToPartnerId Int?
  revokedAt             DateTime?
  disputeReason         String?   @db.VarChar(300)
  notes                 String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property     Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  salesPartner SalesPartnerProfile   @relation(fields: [salesPartnerId], references: [id], onDelete: Restrict)
  lead         SalesLead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contract     SalesPartnerContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  verifiedBy   User?                 @relation("SalesAttributionVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  commissions  SalesCommission[]

  @@unique([propertyId, productType])
  @@index([salesPartnerId, status])
  @@index([status, productType])
  @@map("property_sales_attribution")
}

/// Immutable earnings ledger. One row per revenue event, written only when
/// money has actually been collected by NoLSAF. Balances are always derived
/// from these rows and are never stored on the partner profile.
///
/// type: NRMS_USAGE, MARKETPLACE_BOOKING, PERFORMANCE_BONUS, MANUAL_ADJUSTMENT
/// status: PENDING, VALIDATING, ELIGIBLE, APPROVED, AVAILABLE, PAID,
///         REVERSED, DISPUTED, CANCELLED
model SalesCommission {
  id             Int  @id @default(autoincrement())
  salesPartnerId Int
  propertyId     Int?
  attributionId  Int?
  contractId     Int

  type   String @db.VarChar(30)
  status String @default("PENDING") @db.VarChar(20)

  /// Deterministic idempotency key derived from the source event, for example
  /// "NRMS_STATEMENT:412" or "INVOICE:9033". The unique index on this column
  /// is what turns a replayed payment webhook into a no-op instead of a
  /// double payout.
  sourceKey String @unique @db.VarChar(120)

  /// Source pointers, kept as plain columns rather than foreign keys so the
  /// ledger does not have to add relation fields to Invoice, Booking and
  /// NrmsBillingStatement. Those rows are never hard-deleted.
  sourceStatementId Int?
  sourceInvoiceId   Int?
  sourceBookingId   Int?

  /// Revenue basis, all in `currency`. eligibleNetRevenue is the figure the
  /// rate is applied to, and every deduction that produced it is stored so the
  /// partner can be shown the full arithmetic.
  grossAmount         Decimal @db.Decimal(12, 2)
  taxAmount           Decimal @default(0.00) @db.Decimal(12, 2)
  processingFeeAmount Decimal @default(0.00) @db.Decimal(12, 2)
  refundAmount        Decimal @default(0.00) @db.Decimal(12, 2)
  discountAmount      Decimal @default(0.00) @db.Decimal(12, 2)
  eligibleNetRevenue  Decimal @db.Decimal(12, 2)

  /// Snapshot of the contract rate at the moment of accrual, so a later
  /// renegotiation can never rewrite history.
  commissionRate   Decimal @db.Decimal(5, 2)
  commissionAmount Decimal @db.Decimal(12, 2)

  currency    String  @default("TZS") @db.VarChar(3)
  description String? @db.VarChar(300)

  earnedAt    DateTime
  eligibleAt  DateTime?
  approvedAt  DateTime?
  availableAt DateTime?
  paidAt      DateTime?
  reversedAt  DateTime?

  /// Set when a refund, cancellation or chargeback claws an earning back. The
  /// original row is never edited: it moves to REVERSED and a linked negative
  /// row records the offset.
  reversalOfId     Int?
  reversalReason   String? @db.VarChar(300)
  adjustmentReason String? @db.VarChar(300)

  approvedById Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salesPartner SalesPartnerProfile       @relation(fields: [salesPartnerId], references: [id], onDelete: Restrict)
  property     Property?                 @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  attribution  PropertySalesAttribution? @relation(fields: [attributionId], references: [id], onDelete: SetNull)
  contract     SalesPartnerContract      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  approvedBy   User?                     @relation("SalesCommissionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  payoutItem   SalesPayoutItem?

  @@index([salesPartnerId, status])
  @@index([salesPartnerId, earnedAt])
  @@index([propertyId, type])
  @@index([status, availableAt])
  @@index([sourceStatementId])
  @@index([sourceInvoiceId])
  @@map("sales_commission")
}

/// Partner-initiated withdrawal of AVAILABLE commissions.
/// status: DRAFT, REQUESTED, UNDER_REVIEW, APPROVED, PROCESSING, PAID,
///         REJECTED, CANCELLED, FAILED
model SalesPayoutRequest {
  id              Int    @id @default(autoincrement())
  salesPartnerId  Int
  referenceNumber String @unique @db.VarChar(40)

  requestedAmount Decimal  @db.Decimal(12, 2)
  approvedAmount  Decimal? @db.Decimal(12, 2)
  deductionAmount Decimal  @default(0.00) @db.Decimal(12, 2)
  netPaidAmount   Decimal? @db.Decimal(12, 2)

  currency String @default("TZS") @db.VarChar(3)
  status   String @default("REQUESTED") @db.VarChar(20)

  /// Payout destination snapshot taken at request time, so editing the profile
  /// later cannot redirect an in-flight payout.
  payoutMethod  String @db.VarChar(40)
  payoutName    String @db.VarChar(160)
  payoutAccount String @db.VarChar(80)

  requestedAt DateTime  @default(now())
  reviewedAt  DateTime?
  approvedAt  DateTime?
  processedAt DateTime?
  paidAt      DateTime?
  rejectedAt  DateTime?
  cancelledAt DateTime?

  reviewedById     Int?
  rejectionReason  String? @db.VarChar(300)
  paymentReference String? @db.VarChar(120)
  receiptUrl       String? @db.VarChar(500)
  adminNotes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesPartner SalesPartnerProfile @relation(fields: [salesPartnerId], references: [id], onDelete: Restrict)
  reviewedBy   User?               @relation("SalesPayoutReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  items        SalesPayoutItem[]

  @@index([salesPartnerId, status])
  @@index([status, requestedAt])
  @@map("sales_payout_request")
}

/// Locks one commission to one payout request. The unique constraint on
/// commissionId is the database-level guarantee that an earning can never be
/// claimed by two payouts.
model SalesPayoutItem {
  id           Int      @id @default(autoincrement())
  payoutId     Int
  commissionId Int      @unique
  amount       Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  payout     SalesPayoutRequest @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  commission SalesCommission    @relation(fields: [commissionId], references: [id], onDelete: Restrict)

  @@index([payoutId])
  @@map("sales_payout_item")
}

/// Admin-managed sales enablement library shown inside the partner workspace.
model SalesMaterial {
  id          Int     @id @default(autoincrement())
  title       String  @db.VarChar(200)
  description String? @db.Text
  category    String  @db.VarChar(60)
  fileUrl     String? @db.VarChar(500)
  externalUrl String? @db.VarChar(500)
  isPublished Boolean @default(false)
  sortOrder   Int     @default(0)

  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("SalesMaterialCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([category, isPublished, sortOrder])
  @@map("sales_material")
}

// Levels are not a table. They live in apps/api/src/lib/salesPartnerLevel.ts
// as a single-source-of-truth spec constant, following the existing
// agentLevel.ts pattern. See docs/SALES_PARTNER_WORKSPACE.md section 5.2.

// ─────────────────────────────────────────────────────────────────────────
// DRAFT — AzamPay disbursement models. Written for review only.
// NOT migrated, NOT applied to any database. Do not run `prisma migrate`
// or `prisma db push` against this block without Daniel's explicit
// approval, per the standing "no unapproved migrations" rule.
//
// Design intent: one generic payout engine shared by all four money-out
// flows (owner/operator, tours, drivers, sales partners) instead of a
// fifth bespoke table, modeled on the strongest existing pattern in this
// schema (SalesCommission / SalesPayoutRequest / SalesPayoutItem):
// idempotent keys, snapshot-at-request-time destinations, and an append
// -only event ledger instead of editing rows in place.
//
// sourceType/sourceId are plain columns rather than relations, following
// the same rationale documented on SalesCommission above: this ledger
// should not force a foreign key onto Invoice, TourBooking, TransportPayout
// and SalesPayoutRequest, and those source rows are never hard-deleted.
// See docs/AZAMPAY_DISBURSEMENT_DEV_GUIDE.md for the full spec this
// implements.
// ─────────────────────────────────────────────────────────────────────────

/// A verified payout destination (mobile money or bank) for any payee type.
/// One User can hold several, e.g. an operator with both a MOBILE_MONEY and
/// a BANK account. isVerified only becomes true after a successful AzamPay
/// Name Lookup; changing accountNumber/provider must reset it to false.
model PayoutAccount {
  id     Int @id @default(autoincrement())
  userId Int

  type          String @db.VarChar(20) // MOBILE_MONEY | BANK
  provider      String @db.VarChar(30) // tigo | airtel | azampesa | crdb | nmb ...
  accountNumber String @db.VarChar(40)
  accountName   String @db.VarChar(160)
  currency      String @default("TZS") @db.VarChar(3)

  isVerified           Boolean   @default(false)
  /// When this destination was first accepted by AzamPay Name Lookup. Kept
  /// as a provenance marker — never overwritten by routine re-verification,
  /// which writes lastVerifiedAt instead.
  verifiedAt           DateTime?
  /// Last time batching.ts re-ran Name Lookup against this account. Purely
  /// operational; risk scoring must not read it. Split out from verifiedAt
  /// because re-verification used to overwrite that column every batch run,
  /// which silently turned the "when did this destination change" anchor
  /// into "when did a batch last run" and broke the takeover signal.
  lastVerifiedAt       DateTime?
  /// When the money-carrying fields (provider, accountNumber, accountName)
  /// last changed. Set on creation and by any future edit path. This is the
  /// only anchor riskScoring.ts may use for RECENT_ACCOUNT_CHANGE.
  destinationChangedAt DateTime?
  isDefault            Boolean   @default(false)
  isActive             Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation("PayoutAccountOwner", fields: [userId], references: [id], onDelete: Restrict)
  disbursements Disbursement[]

  @@unique([userId, provider, accountNumber])
  @@index([userId, isActive])
  @@map("payout_account")
}

/// One AzamPay disbursement request, regardless of which NoLSAF flow
/// originated it. sourceType distinguishes OWNER_INVOICE | TOUR_BOOKING |
/// DRIVER_TRIP | SALES_PAYOUT so this table can eventually replace the
/// ad-hoc "mark paid" logic in each of those flows without forcing them
/// onto a shared schema before the provider contract is even confirmed.
model Disbursement {
  id Int @id @default(autoincrement())

  /// NoLSAF-generated, max 30 chars per AzamPay's externalReferenceId limit.
  /// Unique before the AzamPay call is ever made — this is the idempotency
  /// anchor for the whole flow.
  externalReferenceId String  @unique @db.VarChar(30)
  pgReferenceId       String? @unique @db.VarChar(64)
  fspReferenceId      String? @db.VarChar(64)

  sourceType String @db.VarChar(20) // OWNER_INVOICE | TOUR_BOOKING | DRIVER_TRIP | SALES_PAYOUT
  sourceId   Int

  /// "<sourceType>:<sourceId>" while this disbursement is live, NULL once it
  /// reaches FAILED. The unique constraint on it is what makes "one active
  /// payout per source" a database guarantee rather than a read-then-write
  /// check the way it used to be: two concurrent requests for the same
  /// invoice can both pass an application-level lookup, but only one can
  /// insert this key. FAILED rows release the key so a fresh attempt is
  /// still allowed, matching ledger.requestDisbursement's re-request rule.
  activeSourceKey String? @unique @db.VarChar(60)

  payoutAccountId Int

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("TZS") @db.VarChar(3)

  /// REQUESTED, APPROVED, BATCHED, AUTHORIZED, SUBMITTED, PROCESSING, PAID,
  /// FAILED, SECURITY_REVIEW, RECOVERY_PENDING, RECOVERED — mirrors the
  /// Tours payoutStatus machine, the one existing flow that already has a
  /// working cancellation clawback (see tourCancellationConsistency.ts).
  /// Extending recovery states to this shared table is what lets
  /// Owner/Driver/Sales gain the same clawback safety Tours already has.
  ///
  /// Post-approval lifecycle per docs/AZAMPAY_DISBURSEMENT_DEV_GUIDE.md
  /// "Batch security architecture": APPROVED -> BATCHED (system groups
  /// re-verified approved payouts) -> AUTHORIZED (separate human release of
  /// the locked batch) -> PROCESSING (worker submits per-item) -> PAID /
  /// FAILED. Any fingerprint mismatch or high risk score at batch time
  /// diverts a payout to SECURITY_REVIEW instead.
  status String @default("REQUESTED") @db.VarChar(20)

  provider String  @default("azampay") @db.VarChar(20)
  bankName String  @db.VarChar(30) // tigo | airtel | azampesa — MNO-focused, see dev guide
  operator String? @db.VarChar(40)

  approvedById Int?
  approvedAt   DateTime?
  submittedAt  DateTime?
  paidAt       DateTime?
  failedAt     DateTime?

  /// SHA256 over the locked payout snapshot (id, externalReferenceId,
  /// amount, currency, provider, accountNumber, accountName, sourceId),
  /// computed and frozen at approve time. Recomputed and compared at batch
  /// formation AND again inside submitToAzamPay immediately before the
  /// money-out call, so a change to the destination account at any point
  /// after approval blocks the payout instead of redirecting it. Nullable
  /// only for rows approved before this column existed; batching and
  /// submission both treat NULL as "not locked" and refuse to proceed.
  approvalFingerprint String? @db.VarChar(64)

  /// LOW | MEDIUM | HIGH | CRITICAL — computed at batch-formation time by
  /// riskScoring.ts. HIGH/CRITICAL never enters a batch; it is routed to
  /// SECURITY_REVIEW for senior approval instead.
  riskLevel            String? @db.VarChar(10)
  /// Machine-readable list of the risk signals that fired, e.g.
  /// ["RECENT_ACCOUNT_CHANGE", "FIRST_PAYOUT_TO_BENEFICIARY"].
  riskFlags            Json?
  /// Why this payout is sitting in SECURITY_REVIEW — fingerprint mismatch,
  /// risk score, or a rejected bulk re-verification. Cleared when resolved.
  securityReviewReason String? @db.VarChar(300)

  batchId Int?

  /// Redacted before writing where the payload could contain account
  /// numbers beyond what audit/support needs — see "Security boundary" in
  /// the dev guide.
  providerMessage String? @db.VarChar(300)
  rawRequest      Json?
  rawResponse     Json?

  remarks String? @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payoutAccount PayoutAccount       @relation(fields: [payoutAccountId], references: [id], onDelete: Restrict)
  approvedBy    User?               @relation("DisbursementApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  /// Restrict, not SetNull: orphaning a BATCHED/AUTHORIZED payout would drop
  /// it out of every batch view while leaving it submittable, which is
  /// exactly the invisible-money-in-flight state this table exists to avoid.
  batch         DisbursementBatch?  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  events        DisbursementEvent[]

  @@index([sourceType, sourceId])
  @@index([status, submittedAt])
  @@index([payoutAccountId])
  @@index([batchId])
  @@map("disbursement")
}

/// Groups APPROVED, bulk-re-verified, fingerprint-locked disbursements for
/// a single deliberate release decision — see "Batch security architecture"
/// in docs/AZAMPAY_DISBURSEMENT_DEV_GUIDE.md. Formation (DRAFT), the
/// authorize action (AUTHORIZED), and per-item processing are separate
/// steps so a batch's exact membership can be fingerprinted and never
/// silently changed after a human has signed off on it.
model DisbursementBatch {
  id             Int    @id @default(autoincrement())
  batchReference String @unique @db.VarChar(40)

  /// DRAFT (formed, awaiting authorization) -> AUTHORIZED (released by a
  /// second admin/finance action) -> PROCESSING (worker submitting items)
  /// -> COMPLETED (every item reached a terminal state) | SECURITY_REVIEW
  /// (fingerprint mismatch caught at authorize time) -> ABANDONED (every
  /// member of a frozen batch was cleared and re-queued, leaving an empty
  /// shell kept only for the audit trail).
  status String @default("DRAFT") @db.VarChar(20)

  totalAmount Decimal @db.Decimal(14, 2)
  currency    String  @default("TZS") @db.VarChar(3)
  itemCount   Int

  /// SHA256 over the sorted, exact set of member disbursements, each line
  /// covering externalReferenceId|amount|currency|provider|accountNumber|
  /// accountName read from the LIVE PayoutAccount. Hashing the real
  /// destination (not the payoutAccountId) is the point: it is what makes a
  /// swapped account number between formation and release detectable.
  /// Computed at formation and re-checked at authorize time. A mismatch
  /// means the batch's membership or a member's destination changed after
  /// formation, and freezes the batch to SECURITY_REVIEW.
  batchFingerprint String @db.VarChar(64)

  /// Formation, authorization and release are three distinct human actions.
  /// authorizeBatch refuses when the authorizer also formed the batch or
  /// approved any member: a single compromised admin session must not be
  /// able to walk a payout end to end. See services/payouts/batching.ts.
  formedById     Int?
  authorizedById Int?
  authorizedAt   DateTime?

  /// Set once every member has reached a terminal state (PAID/FAILED). A
  /// batch left PROCESSING past processingStartedAt is the signal that
  /// submission was interrupted; the worker resumes it from there.
  processingStartedAt DateTime?
  completedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formedBy     User?          @relation("DisbursementBatchFormedBy", fields: [formedById], references: [id], onDelete: SetNull)
  authorizedBy User?          @relation("DisbursementBatchAuthorizedBy", fields: [authorizedById], references: [id], onDelete: SetNull)
  items        Disbursement[]

  @@index([status])
  @@index([createdAt])
  @@map("disbursement_batch")
}

/// Append-only audit trail for everything AzamPay tells NoLSAF about a
/// disbursement after submission: the initial accept response, callbacks,
/// and status polls. eventHash is the idempotency key that makes a
/// replayed callback a no-op instead of a duplicate PAID transition — see
/// "Callback idempotency and accounting integrity" in the dev guide.
model DisbursementEvent {
  id             Int @id @default(autoincrement())
  disbursementId Int

  eventType String @db.VarChar(30) // SUBMIT_RESPONSE | CALLBACK | STATUS_POLL | SECURITY_REVIEW | AMOUNT_MISMATCH
  eventHash String @unique @db.VarChar(80)

  status         String?  @db.VarChar(20)
  message        String?  @db.VarChar(300)
  pgReferenceId  String?  @db.VarChar(64)
  fspReferenceId String?  @db.VarChar(64)
  amount         Decimal? @db.Decimal(12, 2)
  operator       String?  @db.VarChar(40)
  payload        Json?

  createdAt DateTime @default(now())

  disbursement Disbursement @relation(fields: [disbursementId], references: [id], onDelete: Cascade)

  @@index([disbursementId])
  @@map("disbursement_event")
}

// =========================================================
//  PAYMENT ORCHESTRATION CORE (provider-neutral)
//
//  Design record: docs/private/NRMS_PAYMENT_ORCHESTRATION.md
//
//  This section exists so a guest can pay a PROPERTY rather than pay NoLSAF.
//  Every AzamPay collection that predates it (Invoice, TourBooking,
//  GroupBooking, NrmsServicePaymentToken) settles money that is NoLSAF's own,
//  which is why they all share one global merchant identity. Owner money
//  cannot use that identity: the owner is the merchant of record, and the
//  guest's money must reach the owner's own provider wallet without first
//  entering a NoLSAF-held account.
//
//  Nothing here is provider-specific. AzamPay is the first adapter, not the
//  model. Provider-native identifiers live on the attempt and event rows and
//  are never promoted onto a booking, folio or outlet order, so a second
//  provider cannot require a rewrite of NRMS business tables.
//
//  Every table below is additive and inert on arrival. No existing row, route
//  or worker reads them until the orchestration routes ship behind their
//  feature flag, so applying this migration changes no current behaviour.
// =========================================================

/// The business that sells the service, as NRMS knows it.
///
/// Deliberately NOT the User row. One business can authorise several users and
/// one owner user can run several properties, so collapsing merchant identity
/// into `User` makes it impossible to say which legal entity received a given
/// payment. `administeredById` names the user who currently administers this
/// merchant; it is an access pointer, not the merchant's identity.
model MerchantLegalEntity {
  id Int @id @default(autoincrement())

  administeredById Int

  legalName          String  @db.VarChar(200)
  tradingName        String? @db.VarChar(200)
  registrationNumber String? @db.VarChar(60)
  /// Taxpayer identification. Not a secret; it is printed on receipts.
  tin                String? @db.VarChar(20)
  country            String  @default("TZ") @db.VarChar(2)

  contactEmail String? @db.VarChar(180)
  contactPhone String? @db.VarChar(20)

  /// DRAFT, ACTIVE, SUSPENDED, CLOSED. Local NRMS state only: it never means a
  /// provider approved anything.
  status       String  @default("DRAFT") @db.VarChar(20)
  statusReason String? @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  administeredBy    User                      @relation("MerchantLegalEntityAdmin", fields: [administeredById], references: [id], onDelete: Restrict)
  propertyLinks     MerchantPropertyLink[]
  providerAccounts  MerchantProviderAccount[]
  applications      MerchantApplication[]
  policyAcceptances PolicyAcceptance[]
  paymentIntents    PaymentIntent[]

  @@index([administeredById, status])
  @@index([status])
  @@map("merchant_legal_entity")
}

/// Which properties, and optionally which outlets, may sell under a merchant.
/// Effective-dated so a change of operator never rewrites historical payments.
///
/// `activeScopeKey` is the "one active mapping per scope" guarantee, held in
/// the database rather than in a read-then-write check. It carries
/// "<propertyId>:<outletId or ALL>" while the link is live and is NULL once the
/// link closes, so the unique index permits any number of historical links and
/// exactly one current one. Same device as Disbursement.activeSourceKey.
model MerchantPropertyLink {
  id Int @id @default(autoincrement())

  merchantId Int
  propertyId Int
  /// NULL means the whole property. A value scopes the link to one outlet, and
  /// is only permitted where a provider contract establishes outlet-level
  /// merchants.
  outletId   Int?

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  activeScopeKey String? @unique @db.VarChar(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant MerchantLegalEntity @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  property Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  outlet   NrmsOutlet?         @relation(fields: [outletId], references: [id], onDelete: Restrict)

  @@index([merchantId])
  @@index([propertyId, outletId])
  @@map("merchant_property_link")
}

/// One payment provider in one environment. Adding a provider adds a row here
/// plus an adapter; it never adds a branch to booking, folio or outlet code.
model ProviderConnection {
  id Int @id @default(autoincrement())

  /// AZAMPAY, STRIPE, FAKE. FAKE is the deterministic in-repo simulator used
  /// for contract tests and must never exist in a production environment.
  provider    String @db.VarChar(30)
  /// SANDBOX, STAGING, PRODUCTION.
  environment String @db.VarChar(20)
  displayName String @db.VarChar(80)

  /// Declared capability matrix for this provider and environment: channels,
  /// currencies, refund and partial-refund support, hosted checkout, and the
  /// submerchant model. Read by routing to refuse an unsupported request
  /// before any external call is made.
  capabilities Json?

  /// Master kill switch for this connection. Disabling stops NEW attempts and
  /// deliberately leaves callbacks, reconciliation, refunds and historical
  /// evidence working.
  isEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerAccounts MerchantProviderAccount[]
  applications     MerchantApplication[]
  attempts         PaymentAttempt[]
  events           ProviderEventInbox[]
  routingRules     PaymentRoutingRule[]

  @@unique([provider, environment])
  @@map("provider_connection")
}

/// A merchant's account at one provider. This is the row that makes an owner
/// payable: without an ACTIVE one, checkout for that property fails closed and
/// must never fall back to a NoLSAF account.
model MerchantProviderAccount {
  id Int @id @default(autoincrement())

  merchantId   Int
  connectionId Int

  /// Provider-native identifiers, populated only from a verified provider
  /// response or callback. Never typed in by an administrator.
  providerMerchantId String? @db.VarChar(120)
  providerAccountRef String? @db.VarChar(120)

  /// NOT_SUBSCRIBED, DRAFT, ACTION_REQUIRED, READY_FOR_ADMIN_REVIEW,
  /// ADMIN_REJECTED, SUBMISSION_QUEUED, SUBMITTED_TO_PROVIDER, PROVIDER_REVIEW,
  /// PROVIDER_ACTION_REQUIRED, PROVIDER_ACCOUNT_CREATED, ACTIVE, SUSPENDED,
  /// REJECTED, CLOSED.
  ///
  /// Only ACTIVE may originate a payment, and only over a channel that is
  /// separately enabled. Local admin approval reaches SUBMISSION_QUEUED and
  /// never ACTIVE: activation requires a verified provider result.
  status       String  @default("NOT_SUBSCRIBED") @db.VarChar(30)
  statusReason String? @db.VarChar(300)

  activatedAt DateTime?
  suspendedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant       MerchantLegalEntity         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  connection     ProviderConnection          @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  wallets        MerchantWallet[]
  capabilities   MerchantChannelCapability[]
  settlements    ProviderSettlement[]
  paymentIntents PaymentIntent[]

  @@unique([merchantId, connectionId])
  @@index([status])
  @@index([providerMerchantId])
  @@map("merchant_provider_account")
}

/// The destination a payment is routed to. NRMS stores the reference only and
/// holds no balance authority: the provider remains the sole source of truth
/// for what is actually in the wallet.
model MerchantWallet {
  id Int @id @default(autoincrement())

  providerAccountId Int
  providerWalletId  String @db.VarChar(120)
  currency          String @default("TZS") @db.VarChar(3)

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerAccount MerchantProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)
  paymentIntents  PaymentIntent[]
  settlements     ProviderSettlement[]

  @@unique([providerAccountId, providerWalletId, currency])
  @@index([providerAccountId, isActive])
  @@map("merchant_wallet")
}

/// Per-account channel switch. An ACTIVE provider account does not mean every
/// rail is open: a wallet can exist while card or bank remains disabled.
model MerchantChannelCapability {
  id Int @id @default(autoincrement())

  providerAccountId Int
  /// MNO, BANK, CARD, HOSTED_CHECKOUT.
  channel           String @db.VarChar(20)

  isEnabled      Boolean   @default(false)
  enabledAt      DateTime?
  disabledReason String?   @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerAccount MerchantProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)

  @@unique([providerAccountId, channel])
  @@map("merchant_channel_capability")
}

/// One versioned onboarding submission.
///
/// A correction after submission creates a NEW version rather than editing the
/// reviewed evidence, so an approval can always be traced to the exact package
/// the reviewer actually saw.
model MerchantApplication {
  id Int @id @default(autoincrement())

  merchantId   Int
  connectionId Int
  version      Int

  /// DRAFT, ACTION_REQUIRED, READY_FOR_ADMIN_REVIEW, ADMIN_REJECTED,
  /// SUBMISSION_QUEUED, SUBMITTED_TO_PROVIDER, PROVIDER_REVIEW,
  /// PROVIDER_ACTION_REQUIRED, PROVIDER_ACCOUNT_CREATED, ACTIVE, REJECTED.
  status String @default("DRAFT") @db.VarChar(30)

  /// Hash of the frozen application payload. Proves the reviewed version was
  /// not altered between review and provider submission. No KYC content is
  /// stored on this row.
  payloadHash String?   @db.VarChar(128)
  frozenAt    DateTime?

  submittedAt           DateTime?
  providerSubmissionRef String?   @db.VarChar(120)

  reviewedById   Int?
  reviewedAt     DateTime?
  decisionReason String?   @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant   MerchantLegalEntity           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  connection ProviderConnection            @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  reviewedBy User?                         @relation("MerchantApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents  MerchantApplicationDocument[]

  @@unique([merchantId, connectionId, version])
  @@index([status])
  @@map("merchant_application")
}

/// A KYC document's METADATA and review state, as attached to one application.
///
/// This table never holds document content. Owners already upload their KYC to
/// `UserDocument` through the ordinary Owner Workspace, which owns the storage,
/// the trusted-URL checks and the per-role allowed types, so a merchant
/// application LINKS to that record rather than duplicating the file. Two
/// copies of the same passport is two things to secure, two to expire and two
/// to get out of step.
///
/// The row is still a snapshot: `documentType` and `verificationState` record
/// what was attached at submission, so an application's evidence stays
/// reviewable even if the owner later replaces the underlying upload.
model MerchantApplicationDocument {
  id Int @id @default(autoincrement())

  applicationId Int

  /// The owner's existing upload. NULL only for a document sourced outside the
  /// Owner Workspace, which nothing does today.
  userDocumentId Int?

  /// NATIONAL_ID, PASSPORT, BUSINESS_LICENCE, TIN_CERTIFICATE,
  /// BANK_STATEMENT, PROOF_OF_ADDRESS, OTHER.
  documentType   String    @db.VarChar(40)
  issuingCountry String?   @db.VarChar(2)
  expiresAt      DateTime?

  /// Retained only for a document that has no `userDocumentId`. When the
  /// document is linked, the storage location belongs to `UserDocument.url`
  /// and is deliberately not copied here.
  storageKey String? @db.VarChar(400)

  /// PENDING, VERIFIED, REJECTED, EXPIRED.
  verificationState String  @default("PENDING") @db.VarChar(20)
  rejectionCode     String? @db.VarChar(40)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application  MerchantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userDocument UserDocument?       @relation(fields: [userDocumentId], references: [id], onDelete: SetNull)

  @@index([applicationId, verificationState])
  @@index([userDocumentId])
  @@map("merchant_application_document")
}

/// Evidence of the exact terms an owner accepted.
///
/// A single boolean column cannot prove WHICH version was accepted, which is
/// the only thing that matters if the commercial terms are ever disputed. So
/// acceptance is an append-only row carrying the content hash, and a material
/// policy change supersedes rather than overwrites.
model PolicyAcceptance {
  id Int @id @default(autoincrement())

  merchantId       Int
  acceptedByUserId Int

  policyId      String @db.VarChar(60)
  policyVersion String @db.VarChar(20)
  contentHash   String @db.VarChar(128)

  /// NULL means the acceptance covers every property under the merchant.
  scopePropertyId Int?

  ipAddress String? @db.VarChar(60)
  userAgent String? @db.VarChar(300)

  acceptedAt   DateTime  @default(now())
  supersededAt DateTime?

  merchant   MerchantLegalEntity @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  acceptedBy User                @relation("PolicyAcceptanceUser", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@index([merchantId, policyId, supersededAt])
  @@map("policy_acceptance")
}

/// One business decision to collect a specific amount, for a specific purpose,
/// into a specific merchant wallet.
///
/// The intent is the unit that must never be ambiguous. Amount and currency
/// come from the server-side balance, and the merchant, provider account and
/// wallet are resolved and SNAPSHOTTED here before any external call. A client
/// may pick an offered channel but can never influence the destination.
model PaymentIntent {
  id Int @id @default(autoincrement())

  /// NoLSAF-generated public reference, safe to print on a receipt.
  reference      String @unique @db.VarChar(40)
  /// Unique per caller intent. Two requests carrying the same key resolve to
  /// this same intent instead of collecting twice.
  idempotencyKey String @unique @db.VarChar(120)

  merchantId        Int
  providerAccountId Int?
  walletId          Int?
  propertyId        Int?

  /// ACCOMMODATION, FOLIO, OUTLET_ORDER, MASTER_FOLIO, SERVICE, DEPOSIT.
  purpose String @db.VarChar(30)

  /// The NRMS object being paid. Polymorphic on purpose, the same way
  /// Disbursement.sourceType is: RESERVATION, NRMS_OUTLET_ORDER,
  /// NRMS_MASTER_FOLIO, NRMS_GUEST_PAYMENT_REQUEST.
  sourceType String @db.VarChar(40)
  sourceId   Int

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("TZS") @db.VarChar(3)

  /// CREATED, ELIGIBILITY_CHECKED, INITIATION_PENDING, PROCESSING, SUCCEEDED,
  /// FAILED, EXPIRED, CANCELLED, STATUS_UNKNOWN, PARTIALLY_REFUNDED, REFUNDED,
  /// REVERSED, DISPUTED.
  ///
  /// STATUS_UNKNOWN is load-bearing rather than cosmetic: it blocks retry and
  /// failover until reconciliation establishes whether money actually moved.
  status String @default("CREATED") @db.VarChar(30)

  /// Frozen copy of the routing decision (merchant, provider, account, wallet,
  /// channel, rule version) as it stood at initiation. A later routing change
  /// must never restate a historical payment.
  routingSnapshot Json?

  /// Business date and cashier context captured at creation, so a callback
  /// that lands after the shift or business day closes still posts against the
  /// day the sale actually happened.
  businessDate DateTime? @db.Date
  /// Deliberately not a foreign key: a shift is operational context, and a
  /// closed or archived shift must never block or cascade into a payment
  /// record that is financial evidence.
  shiftId      Int?

  expiresAt DateTime?
  settledAt DateTime?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant        MerchantLegalEntity      @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  providerAccount MerchantProviderAccount? @relation(fields: [providerAccountId], references: [id], onDelete: Restrict)
  wallet          MerchantWallet?          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  property        Property?                @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  attempts    PaymentAttempt[]
  allocations PaymentAllocation[]
  refunds     PaymentRefund[]
  disputes    PaymentDispute[]
  events      ProviderEventInbox[]

  @@index([merchantId, status])
  @@index([sourceType, sourceId])
  @@index([propertyId, businessDate])
  @@index([status, createdAt])
  @@map("payment_intent")
}

/// One external call or hosted-checkout session under an intent.
///
/// An intent can carry several attempts: a failed prompt, then a retry on
/// another channel. Provider-native status and references live here and are
/// never promoted onto the booking, so replacing a provider cannot orphan a
/// reservation.
model PaymentAttempt {
  id Int @id @default(autoincrement())

  intentId     Int
  connectionId Int

  /// MNO, BANK, CARD, HOSTED_CHECKOUT.
  channel String @db.VarChar(20)

  /// Provider transaction reference, unique where the provider guarantees it.
  /// NULL until the provider answers.
  providerRef String? @unique @db.VarChar(120)

  /// CREATED, REQUIRES_CUSTOMER_ACTION, PROCESSING, SUCCEEDED, FAILED,
  /// EXPIRED, CANCELLED, STATUS_UNKNOWN.
  normalizedStatus String  @default("CREATED") @db.VarChar(30)
  /// The provider's own status string, retained verbatim for support and
  /// dispute evidence.
  providerStatus   String? @db.VarChar(80)

  /// Hash of the outbound request, so a retry can prove it is the same call
  /// rather than a second, different collection.
  requestHash String? @db.VarChar(128)
  checkoutUrl String? @db.VarChar(2048)
  /// Masked payer identifier only. A full MSISDN is never stored here.
  payerMasked String? @db.VarChar(40)

  failureCode String?   @db.VarChar(60)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  intent     PaymentIntent      @relation(fields: [intentId], references: [id], onDelete: Cascade)
  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@index([intentId, normalizedStatus])
  @@index([normalizedStatus, startedAt])
  @@map("payment_attempt")
}

/// How a captured amount splits across the balances it settles.
///
/// One folio payment can cover room revenue, a bar tab, tax, a tip and a
/// service charge. Allocation keeps each revenue category separate for
/// accounting and tax instead of collapsing them into a single paid total.
model PaymentAllocation {
  id Int @id @default(autoincrement())

  intentId Int

  /// ROOM, OUTLET_ORDER, FOLIO_CHARGE, TAX, TIP, SERVICE_CHARGE,
  /// PROVIDER_FEE, PLATFORM_FEE.
  targetType String @db.VarChar(30)
  targetId   Int?

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("TZS") @db.VarChar(3)

  /// A correction adds a reversing row and points it at the row it cancels.
  /// A posted allocation is never edited, so SUM() over the table is always
  /// the true position. Same discipline as RevenueEntry.
  reversedAt           DateTime?
  reversesAllocationId Int?

  createdAt DateTime @default(now())

  intent               PaymentIntent       @relation(fields: [intentId], references: [id], onDelete: Cascade)
  reversesAllocation   PaymentAllocation?  @relation("AllocationReversal", fields: [reversesAllocationId], references: [id], onDelete: SetNull)
  reversedByAllocation PaymentAllocation[] @relation("AllocationReversal")

  @@index([intentId, targetType])
  @@index([targetType, targetId])
  @@map("payment_allocation")
}

/// Every authenticated provider callback, recorded before it is acted on.
///
/// The inbox is what makes callbacks safe to receive more than once: the
/// provider event id is unique per connection, so a retry is recognised rather
/// than double-applied. An event that cannot be matched, or that names a
/// merchant other than the one on the intent, is parked for review instead of
/// being guessed at.
model ProviderEventInbox {
  id Int @id @default(autoincrement())

  connectionId    Int
  providerEventId String @db.VarChar(160)

  eventType String @db.VarChar(60)

  /// Result of verifying the provider's signature over the RAW body. A false
  /// value must never reach processing.
  signatureVerified Boolean @default(false)

  providerOccurredAt DateTime?
  receivedAt         DateTime  @default(now())

  /// Digest of the raw payload, so dispute evidence survives even after the
  /// payload itself is dropped under the retention policy.
  payloadDigest String @db.VarChar(128)
  rawPayload    Json?

  /// PENDING, PROCESSED, UNMATCHED, WRONG_MERCHANT, REJECTED, REVIEW.
  processingState String    @default("PENDING") @db.VarChar(20)
  processedAt     DateTime?
  reviewReason    String?   @db.VarChar(300)

  matchedIntentId Int?

  connection    ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  matchedIntent PaymentIntent?     @relation(fields: [matchedIntentId], references: [id], onDelete: SetNull)

  @@unique([connectionId, providerEventId])
  @@index([processingState, receivedAt])
  @@index([matchedIntentId])
  @@map("provider_event_inbox")
}

/// Provider evidence that money reached, or is due to reach, a merchant wallet.
///
/// Payment status and settlement status are deliberately separate: a payment
/// can be SUCCEEDED days before the provider settles it, and reconciliation
/// needs to see both without either overwriting the other.
model ProviderSettlement {
  id Int @id @default(autoincrement())

  providerAccountId Int
  walletId          Int?

  providerSettlementRef String @db.VarChar(120)

  grossAmount  Decimal @db.Decimal(14, 2)
  feeAmount    Decimal @default(0) @db.Decimal(14, 2)
  taxAmount    Decimal @default(0) @db.Decimal(14, 2)
  refundAmount Decimal @default(0) @db.Decimal(14, 2)
  netAmount    Decimal @db.Decimal(14, 2)
  currency     String  @default("TZS") @db.VarChar(3)

  settlementDate DateTime @db.Date
  /// PENDING, SETTLED, PARTIAL, DISPUTED.
  status         String   @default("PENDING") @db.VarChar(20)

  rawReport Json?
  createdAt DateTime @default(now())

  providerAccount MerchantProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Restrict)
  wallet          MerchantWallet?         @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@unique([providerAccountId, providerSettlementRef])
  @@index([settlementDate, status])
  @@map("provider_settlement")
}

/// Money returned to a payer.
///
/// Independent of the order or booking being voided: voiding a paid order can
/// never erase the payment, it can only create one of these.
model PaymentRefund {
  id Int @id @default(autoincrement())

  intentId  Int
  reference String @unique @db.VarChar(40)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("TZS") @db.VarChar(3)
  reason   String  @db.VarChar(300)

  /// REQUESTED, APPROVED, PROCESSING, COMPLETED, FAILED, REJECTED.
  status String @default("REQUESTED") @db.VarChar(20)

  providerRefundRef String? @unique @db.VarChar(120)

  requestedById Int?
  approvedById  Int?
  requestedAt   DateTime  @default(now())
  completedAt   DateTime?

  intent      PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)
  requestedBy User?         @relation("PaymentRefundRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy  User?         @relation("PaymentRefundApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([intentId, status])
  @@index([status, requestedAt])
  @@map("payment_refund")
}

/// A payer or provider challenge to a captured payment.
model PaymentDispute {
  id Int @id @default(autoincrement())

  intentId           Int
  providerDisputeRef String @unique @db.VarChar(120)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("TZS") @db.VarChar(3)

  /// OPEN, UNDER_REVIEW, WON, LOST, WITHDRAWN.
  status  String  @default("OPEN") @db.VarChar(20)
  outcome String? @db.VarChar(60)

  openedAt   DateTime  @default(now())
  dueAt      DateTime?
  resolvedAt DateTime?

  intent PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)

  @@index([intentId, status])
  @@map("payment_dispute")
}

/// Durable outbox, so a database state change and the external call it implies
/// cannot silently diverge.
///
/// A provider submission that times out must be retryable without creating a
/// second application or a second collection, which is exactly what the unique
/// idempotency key guarantees.
model PaymentOutboxJob {
  id Int @id @default(autoincrement())

  /// SUBMIT_MERCHANT_APPLICATION, POLL_MERCHANT_STATUS, POLL_PAYMENT_STATUS,
  /// REQUEST_REFUND, FETCH_SETTLEMENT.
  jobType    String @db.VarChar(50)
  targetType String @db.VarChar(40)
  targetId   Int

  idempotencyKey String @unique @db.VarChar(120)

  /// PENDING, RUNNING, SUCCEEDED, FAILED, DEAD_LETTER.
  status   String @default("PENDING") @db.VarChar(20)
  attempts Int    @default(0)

  nextAttemptAt DateTime  @default(now())
  lastError     String?   @db.VarChar(500)
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([targetType, targetId])
  @@map("payment_outbox_job")
}

/// Versioned server-side routing.
///
/// The customer never chooses the destination; this table does, and the
/// decision is snapshotted onto the intent before the external call, so a
/// later rule change cannot restate a historical payment.
model PaymentRoutingRule {
  id Int @id @default(autoincrement())

  /// GLOBAL, MERCHANT, PROPERTY, OUTLET.
  scopeType String @db.VarChar(20)
  scopeId   Int?

  /// NULL matches any value. A narrower rule wins over a broader one at equal
  /// priority.
  purpose  String? @db.VarChar(30)
  currency String? @db.VarChar(3)
  channel  String? @db.VarChar(20)

  connectionId Int
  /// Lower runs first.
  priority     Int     @default(100)
  isActive     Boolean @default(true)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@index([scopeType, scopeId, isActive, priority])
  @@map("payment_routing_rule")
}

/// Append-only record of who changed what, when and why across merchant
/// onboarding and payment administration. Required because several of these
/// transitions move money, or unlock the ability to move money.
model MerchantAuditEvent {
  id Int @id @default(autoincrement())

  /// MERCHANT, PROVIDER_ACCOUNT, APPLICATION, WALLET, CHANNEL, INTENT, REFUND,
  /// ROUTING_RULE, CONNECTION.
  entityType String @db.VarChar(40)
  entityId   Int

  action String @db.VarChar(60)

  /// USER, SYSTEM, PROVIDER. A provider-driven change has no actor user.
  actorKind   String @default("USER") @db.VarChar(20)
  actorUserId Int?

  previousState String? @db.VarChar(40)
  nextState     String? @db.VarChar(40)
  reason        String? @db.VarChar(300)
  metadata      Json?

  createdAt DateTime @default(now())

  actorUser User? @relation("MerchantAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("merchant_audit_event")
}
