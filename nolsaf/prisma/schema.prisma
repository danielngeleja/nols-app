/// Corporate verification record shown on the public /verify page.
///
/// This is an anti-impersonation surface, so the model is built to make an
/// unapproved claim impossible to publish rather than merely discouraged:
/// `status` and `visibility` are independent, and the API refuses to serve a
/// public record that has no `evidenceApprovedAt` and approver.
///
/// Records are archived, never deleted, once published. A withdrawn claim has
/// to leave a trail, because "this was on the page last week" is exactly the
/// question an investigation asks.
model CompanyVerification {
  id Int @id @default(autoincrement())

  /// Stable machine key, e.g. BRELA_COMPANY_REGISTRATION, DUNS_NUMBER.
  key String @unique @db.VarChar(80)

  /// Grouping for the public page: IDENTITY, REGISTRATION, COMPLIANCE.
  category    String @db.VarChar(40)
  displayName String @db.VarChar(160)

  /// The independent body that issued this, e.g. BRELA. Never implied to
  /// endorse NoLSAF, only to have issued the record.
  authorityName   String? @db.VarChar(160)
  authorityDomain String? @db.VarChar(160)
  jurisdiction    String? @db.VarChar(120)

  /// Preserved in the approved display format; `registrationNumberNormalized`
  /// exists so search never forces the display value to be mangled.
  registrationNumber           String? @db.VarChar(120)
  registrationNumberNormalized String? @db.VarChar(120)

  publicSummary String? @db.Text

  /// DRAFT, PENDING, UNDER_REVIEW, VERIFIED, ACTIVE, EXPIRED, WITHDRAWN.
  status     String @default("DRAFT") @db.VarChar(30)
  /// PRIVATE or PUBLIC. Public alone is not enough to appear: the record must
  /// also be published and evidence-approved.
  visibility String @default("PRIVATE") @db.VarChar(20)

  /// Independent lookup URL. Null until an official URL is confirmed, in which
  /// case the card shows the authority name without a link rather than
  /// guessing a destination.
  externalVerificationUrl String? @db.VarChar(500)

  issuedAt      DateTime?
  expiresAt     DateTime?
  lastCheckedAt DateTime?

  /// Set only when a human approved the underlying evidence.
  evidenceApprovedAt   DateTime?
  evidenceApprovedById Int?
  evidenceNote         String?   @db.VarChar(1000)

  publishedAt   DateTime?
  publishedById Int?

  sortOrder Int @default(0)

  createdById Int?
  updatedById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  evidenceApprovedBy User? @relation("CompanyVerificationEvidenceApprovals", fields: [evidenceApprovedById], references: [id], onDelete: SetNull)
  publishedBy        User? @relation("CompanyVerificationPublications", fields: [publishedById], references: [id], onDelete: SetNull)

  @@index([visibility, publishedAt, sortOrder])
  @@index([status, expiresAt])
  @@index([category, sortOrder])
  @@index([registrationNumberNormalized])
  @@map("company_verifications")
}

/// An authorised public channel: the canonical list people check a suspicious
/// message against. Personal employee numbers and unofficial messaging
/// accounts must never be published here.
model OfficialCompanyChannel {
  id Int @id @default(autoincrement())

  /// WEBSITE, EMAIL, PHONE, ADDRESS, SOCIAL.
  channelType String  @db.VarChar(30)
  label       String  @db.VarChar(160)
  /// The domain, address, number, or handle exactly as it should be shown.
  value       String  @db.VarChar(500)
  /// Optional link target where the channel is reachable, e.g. https or mailto.
  href        String? @db.VarChar(500)
  notes       String? @db.VarChar(500)

  /// Same gate as a verification record: confirmed by a human before it can
  /// ever appear as an authorised channel.
  confirmedAt   DateTime?
  confirmedById Int?

  visibility  String    @default("PRIVATE") @db.VarChar(20)
  publishedAt DateTime?
  sortOrder   Int       @default(0)

  createdById Int?
  updatedById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  confirmedBy User? @relation("OfficialCompanyChannelConfirmations", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([visibility, publishedAt, sortOrder])
  @@index([channelType, sortOrder])
  @@map("official_company_channels")
}

// =========================================================
//  REFERRAL EARNINGS MODEL - For tracking driver referral earnings
// =========================================================
model ReferralEarning {
  id Int @id @default(autoincrement())

  /// Driver who earned this referral (the referrer)
  driverId Int

  /// User who was referred (the new user)
  referredUserId Int

  /// Booking that generated this earning (if applicable)
  bookingId Int?

  /// Invoice that generated this earning (if applicable)
  invoiceId Int?

  /// Amount earned from this referral
  amount Decimal @db.Decimal(12, 2)

  /// Currency code (default: TZS)
  currency String @default("TZS")

  /// Status: PENDING, PAID_AS_BONUS, AVAILABLE_FOR_WITHDRAWAL, WITHDRAWN
  status String @default("PENDING")

  /// Reference to bonus payment if paid as bonus (invoice ID or bonus record ID)
  bonusPaymentRef String?

  /// Reference to withdrawal application if applied for withdrawal
  withdrawalId Int?

  /// Admin notes about this earning
  adminNotes String? @db.Text

  /// Timestamp when marked as paid as bonus
  paidAsBonusAt DateTime?

  /// Timestamp when made available for withdrawal
  availableAt DateTime?

  /// Timestamp when withdrawn
  withdrawnAt DateTime?

  /// Record creation timestamp
  createdAt DateTime @default(now())
  /// Record last update timestamp
  updatedAt DateTime @updatedAt

  // Relations
  driver       User                @relation("DriverReferrals", fields: [driverId], references: [id], onDelete: Cascade)
  referredUser User                @relation("ReferredUsers", fields: [referredUserId], references: [id], onDelete: Cascade)
  booking      Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  invoice      Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  withdrawal   ReferralWithdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)

  @@index([driverId])
  @@index([referredUserId])
  @@index([bookingId])
  @@index([invoiceId])
  @@index([status])
  @@index([withdrawalId])
  @@index([createdAt])
  @@map("referral_earnings")
}

// =========================================================
//  REFERRAL WITHDRAWAL MODEL - For driver withdrawal applications
// =========================================================
model ReferralWithdrawal {
  id Int @id @default(autoincrement())

  /// Driver applying for withdrawal
  driverId Int

  /// Total amount requested for withdrawal
  totalAmount Decimal @db.Decimal(12, 2)

  /// Currency code
  currency String @default("TZS")

  /// Status: PENDING, APPROVED, REJECTED, PAID
  status String @default("PENDING")

  /// Payment method preference (BANK, MPESA, TIGOPESA, etc.)
  paymentMethod String?

  /// Payment reference/account details
  paymentRef String?

  /// Admin who approved/rejected this withdrawal
  processedBy Int?

  /// Reason for rejection (if rejected)
  rejectionReason String? @db.Text

  /// Admin notes
  adminNotes String? @db.Text

  /// Timestamp when approved
  approvedAt DateTime?

  /// Timestamp when rejected
  rejectedAt DateTime?

  /// Timestamp when paid
  paidAt DateTime?

  /// Record creation timestamp
  createdAt DateTime @default(now())
  /// Record last update timestamp
  updatedAt DateTime @updatedAt

