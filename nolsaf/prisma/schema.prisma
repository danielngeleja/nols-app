  currency       String      @db.VarChar(3)
  amount         Decimal     @db.Decimal(12, 2)
  metadata       Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  booking        TourBooking @relation(fields: [tourBookingId], references: [id], onDelete: Cascade)

  @@index([tourBookingId, kind, status])
  @@map("tour_financial_transactions")
