  adr            Decimal  @db.Decimal(12, 2)
  revpar         Decimal  @db.Decimal(12, 2)
  confidence     Decimal  @default(0.50) @db.Decimal(5, 4)
  inputs         Json?
  generatedAt    DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, forecastDate, horizonDays])
  @@index([propertyId, generatedAt])
  @@map("nrms_forecast_snapshot")
}

model NrmsPricingRecommendation {
  id              Int       @id @default(autoincrement())
  propertyId      Int
  roomTypeId      Int
  stayDate        DateTime  @db.Date
  currency        String    @default("TZS") @db.VarChar(3)
  currentRate     Decimal   @db.Decimal(12, 2)
  recommendedRate Decimal   @db.Decimal(12, 2)
  floorRate       Decimal?  @db.Decimal(12, 2)
