// =========================================================
//  NoLSAF: Complete Prisma Schema
//  Consolidated schema with all models and relations
//  Target: MySQL 8+
// =========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// =========================================================
//  PUBLIC UPDATES (Latest Updates)
// =========================================================
model SiteUpdate {
  id        String   @id @db.VarChar(64)
  title     String   @db.VarChar(200)
  content   String   @db.Text
  images    Json?
  videos    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("site_updates")
}

// =========================================================
//  USER MODEL - One table for admins, owners, drivers, and customers
// =========================================================
model User {
  id                 Int       @id @default(autoincrement())
  role               String    @default("CUSTOMER") // ADMIN, OWNER, DRIVER, CUSTOMER, AGENT
  /// NRMS finance segregation: NONE, OPERATOR, or APPROVER. This is separate
  /// from the broad ADMIN role and is required for finance OTP actions.
  nrmsFinanceRole    String    @default("NONE") @db.VarChar(20)
  name               String?
  /// Human-friendly display name (used by newer UI)
  fullName           String?   @db.VarChar(160)
  email              String?   @unique
  phone              String?   @unique
  passwordHash       String?
  /// Profile avatar image URL (Cloudinary, etc.)
  avatarUrl          String?   @db.VarChar(500)
  /// User timezone (e.g., Africa/Dar_es_Salaam)
  timezone           String?   @db.VarChar(80)
  /// Preferred display currency (ISO 4217, e.g. "TZS"). Presentation only — never the money of record.
  preferredCurrency  String?   @default("TZS") @db.VarChar(3)
  /// Date of birth (date-only)
  dateOfBirth        DateTime? @db.Date
  /// Location fields used by driver onboarding/profile UI
  region             String?   @db.VarChar(120)
  district           String?   @db.VarChar(120)
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  /// Registration is COMPLETE only after full name, email, and phone are stored.
  /// OTP verification remains a separate per-channel concern.
  registrationStatus String    @default("INCOMPLETE") @db.VarChar(30)
  /// Origin that first created the account: WEB, TRAVELLER_APP, DRIVER_APP,
  /// PARTNERS_APP, LEGACY, or UNKNOWN.
  registrationSource String    @default("UNKNOWN") @db.VarChar(30)
  profileCompletedAt DateTime?
  /// Security anchor for contact-channel changes. A recently replaced channel
  /// cannot immediately authorize another contact or payout destination change.
  emailChangedAt     DateTime?
  phoneChangedAt     DateTime?

  // Owner / business details
  tin     String? @db.VarChar(50)
  address String? @db.VarChar(500)

  // Driver identity + onboarding details
  gender      String? @db.VarChar(20)
  nationality String? @db.VarChar(80)
  nin         String? @db.VarChar(50)

  // Driver vehicle / license details
  licenseNumber   String?  @db.VarChar(80)
  plateNumber     String?  @db.VarChar(30)
  vehicleType     String?  @db.VarChar(50)
  vehicleMake     String?  @db.VarChar(100)
  vehiclePlate    String?  @db.VarChar(30)
  operationArea   String?  @db.VarChar(200)
  paymentPhone    String?  @db.VarChar(30)
  paymentVerified Boolean? @default(false)

  // Two-Factor Authentication
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?
  twoFactorMethod  String? // TOTP, SMS, etc.
  totpSecretEnc    String? // Encrypted TOTP secret
  backupCodesHash  Json? // Array of hashed backup codes
  sms2faEnabled    Boolean? @default(false)

  // Password Management
  previousPasswordHashes Json? // Array of previous password hashes
  previousPasswords      Json? // Alternative field name
  resetPasswordToken     String?
  resetPasswordExpires   DateTime?
  // Global token-invalidation cutoff. Any JWT whose `iat` predates this instant
  // is rejected at auth time. Bumped on password reset/change (force-logout) and
  // "sign out other devices" so those actions actually revoke already-issued
  // tokens. NULL (default) means no cutoff, so existing tokens are unaffected.
  tokensValidAfter       DateTime?

  // Account Status
  suspendedAt       DateTime?
  isDisabled        Boolean?  @default(false)
  kycStatus         String? // PENDING_KYC, APPROVED_KYC, REJECTED_KYC
  kycNote           String? // Admin note sent with request_info action
  kycFieldApprovals Json? // Per-field admin review map: { fieldName: "approved"|"flagged" }

  // Driver-specific fields
  rating      Decimal? @db.Decimal(3, 2) // Driver rating (e.g., 4.5)
  available   Boolean? @default(true) // Driver availability
  isAvailable Boolean? @default(true) // Alternative field name

  /// VIP driver flag (required for PREMIUM/VIP transport claims)
  isVipDriver Boolean @default(false)

  // Payout/Banking details for owners (JSON lets us store momo/bank variants)
  payout Json?

  // Referral system
  referredBy   Int? // Driver who referred this user
  referralCode String? // Referral code used

  /// Per-user notification preferences, e.g. { "bookings": true, "promotions": false, "referrals": true }
  notificationPrefs Json?

  /// Spoken languages, e.g. ["sw", "en"]. For drivers: languages they can communicate in.
  /// For customers: languages they'd like their driver to speak (used to match against driver.languages).
  languages Json?

  /// Driver weekly goals set by the driver, synced across devices, e.g. { "trips": 20, "money": 150000, "moneyUrgent": false }
  driverGoals Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Owner-requested account deletion marker. The row remains available for
  /// financial, booking, fraud-prevention, and statutory relationships.
  deletedAt DateTime?

  // Relations
  // Properties owned by this user (if owner)
  properties Property[]

  // Bookings made by this user (if customer)
  bookings     Booking[]
  tourBookings TourBooking[] @relation("UserTourBookings")

  // Bookings assigned to this user as a driver (optional)
  driverBookings Booking[] @relation("BookingDriver")

  /// Claims submitted by this driver for transport bookings
  transportBookingClaims TransportBookingClaim[] @relation("DriverTransportBookingClaims")

  /// Transport booking claims reviewed by this user (admin)
  reviewedTransportBookingClaims TransportBookingClaim[] @relation("TransportBookingClaimReviews")

  // Invoices for this user (if owner)
  invoices         Invoice[]
  invoicesVerified Invoice[] @relation("InvoiceVerifiedBy")
  invoicesApproved Invoice[] @relation("InvoiceApprovedBy")
  invoicesPaid     Invoice[] @relation("InvoicePaidBy")

  // Group bookings
  groupBookings              GroupBooking[]
  assignedGroupBookings      GroupBooking[]      @relation("GroupBookingOwner")
  groupBookingClaims         GroupBookingClaim[] @relation("GroupBookingClaims")
  reviewedGroupBookingClaims GroupBookingClaim[] @relation("GroupBookingClaimReviews")

  // Transport bookings as customer
  transportBookingsAsCustomer TransportBooking[] @relation("UserTransportBookings")

  // Transport bookings as driver
  transportBookingsAsDriver TransportBooking[] @relation("DriverTransportBookings")

  // Targeted offers for instant auto-dispatch (driver receives offers)
  transportBookingOffers TransportBookingOffer[] @relation("DriverTransportBookingOffers")

  // Transport payout records (driver earnings for transport trips)
  transportPayouts         TransportPayout[] @relation("TransportPayoutDriver")
  approvedTransportPayouts TransportPayout[] @relation("TransportPayoutApprover")
  paidTransportPayouts     TransportPayout[] @relation("TransportPayoutPayer")

  // Property reviews written by this user
  propertyReviews       PropertyReview[]
  propertyVerifications PropertyVerification[] @relation("PropertyVerificationVerifier")

  // Agent reviews written by this user
  agentReviewsWritten AgentReview[] @relation("AgentReviewsUser")

  // User documents (KYC)
  documents UserDocument[]

  // Passkeys for passwordless authentication
  passkeys Passkey[]

  // Saved properties (favorites)
  savedProperties SavedProperty[]

  // Audit logs where this user is the actor
  auditLogs AuditLog[]

  // Referral earnings (as driver)
  referralEarningsAsDriver ReferralEarning[] @relation("DriverReferrals")

  // Referral earnings (as referred user)
  referralEarningsAsReferred ReferralEarning[] @relation("ReferredUsers")

  // Referral withdrawals (as driver)
  referralWithdrawals ReferralWithdrawal[] @relation("DriverWithdrawals")

  // Attributable property shares
  propertySharesSent PropertyShare[] @relation("UserPropertyShares")

  // Trust and verification stewardship
  companyVerificationApprovals CompanyVerification[]    @relation("CompanyVerificationEvidenceApprovals")
  companyVerificationPublishes CompanyVerification[]    @relation("CompanyVerificationPublications")
  officialChannelConfirmations OfficialCompanyChannel[] @relation("OfficialCompanyChannelConfirmations")
  propertySharesJoinedVia      PropertyShare[]          @relation("PropertyShareRegistrations")

  // Driver reminders (for drivers)
  driverReminders DriverReminder[]

  // Referral withdrawals processed by this admin
  referralWithdrawalsProcessed ReferralWithdrawal[] @relation("ProcessedWithdrawals")

  // Notifications for this user
  notifications Notification[]

  // Owner-specific notifications (legacy)
  ownerNotifications Notification[] @relation("OwnerNotifications")

  // Admin audits performed by this user (if admin)
  adminAudits            AdminAudit[]          @relation("AdminAudits")
  // Persisted Action Center work claimed by this administrator.
  assignedAdminWorkItems AdminWorkItem[]       @relation("AdminWorkItemAssignee")
  // Group booking audits performed by this admin
  groupBookingAudits     GroupBookingAudit[]   @relation("GroupBookingAudits")
  // Group booking messages sent by this user/admin
  groupBookingMessages   GroupBookingMessage[] @relation("GroupBookingMessages")

  // Property availability blocks created by this owner
  propertyAvailabilityBlocks PropertyAvailabilityBlock[] @relation("PropertyAvailabilityBlocks")

  // User sessions
  sessions Session[] @relation("UserSessions")

  // Live driver map (for DRIVER role)
  driverLiveLocation  DriverLiveLocation?
  driverLocationPings DriverLocationPing[]

  // Admin 2FA OTPs (for finance actions)
  adminOtps AdminOtp[] @relation("AdminOtps")

  // Email verification/change tokens
  emailVerificationTokens EmailVerificationToken[]

  // Phone verification OTPs
  phoneOtps PhoneOtp[]

  // Admin notes written about owners
  adminNotesWritten  AdminNote[] @relation("AdminNotesAdmin")
  adminNotesReceived AdminNote[] @relation("AdminNotesOwner")

  // Jobs created by this admin
  jobsCreated Job[] @relation("JobsCreated")
  jobsUpdated Job[] @relation("JobsUpdated")

  // Job applications reviewed by this admin
  jobApplicationsReviewed JobApplication[] @relation("JobApplicationsReviewed")

  // Cancellation requests initiated by this user (customer)
  cancellationRequests CancellationRequest[]

  // Cancellation requests reviewed by this user (admin)
  cancellationsReviewed CancellationRequest[] @relation("CancellationReviewedBy")

  // Cancellation request messages sent by this user (customer/admin)
  cancellationMessagesSent CancellationMessage[]

  // Agent profile (if user is an agent)
  agentProfile Agent?

  // Plan requests created by this user (if authenticated)
  planRequests PlanRequest[] @relation("PlanRequestsUser")

  // Plan request messages sent by this user
  planRequestMessages PlanRequestMessage[] @relation("PlanRequestMessages")

  // Chatbot conversations
  chatbotConversations ChatbotConversation[] @relation("ChatbotConversations")

  // KYC audit history (all admin review actions on this driver)
  kycAuditLogs KycAuditLog[] @relation("DriverKycAuditLogs")

  // TripMeter cost estimates created by this user
  tripEstimates TripEstimate[]

  // NRMS (NoLSAF Rooms Management System)
  serviceEnrollments         OwnerServiceEnrollment[]      @relation("OwnerServiceEnrollments")
  nrmsReservationsOwned      Reservation[]                 @relation("NrmsReservationOwner")
  nrmsReservationsCreated    Reservation[]                 @relation("NrmsReservationCreator")
  nrmsGuestInquiriesOwned    NrmsGuestInquiry[]            @relation("NrmsGuestInquiryOwner")
  nrmsGuestInquiriesAssigned NrmsGuestInquiry[]            @relation("NrmsGuestInquiryAssignee")
  nrmsMessagingConnections   NrmsMessagingConnection[]     @relation("NrmsMessagingConnectionOwner")
  nrmsReservationGroups      NrmsReservationGroup[]        @relation("NrmsReservationGroupOwner")
  nrmsGroupBlocksOwned       NrmsGroupBlock[]              @relation("NrmsGroupBlockOwner")
  nrmsGroupBlocksCreated     NrmsGroupBlock[]              @relation("NrmsGroupBlockCreator")
  nrmsMasterFoliosOwned      NrmsMasterFolio[]             @relation("NrmsMasterFolioOwner")
  nrmsMasterPaymentsMade     NrmsMasterFolioPayment[]      @relation("NrmsMasterPaymentRecordedBy")
  nrmsMasterRefundsMade      NrmsMasterFolioRefund[]       @relation("NrmsMasterRefundRecordedBy")
  nrmsProFormasCreated       NrmsMasterFolioProForma[]     @relation("NrmsProFormaCreatedBy")
  nrmsProFormasSent          NrmsMasterFolioProForma[]     @relation("NrmsProFormaSentBy")
  nrmsManualBanksOwned       NrmsProFormaBankAccount[]     @relation("NrmsProFormaBankOwner")
  nrmsManualBanksAccepted    NrmsProFormaBankAccount[]     @relation("NrmsProFormaBankPolicyAcceptedBy")
  nrmsRoomingListsMade       NrmsRoomingList[]             @relation("NrmsRoomingListCreator")
  nrmsRoomingListsReviewed   NrmsRoomingList[]             @relation("NrmsRoomingListReviewer")
  nrmsReservationGroupsMade  NrmsReservationGroup[]        @relation("NrmsReservationGroupCreator")
  nrmsGuestProfiles          GuestProfile[]                @relation("NrmsGuestProfileOwner")
  roomUnitStatusChanges      RoomUnitStatusHistory[]       @relation("RoomUnitStatusChangedBy")
  nrmsReservationEvents      ReservationEvent[]            @relation("NrmsReservationEventActor")
  nrmsPaymentsRecorded       ExternalPaymentRecord[]       @relation("NrmsPaymentRecordedBy")
  nrmsChargesPosted          ReservationCharge[]           @relation("NrmsChargePostedBy")
  nrmsExpensesRecorded       NrmsExpense[]                 @relation("NrmsExpenseRecordedBy")
  nrmsStaffMemberships       NrmsStaffMembership[]         @relation("NrmsStaffUser")
  nrmsHkTasksAssigned        NrmsHousekeepingTask[]        @relation("NrmsHkTaskAssignedTo")
  nrmsHkTasksCreated         NrmsHousekeepingTask[]        @relation("NrmsHkTaskCreatedBy")
  nrmsHkTasksCompleted       NrmsHousekeepingTask[]        @relation("NrmsHkTaskCompletedBy")
  nrmsFiscalAcknowledged     NrmsFiscalConnection[]        @relation("NrmsFiscalAcknowledgedBy")
  nrmsFiscalCredentials      NrmsFiscalCredentialVersion[] @relation("NrmsFiscalCredentialCreatedBy")
  nrmsOrdersCreated          NrmsOutletOrder[]             @relation("NrmsOrderCreatedBy")
  nrmsOrdersConfirmed        NrmsOutletOrder[]             @relation("NrmsOrderConfirmedBy")
  nrmsOrdersSettled          NrmsOutletOrder[]             @relation("NrmsOrderSettledBy")
  nrmsTipsReceived           NrmsOutletOrder[]             @relation("NrmsOrderTipRecipient")
  nrmsTipsConfirmed          NrmsOutletOrder[]             @relation("NrmsOrderTipConfirmedBy")
  nrmsBusinessDaysOpened     NrmsBusinessDay[]             @relation("NrmsBusinessDayOpenedBy")
  nrmsBusinessDaysClosed     NrmsBusinessDay[]             @relation("NrmsBusinessDayClosedBy")
  nrmsNightAuditsStarted     NrmsNightAuditRun[]           @relation("NrmsNightAuditStartedBy")
  nrmsNightAuditsClosed      NrmsNightAuditRun[]           @relation("NrmsNightAuditClosedBy")
  nrmsCashierShifts          NrmsCashierShift[]            @relation("NrmsCashierShiftUser")
  nrmsCashierApprovals       NrmsCashierShift[]            @relation("NrmsCashierShiftApprovedBy")
  nrmsCashierSignOffs        NrmsCashierShift[]            @relation("NrmsCashierShiftSignedOffBy")
  nrmsPaygAccounts           OwnerPaygAccount[]            @relation("NrmsPaygAccountOwner")
  nrmsAgentAccounts          NrmsAgentAccount[]            @relation("NrmsAgentPrimaryUser")
  guestSmsPreferences        GuestSmsPreference[]          @relation("GuestSmsPreferenceOwner")
  guestSmsCampaigns          GuestSmsCampaign[]            @relation("GuestSmsCampaignOwner")
  guestSmsAnnualQuotas       GuestSmsAnnualQuota[]         @relation("GuestSmsAnnualQuotaOwner")
  channelMappingsCreated     ChannelPropertyMapping[]      @relation("ChannelPropertyMappingCreatedBy")
  channelCredentialsCreated  ChannelCredentialVersion[]    @relation("ChannelCredentialCreatedBy")
  channelIssuesResolved      ChannelReconciliationIssue[]  @relation("ChannelIssueResolvedBy")

  // Sales partner workspace. Access is an entitlement on the ordinary user
  // account; User.role is never changed to grant it.
  workspaceAccess               UserWorkspaceAccess[]      @relation("WorkspaceUser")
  workspaceAccessGranted        UserWorkspaceAccess[]      @relation("WorkspaceGrantedBy")
  workspaceAccessRevoked        UserWorkspaceAccess[]      @relation("WorkspaceRevokedBy")
  salesPartnerProfile           SalesPartnerProfile?       @relation("SalesPartnerUser")
  salesContractsCreated         SalesPartnerContract[]     @relation("SalesContractCreatedBy")
  salesLeadsConverted           SalesLead[]                @relation("SalesLeadConvertedBy")
  salesLeadActivities           SalesLeadActivity[]        @relation("SalesLeadActivityAuthor")
  salesAttributionsVerified     PropertySalesAttribution[] @relation("SalesAttributionVerifiedBy")
  salesCommissionsApproved      SalesCommission[]          @relation("SalesCommissionApprovedBy")
  salesPayoutsReviewed          SalesPayoutRequest[]       @relation("SalesPayoutReviewedBy")
  salesMaterialsCreated         SalesMaterial[]            @relation("SalesMaterialCreatedBy")
  payoutAccounts                PayoutAccount[]            @relation("PayoutAccountOwner")
  disbursementsApproved         Disbursement[]             @relation("DisbursementApprovedBy")
  disbursementBatchesFormed     DisbursementBatch[]        @relation("DisbursementBatchFormedBy")
  disbursementBatchesAuthorized DisbursementBatch[]        @relation("DisbursementBatchAuthorizedBy")

  // Payment orchestration (see PAYMENT ORCHESTRATION CORE below)
  merchantEntitiesAdministered MerchantLegalEntity[] @relation("MerchantLegalEntityAdmin")
  merchantApplicationsReviewed MerchantApplication[] @relation("MerchantApplicationReviewer")
  merchantPolicyAcceptances    PolicyAcceptance[]    @relation("PolicyAcceptanceUser")
  paymentRefundsRequested      PaymentRefund[]       @relation("PaymentRefundRequestedBy")
  paymentRefundsApproved       PaymentRefund[]       @relation("PaymentRefundApprovedBy")
  merchantAuditEvents          MerchantAuditEvent[]  @relation("MerchantAuditActor")

  @@index([role])
  @@index([role, registrationStatus])
  @@index([registrationSource])
  @@index([email])
  @@index([phone])
  @@index([suspendedAt])
  @@index([kycStatus])
  @@index([referredBy])
  @@index([deletedAt])
  @@map("user")
}

// =========================================================
//  PROPERTY MODEL
// =========================================================
model TourismSite {
  id      Int    @id @default(autoincrement())
  slug    String @unique @db.VarChar(160)
  name    String @db.VarChar(200)
  country String @default("Tanzania") @db.VarChar(120)

  // Optional metadata for future enhancements
  description String?  @db.Text
  latitude    Decimal? @db.Decimal(10, 6)
  longitude   Decimal? @db.Decimal(10, 6)

  // Relations
  properties Property[]

  @@index([country])
  @@index([slug])
  @@map("tourismsite")
}

model Property {
  id      Int    @id @default(autoincrement())
  ownerId Int
  status  String @default("DRAFT") // DRAFT, PENDING, APPROVED, REJECTED, SUSPENDED
  title   String @db.VarChar(200)
  type    String // VILLA, APARTMENT, HOTEL, LODGE, CONDO, GUEST_HOUSE, BUNGALOW, CABIN, HOMESTAY, TOWNHOUSE, HOUSE, OTHER

  // Tourism / park placement (optional)
  tourismSiteId Int?
  parkPlacement String? @db.VarChar(20) // INSIDE, NEARBY

  // Location
  regionId   String?  @db.VarChar(50)
  regionName String?  @db.VarChar(120)
  district   String?  @db.VarChar(120)
  ward       String?  @db.VarChar(120)
  street     String?  @db.VarChar(200)
  apartment  String?  @db.VarChar(120)
  city       String?  @db.VarChar(120)
  zip        String?  @db.VarChar(30)
  country    String?  @default("Tanzania") @db.VarChar(120)
  latitude   Decimal? @db.Decimal(10, 6)
  longitude  Decimal? @db.Decimal(10, 6)

  // Media & details
  description  String? @db.Text
  photos       Json? // Array of URLs (legacy, use PropertyImage now)
  hotelStar    String? // basic, simple, moderate, high, luxury
  buildingType String? // SINGLE_STORY, LOW_RISE, MID_RISE, HIGH_RISE, VILLA_COMPLEX, LODGE_CAMPUS
  totalFloors  Int? // Total number of floors (auto-calculated or manual)
  roomsSpec    Json? // Room types, beds, price/night, images... (includes floor info)
  services     Json? // Parking/breakfast/etc + nearbyFacilities[]
  layout       Json? // Auto-generated SVG/plan metadata

  // Aggregates / pricing
  basePrice      Decimal? @db.Decimal(12, 2)
  currency       String?  @default("TZS") @db.VarChar(3)
  totalBedrooms  Int?
  totalBathrooms Int?
  maxGuests      Int?

  // Moderation history
  lastSubmittedAt  DateTime?
  rejectionReasons Json? // Array of strings

  /// NRMS operational activation timestamp. Starts the 45-day PAYG trial clock
  /// for this property (NRMS doc section 8.2). NULL = property not NRMS-activated;
  /// owner-level access is governed by OwnerServiceEnrollment.
  nrmsActivatedAt DateTime?

  /// Daily occupied-room service. At this local property time, checked-in
  /// rooms enter the housekeeping cycle once per calendar day.
  housekeepingDailyServiceEnabled  Boolean   @default(true)
  housekeepingDailyServiceTime     String    @default("11:00") @db.VarChar(5)
  housekeepingLastDailyServiceDate DateTime?

  /// How guests pay the property directly for QR outlet orders: the hotel's
  /// own Lipa Namba, bank account, card-at-counter note and so on. Money never
  /// touches NoLSAF rails. Array of { label, value, name? }.
  nrmsGuestPayInstructions Json?

  /// Public, property-specific reception channels used by the direct booking
  /// page. Kept separate from the owner's personal User phone/email. Shape is
  /// validated at the API boundary; see nrmsGuestContact.ts.
  nrmsGuestContactSettings Json?

  /// Which verified-stay review categories this property asks departing guests
  /// about. Array of keys from NRMS_REVIEW_CATEGORIES, chosen by the owner so a
  /// property without a restaurant is never asked to rate one. Null means the
  /// safe default set. See apps/api/src/lib/nrmsReviewCategories.ts.
  nrmsReviewCategories Json?

  /// Admin enforcement (NRMS_ADMIN_OVERSIGHT.md phase 2): when set, the public
  /// QR menu and ordering surface is refused for this property while staff
  /// ordering continues unaffected.
  nrmsQrOrderingFrozenAt DateTime?

  /// Owner opt-in: shows a "View live menu" link on this property's public
  /// listing page, pointing at a read-only preview of the same guest QR menu
  /// (a NrmsOrderPoint of type PREVIEW, orderingEnabled false). Off by
  /// default — publishing the menu is a choice, not a side effect of
  /// activating NRMS.
  nrmsMenuPublic Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner              User                        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tourismSite        TourismSite?                @relation(fields: [tourismSiteId], references: [id], onDelete: SetNull)
  bookings           Booking[]
  transportBookings  TransportBooking[]
  groupBookings      GroupBooking[]
  groupBookingClaims GroupBookingClaim[]
  images             PropertyImage[]
  verification       PropertyVerification?
  reviews            PropertyReview[]
  savedBy            SavedProperty[]
  propertyShares     PropertyShare[]
  availabilityBlocks PropertyAvailabilityBlock[]

  // NRMS (normalized room inventory + operational reservations)
  roomTypes                RoomType[]
  roomUnits                RoomUnit[]
  nrmsReservations         Reservation[]
  nrmsReservationGroups    NrmsReservationGroup[]
  nrmsGroupBlocks          NrmsGroupBlock[]
  nrmsMasterFolios         NrmsMasterFolio[]
  nrmsProFormaBankAccount  NrmsProFormaBankAccount?
  guestProfiles            GuestProfile[]
  nrmsPaygAccount          OwnerPaygAccount?
  nrmsUsageEvents          NrmsUsageEvent[]
  nrmsSmsCampaigns         GuestSmsCampaign[]
  nrmsOutlets              NrmsOutlet[]
  nrmsStaff                NrmsStaffMembership[]
  nrmsOutletOrders         NrmsOutletOrder[]
  nrmsBusinessDays         NrmsBusinessDay[]
  nrmsNightAudits          NrmsNightAuditRun[]
  nrmsCashierShifts        NrmsCashierShift[]
  nrmsLedgerTransactions   NrmsLedgerTransaction[]
  nrmsHousekeepingTasks    NrmsHousekeepingTask[]
  nrmsOrderPoints          NrmsOrderPoint[]
  nrmsFiscalConnection     NrmsFiscalConnection?
  nrmsFiscalReceipts       NrmsFiscalReceipt[]
  nrmsIntegritySignals     NrmsIntegritySignal[]
  nrmsPublicMetrics        NrmsPublicMetric[]
  channelConnections       ChannelConnection[]
  nrmsRatePlans            NrmsRatePlan[]
  nrmsRateRestrictions     NrmsRateRestriction[]
  nrmsOnboardingRuns       NrmsOnboardingRun[]
  nrmsServiceCases         NrmsServiceCase[]
  nrmsGuestInquiries       NrmsGuestInquiry[]
  nrmsMessagingConnections NrmsMessagingConnection[]
  nrmsOfflineMutations     NrmsOfflineMutation[]
  nrmsExpenses             NrmsExpense[]
  nrmsPortfolioLinks       NrmsPortfolioProperty[]
  nrmsForecastSnapshots    NrmsForecastSnapshot[]
  nrmsPricingGuidance      NrmsPricingRecommendation[]
  nrmsLoyaltyAccounts      NrmsLoyaltyAccount[]
  nrmsReviewRequests       NrmsReviewRequest[]
  nrmsJourneyTemplates     NrmsJourneyTemplate[]
  nrmsAgentLinks           NrmsAgentPropertyLink[]

  // Sales partner attribution and earnings generated by this property
  salesLeadConversions SalesLead[]                @relation("SalesLeadConvertedProperty")
  salesAttributions    PropertySalesAttribution[]
  salesCommissions     SalesCommission[]

  // Payment orchestration (see PAYMENT ORCHESTRATION CORE below)
  merchantLinks  MerchantPropertyLink[]
  paymentIntents PaymentIntent[]

  @@index([ownerId])
  // Supports: WHERE ownerId=? ORDER BY id DESC
  @@index([ownerId, id], map: "idx_Property_ownerId_id")
  @@index([status])
  @@index([tourismSiteId])
  @@index([status, tourismSiteId, parkPlacement, id], map: "idx_Property_status_tourismSite_placement_id")
  // Supports: WHERE status=? ORDER BY basePrice {asc|desc}, id DESC
  @@index([status, basePrice, id], map: "idx_Property_status_basePrice_id")
  // Supports: WHERE ownerId=? AND status=? ORDER BY id DESC
  @@index([ownerId, status, id], map: "idx_Property_ownerId_status_id")
  @@index([type])
  @@index([regionId])
  @@index([regionName])
  @@index([district])
  @@index([ward])
  @@index([createdAt]) // For sorting by newest and time-based queries
  @@index([status, createdAt, regionId])
  // Location indexes for map functionality
  @@index([latitude])
  @@index([longitude])
  @@index([latitude, longitude]) // Composite index for location-based queries
  @@index([status, latitude, longitude]) // For filtering approved properties with locations
  @@map("property")
}

model PropertyVerification {
  id         Int       @id @default(autoincrement())
  propertyId Int       @unique
  status     String    @default("PENDING") @db.VarChar(30) // PENDING, VERIFIED, REJECTED
  verifiedAt DateTime?
  verifiedBy Int?
  method     String?   @db.VarChar(120)
  note       String?   @db.Text
  checklist  Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  verifier User?    @relation("PropertyVerificationVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([verifiedAt])
  @@index([verifiedBy])
  @@map("property_verification")
}

// =========================================================
//  BOOKING MODEL
// =========================================================
model Booking {
  id         Int    @id @default(autoincrement())
  propertyId Int
  userId     Int? // Customer account (optional if walk-in)
  driverId   Int? // Assigned driver (optional)
  status     String @default("NEW") // NEW, CONFIRMED, CHECKED_IN, CHECKED_OUT, CANCELED

  // Transport summary (denormalized; authoritative trip data lives in TransportBooking)
  includeTransport       Boolean   @default(false)
  transportVehicleType   String?   @db.VarChar(20)
  transportScheduledDate DateTime?
  transportOriginAddress String?   @db.VarChar(255)
  transportFare          Decimal?  @db.Decimal(12, 2)

  checkIn     DateTime
  checkOut    DateTime
  totalAmount Decimal  @default(0.00) @db.Decimal(12, 2)
  roomsQty    Int      @default(1)
  roomCode    String?  @db.VarChar(60) // Optional internal code/unit

  // Guest snapshot (for owners scanning codes)
  guestName   String? @db.VarChar(160)
  guestPhone  String? @db.VarChar(40)
  nationality String? @db.VarChar(80)
  sex         String? @db.VarChar(20)
  ageGroup    String? @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  property             Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  driver               User?                 @relation("BookingDriver", fields: [driverId], references: [id], onDelete: SetNull)
  code                 CheckinCode?
  invoices             Invoice[]
  reviews              PropertyReview[]
  referralEarnings     ReferralEarning[]
  propertyShares       PropertyShare[]
  cancellationRequests CancellationRequest[]
  tripEstimates        TripEstimate[]

  /// NRMS operational view of this marketplace booking (NRMS doc section 6.5).
  /// Booking remains the commercial source of truth; the linked Reservation only
  /// carries room allocation and stay operations. Never duplicates money fields.
  nrmsReservation Reservation?

  @@index([propertyId])
  @@index([propertyId, checkIn, checkOut])
  @@index([userId])
  @@index([driverId])
  @@index([status])
  @@index([checkIn])
  @@index([checkOut])
  @@index([createdAt]) // For time-based queries (e.g., bookings in last 24h)
  @@index([status, checkIn])
  @@index([status, createdAt]) // For filtering by status and creation time
  @@index([propertyId, status, checkOut], map: "idx_Booking_property_status_checkOut")
  @@index([includeTransport])
  @@index([includeTransport, transportScheduledDate])
  @@map("booking")
}

// =========================================================
//  CHECK-IN CODE MODEL - Single-use codes (one per booking)
// =========================================================
model CheckinCode {
  id          Int       @id @default(autoincrement())
  bookingId   Int       @unique // 1:1 booking→code
  code        String    @db.VarChar(32) // Human-readable code (e.g., ABCD9F3A)
  codeHash    String    @db.VarChar(128) // SHA-256 hash for verification
  codeVisible String?   @db.VarChar(32) // Alias for code (backward compatibility)
  status      String    @default("ACTIVE") // ACTIVE, USED, VOID
  generatedAt DateTime  @default(now())
  issuedAt    DateTime? // When code was sent to customer
  usedAt      DateTime?
  usedByOwner Boolean? // Whether code was validated by an owner
  voidReason  String?   @db.VarChar(255) // Reason for voiding
  voidedAt    DateTime? // When code was voided

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([codeHash])
  @@unique([code])
  @@index([status])
  @@index([generatedAt])
  @@index([code])
  @@map("checkincode")
}

// =========================================================
//  INVOICE MODEL - Invoices / Payouts
// =========================================================
model Invoice {
  id        Int    @id @default(autoincrement())
  ownerId   Int // Owner to be paid
  bookingId Int // Source booking
  status    String @default("DRAFT") // DRAFT, REQUESTED, VERIFIED, APPROVED, PAID, REJECTED, PROCESSING

  total             Decimal  @default(0.00) @db.Decimal(12, 2)
  commissionPercent Decimal? @db.Decimal(5, 2)
  commissionAmount  Decimal? @db.Decimal(12, 2)
  taxPercent        Decimal? @db.Decimal(5, 2)
  netPayable        Decimal? @db.Decimal(12, 2)

  invoiceNumber String? @unique @db.VarChar(50)
  receiptNumber String? @unique @db.VarChar(50)

  issuedAt   DateTime  @default(now())
  verifiedAt DateTime?
  approvedAt DateTime?
  paidAt     DateTime?

  verifiedBy Int?
  approvedBy Int?
  paidBy     Int?

  paymentMethod     String? @db.VarChar(40) // BANK, MPESA, TIGOPESA, CARD...
  paymentRef        String? @unique @db.VarChar(80) // Gateway merchant ref (set at PROCESSING)
  checkoutSessionId String? @unique @db.VarChar(120) // AzamPay transactionId
  payerPhone        String? @db.VarChar(40) // Phone used for MNO payment
  notes             String? @db.Text

  receiptQrPayload String?   @db.Text
  receiptQrPng     Bytes? // PNG bytes (LONGBLOB)
  /// Immutable financial and settlement facts captured when the payout first
  /// reaches PAID. Receipt rendering must read this snapshot, never mutable
  /// booking/invoice fields.
  receiptSnapshot  Json?
  receiptIssuedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  booking          Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  verifiedByUser   User?             @relation("InvoiceVerifiedBy", fields: [verifiedBy], references: [id], onDelete: SetNull)
  approvedByUser   User?             @relation("InvoiceApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  paidByUser       User?             @relation("InvoicePaidBy", fields: [paidBy], references: [id], onDelete: SetNull)
  paymentEvents    PaymentEvent[]
  referralEarnings ReferralEarning[]

  @@index([status])
  @@index([ownerId])
  @@index([bookingId])
  @@index([issuedAt])
  @@index([paidAt])
  @@index([status, issuedAt])
  @@index([checkoutSessionId])
  @@map("invoice")
}

// =========================================================
//  ADMIN IP ALLOWLIST MODEL
// =========================================================
model AdminIpAllow {
  id        Int      @id @default(autoincrement())
  cidr      String   @db.VarChar(64) // e.g., '197.250.10.20/32' or '10.10.0.0/16'
  note      String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  @@map("adminipallow")
}

// =========================================================
//  AUDIT LOG MODEL
// =========================================================
model AuditLog {
  id              BigInt    @id @default(autoincrement())
  actorId         Int?
  actorRole       String? // ADMIN, OWNER, CUSTOMER, DRIVER
  action          String    @db.VarChar(80) // e.g., PROPERTY_APPROVE
  entity          String    @db.VarChar(200) // e.g., PROPERTY, BOOKING, INVOICE or OTP:PHONE:+255xxx:sha256hash
  entityId        Int?
  beforeJson      Json?
  afterJson       Json?
  ip              String?   @db.VarChar(64)
  ua              String?   @db.VarChar(255)
  retentionClass  String    @default("OPERATIONAL") @db.VarChar(20)
  expiresAt       DateTime?
  legalHoldAt     DateTime?
  legalHoldReason String?   @db.VarChar(500)
  createdAt       DateTime  @default(now())

  // Relations
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity, entityId])
  @@index([entity, entityId, id], map: "idx_AuditLog_entity_entityId_id")
  @@index([createdAt])
  @@index([expiresAt, legalHoldAt])
  @@index([retentionClass, expiresAt])
  @@map("auditlog")
}

// =========================================================
//  ADMIN AUDIT MODEL - For admin action tracking
// =========================================================
model AdminAudit {
  id              Int       @id @default(autoincrement())
  adminId         Int? // Admin who performed the action; preserved as null if the account is removed
  targetUserId    Int? // User being acted upon (optional)
  performedBy     Int? // Alternative field name (alias for adminId in some cases)
  action          String    @db.VarChar(80) // e.g., SUSPEND_DRIVER, GRANT_BONUS, KYC_APPROVE
  details         Json? // JSON object or string details
  retentionClass  String    @default("OPERATIONAL") @db.VarChar(20)
  expiresAt       DateTime?
  legalHoldAt     DateTime?
  legalHoldReason String?   @db.VarChar(500)
  createdAt       DateTime  @default(now())

  // Relations
  admin User? @relation("AdminAudits", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
  @@index([expiresAt, legalHoldAt])
  @@index([retentionClass, expiresAt])
  @@map("adminaudit")
}

/// Durable workflow and SLA state for Action Center records. Business source
/// tables remain authoritative; this model stores operational ownership,
/// response timing, and resolution evidence across those different domains.
model AdminWorkItem {
  id                      Int       @id @default(autoincrement())
  sourceType              String    @db.VarChar(60)
  sourceId                String    @db.VarChar(120)
  category                String    @db.VarChar(40)
  title                   String    @db.VarChar(240)
  summary                 String    @db.Text
  subject                 String    @db.VarChar(240)
  detailHref              String    @db.VarChar(500)
  actionLabel             String    @db.VarChar(80)
  severity                String    @db.VarChar(20)
  status                  String    @default("OPEN") @db.VarChar(20) // OPEN, ACKNOWLEDGED, RESOLVED
  slaPolicyVersion        String    @default("2026-08") @db.VarChar(20)
  responseTargetMinutes   Int
  resolutionTargetMinutes Int
  openedAt                DateTime
  responseDueAt           DateTime
  resolutionDueAt         DateTime
  operationalDueAt        DateTime?
  acknowledgedAt          DateTime?
  acknowledgedById        Int?
  assignedToId            Int?
  assignedTeam            String?   @db.VarChar(80)
  resolvedAt              DateTime?
  resolvedById            Int?
  resolutionNote          String?   @db.VarChar(1000)
  retentionClass          String    @default("OPERATIONAL") @db.VarChar(20)
  expiresAt               DateTime?
  legalHoldAt             DateTime?
  legalHoldReason         String?   @db.VarChar(500)
  lastObservedAt          DateTime
  metadata                Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  assignedTo User? @relation("AdminWorkItemAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@unique([sourceType, sourceId])
  @@index([status, severity])
  @@index([assignedTeam, status])
  @@index([assignedToId, status])
  @@index([responseDueAt, status])
  @@index([resolutionDueAt, status])
  @@index([lastObservedAt])
  @@index([expiresAt, legalHoldAt])
  @@map("admin_work_item")
}

/// Immutable reference and lifecycle record for administrative restrictions.
/// The restricted business tables remain authoritative for access checks; this
/// ledger gives owners, support, and administrators one durable appeal code
/// across marketplace property, NRMS enrollment, NRMS property, and QR freezes.
model PlatformRestrictionCase {
  id                      Int       @id @default(autoincrement())
  referenceCode           String    @unique @db.VarChar(48)
  activeKey               String?   @unique @db.VarChar(80)
  scope                   String    @db.VarChar(40)
  status                  String    @default("OPEN") @db.VarChar(20) // OPEN, RESOLVED
  ownerId                 Int
  targetId                Int
  propertyId              Int?
  reason                  String    @db.VarChar(300)
  appliedByAdminId        Int?
  appliedAt               DateTime  @default(now())
  resolvedByAdminId       Int?
  resolvedAt              DateTime?
  resolutionNote          String?   @db.VarChar(300)
  notificationEmailSentAt DateTime?
  notificationEmailError  String?   @db.VarChar(500)
  resolutionEmailSentAt   DateTime?
  resolutionEmailError    String?   @db.VarChar(500)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([scope, targetId, status])
  @@index([ownerId, status])
  @@index([propertyId, status])
  @@index([createdAt])
  @@map("platform_restriction_case")
}

