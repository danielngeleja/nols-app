}

/// Auditable request for a hotel-direct payment. This records and reminds;
/// ExternalPaymentRecord remains the immutable record of money received.
model NrmsGuestPaymentRequest {
  id             Int       @id @default(autoincrement())
  reservationId  Int
  kind           String    @default("DEPOSIT") @db.VarChar(20)
  amount         Decimal   @db.Decimal(12, 2)
  currency       String    @default("TZS") @db.VarChar(3)
  status         String    @default("PENDING") @db.VarChar(20)
  publicToken    String    @unique @db.VarChar(80)
  dueAt          DateTime?
  instructions   Json?
  reminderCount  Int       @default(0)
  lastReminderAt DateTime?
  settledAt      DateTime?
  cancelledAt    DateTime?
  createdById    Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, status])
  @@index([status, dueAt])
  @@map("nrms_guest_payment_request")
}
