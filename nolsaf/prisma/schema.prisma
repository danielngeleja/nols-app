/// One property-scoped pre-booking conversation or channel handoff. Social
/// provider identifiers are nullable until the Meta/WhatsApp adapters are
/// connected; WEB requests are already actionable without either provider.
model NrmsGuestInquiry {
  id                     Int       @id @default(autoincrement())
  propertyId             Int
  ownerId                Int
  reference              String    @unique @db.VarChar(40)
  sessionRef             String?   @db.VarChar(100)
  channel                String    @db.VarChar(20) // WEB, INSTAGRAM, WHATSAPP, PHONE, EMAIL
  source                 String    @default("DIRECT") @db.VarChar(20)
  externalConversationId String?   @db.VarChar(191)
  /// Deterministic property + channel + sender fingerprint while this social
  /// conversation is active. It is cleared on close/conversion so a later
  /// conversation from the same guest can open a fresh inquiry.
  activeConversationKey  String?   @unique(map: "nrms_guest_inquiry_active_conversation_key") @db.VarChar(64)
  guestName              String?   @db.VarChar(160)
  guestHandle            String?   @db.VarChar(160)
  guestPhone             String?   @db.VarChar(40)
  guestEmail             String?   @db.VarChar(160)
  intent                 String    @default("AVAILABILITY") @db.VarChar(30)
  status                 String    @default("NEW") @db.VarChar(20) // NEW, OPEN, WAITING_GUEST, RESOLVED, CONVERTED, CLOSED
  checkIn                DateTime? @db.Date
  checkOut               DateTime? @db.Date
  adults                 Int       @default(1)
  children               Int       @default(0)
  roomTypeId             Int?
  reservationId          Int?      @unique
  assignedToId           Int?
  autoAcknowledgedAt     DateTime?
  firstResponseAt        DateTime?
  lastMessageAt          DateTime?
  convertedAt            DateTime?
  closedAt               DateTime?
  version                Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  property    Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner       User               @relation("NrmsGuestInquiryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  roomType    RoomType?          @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  reservation Reservation?       @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  assignedTo  User?              @relation("NrmsGuestInquiryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages    NrmsGuestMessage[]

  @@unique([propertyId, sessionRef, channel], map: "nrms_guest_inquiry_property_session_channel_key")
  @@index([propertyId, status, lastMessageAt, createdAt], map: "nrms_guest_inquiry_property_status_activity_idx")
  @@index([propertyId, channel, createdAt], map: "nrms_guest_inquiry_property_channel_created_idx")
  @@index([assignedToId, status])
  @@index([externalConversationId])
  @@map("nrms_guest_inquiry")
}

/// Provider-neutral transcript. providerMessageId makes webhook retries
/// idempotent once Instagram/WhatsApp delivery is enabled.
model NrmsGuestMessage {
  id                Int       @id @default(autoincrement())
  inquiryId         Int
  direction         String    @db.VarChar(20) // INBOUND, OUTBOUND, SYSTEM, INTERNAL
  channel           String    @db.VarChar(20)
  providerMessageId String?   @unique @db.VarChar(191)
  senderName        String?   @db.VarChar(160)
  body              String    @db.Text
  deliveryStatus    String    @default("RECORDED") @db.VarChar(20)
  attemptCount      Int       @default(0)
  nextAttemptAt     DateTime?
  lastAttemptAt     DateTime?
  errorMessage      String?   @db.VarChar(1000)
  sentById          Int?
  metadata          Json?
  createdAt         DateTime  @default(now())

  inquiry NrmsGuestInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt])
  @@index([sentById, createdAt])
  @@index([deliveryStatus, nextAttemptAt, createdAt], map: "nrms_guest_message_delivery_retry_idx")
  @@map("nrms_guest_message")
}

/// Durable, provider-neutral inbox for normalized Meta webhook events. The
/// HTTP endpoint only verifies and persists events; a leader-elected worker
/// performs business processing, retries transient failures, and retains dead
/// jobs for deliberate replay instead of losing guest messages.
model NrmsMetaWebhookJob {
  id           Int       @id @default(autoincrement())
  dedupeKey    String    @unique @db.VarChar(191)
  propertyId   Int?
  provider     String    @db.VarChar(20)
  accountId    String    @db.VarChar(191)
  eventKind    String    @db.VarChar(20)
  payload      Json
  status       String    @default("PENDING") @db.VarChar(20) // PENDING, PROCESSING, RETRY, COMPLETED, DEAD
  attemptCount Int       @default(0)
  availableAt  DateTime  @default(now())
  lockedAt     DateTime?
  completedAt  DateTime?
  lastError    String?   @db.VarChar(1000)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, availableAt, createdAt], map: "nrms_meta_webhook_job_ready_idx")
  @@index([status, completedAt], map: "nrms_meta_webhook_job_completed_idx")
  @@index([propertyId, status, createdAt], map: "nrms_meta_webhook_job_property_status_idx")
  @@index([provider, accountId, createdAt], map: "nrms_meta_webhook_job_account_idx")
  @@map("nrms_meta_webhook_job")
}

