// =========================================================
//  NoLSAF: Complete Prisma Schema
//  Consolidated schema with all models and relations
//  Target: MySQL 8+
// =========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// =========================================================
//  PUBLIC UPDATES (Latest Updates)
// =========================================================
model SiteUpdate {
  id        String   @id @db.VarChar(64)
  title     String   @db.VarChar(200)
  content   String   @db.Text
  images    Json?
  videos    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("site_updates")
}

// =========================================================
//  USER MODEL - One table for admins, owners, drivers, and customers
// =========================================================
model User {
  id                Int       @id @default(autoincrement())
  role              String    @default("CUSTOMER") // ADMIN, OWNER, DRIVER, CUSTOMER, AGENT
  name              String?
  /// Human-friendly display name (used by newer UI)
  fullName          String?   @db.VarChar(160)
  email             String?   @unique
  phone             String?   @unique
  passwordHash      String?
  /// Profile avatar image URL (Cloudinary, etc.)
  avatarUrl         String?   @db.VarChar(500)
  /// User timezone (e.g., Africa/Dar_es_Salaam)
  timezone          String?   @db.VarChar(80)
  /// Preferred display currency (ISO 4217, e.g. "TZS"). Presentation only — never the money of record.
  preferredCurrency String?   @default("TZS") @db.VarChar(3)
  /// Date of birth (date-only)
  dateOfBirth       DateTime? @db.Date
  /// Location fields used by driver onboarding/profile UI
  region            String?   @db.VarChar(120)
  district          String?   @db.VarChar(120)
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?

  // Owner / business details
  tin     String? @db.VarChar(50)
  address String? @db.VarChar(500)

  // Driver identity + onboarding details
  gender      String? @db.VarChar(20)
  nationality String? @db.VarChar(80)
  nin         String? @db.VarChar(50)

  // Driver vehicle / license details
  licenseNumber   String?  @db.VarChar(80)
  plateNumber     String?  @db.VarChar(30)
  vehicleType     String?  @db.VarChar(50)
  vehicleMake     String?  @db.VarChar(100)
  vehiclePlate    String?  @db.VarChar(30)
  operationArea   String?  @db.VarChar(200)
  paymentPhone    String?  @db.VarChar(30)
  paymentVerified Boolean? @default(false)

  // Two-Factor Authentication
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?
  twoFactorMethod  String? // TOTP, SMS, etc.
  totpSecretEnc    String? // Encrypted TOTP secret
  backupCodesHash  Json? // Array of hashed backup codes
  sms2faEnabled    Boolean? @default(false)

  // Password Management
  previousPasswordHashes Json? // Array of previous password hashes
  previousPasswords      Json? // Alternative field name
  resetPasswordToken     String?
  resetPasswordExpires   DateTime?
  // Global token-invalidation cutoff. Any JWT whose `iat` predates this instant
  // is rejected at auth time. Bumped on password reset/change (force-logout) and
  // "sign out other devices" so those actions actually revoke already-issued
  // tokens. NULL (default) means no cutoff, so existing tokens are unaffected.
  tokensValidAfter       DateTime?

  // Account Status
  suspendedAt       DateTime?
  isDisabled        Boolean?  @default(false)
  kycStatus         String? // PENDING_KYC, APPROVED_KYC, REJECTED_KYC
  kycNote           String? // Admin note sent with request_info action
  kycFieldApprovals Json? // Per-field admin review map: { fieldName: "approved"|"flagged" }

  // Driver-specific fields
  rating      Decimal? @db.Decimal(3, 2) // Driver rating (e.g., 4.5)
  available   Boolean? @default(true) // Driver availability
  isAvailable Boolean? @default(true) // Alternative field name

  /// VIP driver flag (required for PREMIUM/VIP transport claims)
  isVipDriver Boolean @default(false)

  // Payout/Banking details for owners (JSON lets us store momo/bank variants)
  payout Json?

  // Referral system
  referredBy   Int? // Driver who referred this user
  referralCode String? // Referral code used

  /// Per-user notification preferences, e.g. { "bookings": true, "promotions": false, "referrals": true }
  notificationPrefs Json?

  /// Spoken languages, e.g. ["sw", "en"]. For drivers: languages they can communicate in.
  /// For customers: languages they'd like their driver to speak (used to match against driver.languages).
  languages Json?

  /// Driver weekly goals set by the driver, synced across devices, e.g. { "trips": 20, "money": 150000, "moneyUrgent": false }
  driverGoals Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  // Properties owned by this user (if owner)
  properties Property[]

  // Bookings made by this user (if customer)
  bookings     Booking[]
  tourBookings TourBooking[] @relation("UserTourBookings")

  // Bookings assigned to this user as a driver (optional)
  driverBookings Booking[] @relation("BookingDriver")

  /// Claims submitted by this driver for transport bookings
  transportBookingClaims TransportBookingClaim[] @relation("DriverTransportBookingClaims")

  /// Transport booking claims reviewed by this user (admin)
  reviewedTransportBookingClaims TransportBookingClaim[] @relation("TransportBookingClaimReviews")

  // Invoices for this user (if owner)
  invoices         Invoice[]
  invoicesVerified Invoice[] @relation("InvoiceVerifiedBy")
  invoicesApproved Invoice[] @relation("InvoiceApprovedBy")
  invoicesPaid     Invoice[] @relation("InvoicePaidBy")

  // Group bookings
  groupBookings              GroupBooking[]
  assignedGroupBookings      GroupBooking[]      @relation("GroupBookingOwner")
  groupBookingClaims         GroupBookingClaim[] @relation("GroupBookingClaims")
  reviewedGroupBookingClaims GroupBookingClaim[] @relation("GroupBookingClaimReviews")

  // Transport bookings as customer
  transportBookingsAsCustomer TransportBooking[] @relation("UserTransportBookings")

  // Transport bookings as driver
  transportBookingsAsDriver TransportBooking[] @relation("DriverTransportBookings")

  // Targeted offers for instant auto-dispatch (driver receives offers)
  transportBookingOffers TransportBookingOffer[] @relation("DriverTransportBookingOffers")

  // Transport payout records (driver earnings for transport trips)
  transportPayouts         TransportPayout[] @relation("TransportPayoutDriver")
  approvedTransportPayouts TransportPayout[] @relation("TransportPayoutApprover")
  paidTransportPayouts     TransportPayout[] @relation("TransportPayoutPayer")

  // Property reviews written by this user
  propertyReviews       PropertyReview[]
  propertyVerifications PropertyVerification[] @relation("PropertyVerificationVerifier")

  // Agent reviews written by this user
  agentReviewsWritten AgentReview[] @relation("AgentReviewsUser")

  // User documents (KYC)
  documents UserDocument[]

  // Passkeys for passwordless authentication
  passkeys Passkey[]

  // Saved properties (favorites)
  savedProperties SavedProperty[]

  // Audit logs where this user is the actor
  auditLogs AuditLog[]

  // Referral earnings (as driver)
  referralEarningsAsDriver ReferralEarning[] @relation("DriverReferrals")

  // Referral earnings (as referred user)
  referralEarningsAsReferred ReferralEarning[] @relation("ReferredUsers")

  // Referral withdrawals (as driver)
  referralWithdrawals ReferralWithdrawal[] @relation("DriverWithdrawals")

  // Driver reminders (for drivers)
  driverReminders DriverReminder[]

  // Referral withdrawals processed by this admin
  referralWithdrawalsProcessed ReferralWithdrawal[] @relation("ProcessedWithdrawals")

  // Notifications for this user
  notifications Notification[]

  // Owner-specific notifications (legacy)
  ownerNotifications Notification[] @relation("OwnerNotifications")

  // Admin audits performed by this user (if admin)
  adminAudits          AdminAudit[]          @relation("AdminAudits")
  // Group booking audits performed by this admin
  groupBookingAudits   GroupBookingAudit[]   @relation("GroupBookingAudits")
  // Group booking messages sent by this user/admin
  groupBookingMessages GroupBookingMessage[] @relation("GroupBookingMessages")

  // Property availability blocks created by this owner
  propertyAvailabilityBlocks PropertyAvailabilityBlock[] @relation("PropertyAvailabilityBlocks")

  // User sessions
  sessions Session[] @relation("UserSessions")

  // Live driver map (for DRIVER role)
  driverLiveLocation  DriverLiveLocation?
  driverLocationPings DriverLocationPing[]

  // Admin 2FA OTPs (for finance actions)
  adminOtps AdminOtp[] @relation("AdminOtps")

  // Email verification/change tokens
  emailVerificationTokens EmailVerificationToken[]

  // Phone verification OTPs
  phoneOtps PhoneOtp[]

  // Admin notes written about owners
  adminNotesWritten  AdminNote[] @relation("AdminNotesAdmin")
  adminNotesReceived AdminNote[] @relation("AdminNotesOwner")

  // Jobs created by this admin
  jobsCreated Job[] @relation("JobsCreated")
  jobsUpdated Job[] @relation("JobsUpdated")

  // Job applications reviewed by this admin
  jobApplicationsReviewed JobApplication[] @relation("JobApplicationsReviewed")

  // Cancellation requests initiated by this user (customer)
  cancellationRequests CancellationRequest[]

  // Cancellation requests reviewed by this user (admin)
  cancellationsReviewed CancellationRequest[] @relation("CancellationReviewedBy")

  // Cancellation request messages sent by this user (customer/admin)
  cancellationMessagesSent CancellationMessage[]

  // Agent profile (if user is an agent)
  agentProfile Agent?

  // Plan requests created by this user (if authenticated)
  planRequests PlanRequest[] @relation("PlanRequestsUser")

  // Plan request messages sent by this user
  planRequestMessages PlanRequestMessage[] @relation("PlanRequestMessages")

  // Chatbot conversations
  chatbotConversations ChatbotConversation[] @relation("ChatbotConversations")

  // KYC audit history (all admin review actions on this driver)
  kycAuditLogs KycAuditLog[] @relation("DriverKycAuditLogs")

  // TripMeter cost estimates created by this user
  tripEstimates TripEstimate[]

  @@index([role])
  @@index([email])
  @@index([phone])
  @@index([suspendedAt])
  @@index([kycStatus])
  @@index([referredBy])
  @@map("user")
}

// =========================================================
//  PROPERTY MODEL
// =========================================================
model TourismSite {
  id      Int    @id @default(autoincrement())
  slug    String @unique @db.VarChar(160)
  name    String @db.VarChar(200)
  country String @default("Tanzania") @db.VarChar(120)

  // Optional metadata for future enhancements
  description String?  @db.Text
  latitude    Decimal? @db.Decimal(10, 6)
  longitude   Decimal? @db.Decimal(10, 6)

  // Relations
  properties Property[]

  @@index([country])
  @@index([slug])
  @@map("tourismsite")
}

model Property {
  id      Int    @id @default(autoincrement())
  ownerId Int
  status  String @default("DRAFT") // DRAFT, PENDING, APPROVED, REJECTED, SUSPENDED
  title   String @db.VarChar(200)
  type    String // VILLA, APARTMENT, HOTEL, LODGE, CONDO, GUEST_HOUSE, BUNGALOW, CABIN, HOMESTAY, TOWNHOUSE, HOUSE, OTHER

  // Tourism / park placement (optional)
  tourismSiteId Int?
  parkPlacement String? @db.VarChar(20) // INSIDE, NEARBY

  // Location
  regionId   String?  @db.VarChar(50)
  regionName String?  @db.VarChar(120)
  district   String?  @db.VarChar(120)
  ward       String?  @db.VarChar(120)
  street     String?  @db.VarChar(200)
  apartment  String?  @db.VarChar(120)
  city       String?  @db.VarChar(120)
  zip        String?  @db.VarChar(30)
  country    String?  @default("Tanzania") @db.VarChar(120)
  latitude   Decimal? @db.Decimal(10, 6)
  longitude  Decimal? @db.Decimal(10, 6)

  // Media & details
  description  String? @db.Text
  photos       Json? // Array of URLs (legacy, use PropertyImage now)
  hotelStar    String? // basic, simple, moderate, high, luxury
  buildingType String? // SINGLE_STORY, LOW_RISE, MID_RISE, HIGH_RISE, VILLA_COMPLEX, LODGE_CAMPUS
  totalFloors  Int? // Total number of floors (auto-calculated or manual)
  roomsSpec    Json? // Room types, beds, price/night, images... (includes floor info)
  services     Json? // Parking/breakfast/etc + nearbyFacilities[]
  layout       Json? // Auto-generated SVG/plan metadata

  // Aggregates / pricing
  basePrice      Decimal? @db.Decimal(12, 2)
  currency       String?  @default("TZS") @db.VarChar(3)
  totalBedrooms  Int?
  totalBathrooms Int?
  maxGuests      Int?

  // Moderation history
  lastSubmittedAt  DateTime?
  rejectionReasons Json? // Array of strings

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner              User                        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tourismSite        TourismSite?                @relation(fields: [tourismSiteId], references: [id], onDelete: SetNull)
  bookings           Booking[]
  transportBookings  TransportBooking[]
  groupBookings      GroupBooking[]
  groupBookingClaims GroupBookingClaim[]
  images             PropertyImage[]
  verification       PropertyVerification?
  reviews            PropertyReview[]
  savedBy            SavedProperty[]
  availabilityBlocks PropertyAvailabilityBlock[]

  @@index([ownerId])
  // Supports: WHERE ownerId=? ORDER BY id DESC
  @@index([ownerId, id], map: "idx_Property_ownerId_id")
  @@index([status])
  @@index([tourismSiteId])
  @@index([status, tourismSiteId, parkPlacement, id], map: "idx_Property_status_tourismSite_placement_id")
  // Supports: WHERE status=? ORDER BY basePrice {asc|desc}, id DESC
  @@index([status, basePrice, id], map: "idx_Property_status_basePrice_id")
  // Supports: WHERE ownerId=? AND status=? ORDER BY id DESC
  @@index([ownerId, status, id], map: "idx_Property_ownerId_status_id")
  @@index([type])
  @@index([regionId])
  @@index([regionName])
  @@index([district])
  @@index([ward])
  @@index([createdAt]) // For sorting by newest and time-based queries
  @@index([status, createdAt, regionId])
  // Location indexes for map functionality
  @@index([latitude])
  @@index([longitude])
  @@index([latitude, longitude]) // Composite index for location-based queries
  @@index([status, latitude, longitude]) // For filtering approved properties with locations
  @@map("property")
}

model PropertyVerification {
  id         Int       @id @default(autoincrement())
  propertyId Int       @unique
  status     String    @default("PENDING") @db.VarChar(30) // PENDING, VERIFIED, REJECTED
  verifiedAt DateTime?
  verifiedBy Int?
  method     String?   @db.VarChar(120)
  note       String?   @db.Text
  checklist  Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  verifier User?    @relation("PropertyVerificationVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([verifiedAt])
  @@index([verifiedBy])
  @@map("property_verification")
}

// =========================================================
//  BOOKING MODEL
// =========================================================
model Booking {
  id         Int    @id @default(autoincrement())
  propertyId Int
  userId     Int? // Customer account (optional if walk-in)
  driverId   Int? // Assigned driver (optional)
  status     String @default("NEW") // NEW, CONFIRMED, CHECKED_IN, CHECKED_OUT, CANCELED

  // Transport summary (denormalized; authoritative trip data lives in TransportBooking)
  includeTransport       Boolean   @default(false)
  transportVehicleType   String?   @db.VarChar(20)
  transportScheduledDate DateTime?
  transportOriginAddress String?   @db.VarChar(255)
  transportFare          Decimal?  @db.Decimal(12, 2)

  checkIn     DateTime
  checkOut    DateTime
  totalAmount Decimal  @default(0.00) @db.Decimal(12, 2)
  roomsQty    Int      @default(1)
  roomCode    String?  @db.VarChar(60) // Optional internal code/unit

  // Guest snapshot (for owners scanning codes)
  guestName   String? @db.VarChar(160)
  guestPhone  String? @db.VarChar(40)
  nationality String? @db.VarChar(80)
  sex         String? @db.VarChar(20)
  ageGroup    String? @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  property             Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  driver               User?                 @relation("BookingDriver", fields: [driverId], references: [id], onDelete: SetNull)
  code                 CheckinCode?
  invoices             Invoice[]
  reviews              PropertyReview[]
  referralEarnings     ReferralEarning[]
  cancellationRequests CancellationRequest[]
  tripEstimates        TripEstimate[]

  @@index([propertyId])
  @@index([propertyId, checkIn, checkOut])
  @@index([userId])
  @@index([driverId])
  @@index([status])
  @@index([checkIn])
  @@index([checkOut])
  @@index([createdAt]) // For time-based queries (e.g., bookings in last 24h)
  @@index([status, checkIn])
  @@index([status, createdAt]) // For filtering by status and creation time
  @@index([propertyId, status, checkOut], map: "idx_Booking_property_status_checkOut")
  @@index([includeTransport])
  @@index([includeTransport, transportScheduledDate])
  @@map("booking")
}

// =========================================================
//  CHECK-IN CODE MODEL - Single-use codes (one per booking)
// =========================================================
model CheckinCode {
  id          Int       @id @default(autoincrement())
  bookingId   Int       @unique // 1:1 booking→code
  code        String    @db.VarChar(32) // Human-readable code (e.g., ABCD9F3A)
  codeHash    String    @db.VarChar(128) // SHA-256 hash for verification
  codeVisible String?   @db.VarChar(32) // Alias for code (backward compatibility)
  status      String    @default("ACTIVE") // ACTIVE, USED, VOID
  generatedAt DateTime  @default(now())
  issuedAt    DateTime? // When code was sent to customer
  usedAt      DateTime?
  usedByOwner Boolean? // Whether code was validated by an owner
  voidReason  String?   @db.VarChar(255) // Reason for voiding
  voidedAt    DateTime? // When code was voided

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([codeHash])
  @@unique([code])
  @@index([status])
  @@index([generatedAt])
  @@index([code])
  @@map("checkincode")
}

// =========================================================
//  INVOICE MODEL - Invoices / Payouts
// =========================================================
model Invoice {
  id        Int    @id @default(autoincrement())
  ownerId   Int // Owner to be paid
  bookingId Int // Source booking
  status    String @default("DRAFT") // DRAFT, REQUESTED, VERIFIED, APPROVED, PAID, REJECTED, PROCESSING

  total             Decimal  @default(0.00) @db.Decimal(12, 2)
  commissionPercent Decimal? @db.Decimal(5, 2)
  commissionAmount  Decimal? @db.Decimal(12, 2)
  taxPercent        Decimal? @db.Decimal(5, 2)
  netPayable        Decimal? @db.Decimal(12, 2)

  invoiceNumber String? @unique @db.VarChar(50)
  receiptNumber String? @unique @db.VarChar(50)

  issuedAt   DateTime  @default(now())
  verifiedAt DateTime?
  approvedAt DateTime?
  paidAt     DateTime?

  verifiedBy Int?
  approvedBy Int?
  paidBy     Int?

  paymentMethod     String? @db.VarChar(40) // BANK, MPESA, TIGOPESA, CARD...
  paymentRef        String? @unique @db.VarChar(80) // Gateway merchant ref (set at PROCESSING)
  checkoutSessionId String? @unique @db.VarChar(120) // AzamPay transactionId
  payerPhone        String? @db.VarChar(40) // Phone used for MNO payment
  notes             String? @db.Text

  receiptQrPayload String? @db.Text
  receiptQrPng     Bytes? // PNG bytes (LONGBLOB)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  booking          Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  verifiedByUser   User?             @relation("InvoiceVerifiedBy", fields: [verifiedBy], references: [id], onDelete: SetNull)
  approvedByUser   User?             @relation("InvoiceApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  paidByUser       User?             @relation("InvoicePaidBy", fields: [paidBy], references: [id], onDelete: SetNull)
  paymentEvents    PaymentEvent[]
  referralEarnings ReferralEarning[]

  @@index([status])
  @@index([ownerId])
  @@index([bookingId])
  @@index([issuedAt])
  @@index([paidAt])
  @@index([status, issuedAt])
  @@index([checkoutSessionId])
  @@map("invoice")
}

// =========================================================
//  ADMIN IP ALLOWLIST MODEL
// =========================================================
model AdminIpAllow {
  id        Int      @id @default(autoincrement())
  cidr      String   @db.VarChar(64) // e.g., '197.250.10.20/32' or '10.10.0.0/16'
  note      String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  @@map("adminipallow")
}

// =========================================================
//  AUDIT LOG MODEL
// =========================================================
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    Int?
  actorRole  String? // ADMIN, OWNER, CUSTOMER, DRIVER
  action     String   @db.VarChar(80) // e.g., PROPERTY_APPROVE
  entity     String   @db.VarChar(200) // e.g., PROPERTY, BOOKING, INVOICE or OTP:PHONE:+255xxx:sha256hash
  entityId   Int?
  beforeJson Json?
  afterJson  Json?
  ip         String?  @db.VarChar(64)
  ua         String?  @db.VarChar(255)
  createdAt  DateTime @default(now())

  // Relations
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity, entityId])
  @@index([entity, entityId, id], map: "idx_AuditLog_entity_entityId_id")
  @@index([createdAt])
  @@map("auditlog")
}

// =========================================================
//  ADMIN AUDIT MODEL - For admin action tracking
// =========================================================
model AdminAudit {
  id           Int      @id @default(autoincrement())
  adminId      Int // Admin who performed the action
  targetUserId Int? // User being acted upon (optional)
  performedBy  Int? // Alternative field name (alias for adminId in some cases)
  action       String   @db.VarChar(80) // e.g., SUSPEND_DRIVER, GRANT_BONUS, KYC_APPROVE
  details      Json? // JSON object or string details
  createdAt    DateTime @default(now())

  // Relations
  admin User @relation("AdminAudits", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
  @@map("adminaudit")
}

// =========================================================
//  SESSION MODEL - For user session tracking
// =========================================================
model Session {
  id         String    @id @default(uuid())
  userId     Int
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  user User @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([revokedAt])
  @@index([lastSeenAt])
  @@map("session")
}

// =========================================================
//  ADMIN OTP MODEL - short-lived OTPs for admin actions
// =========================================================
model AdminOtp {
  id        Int       @id @default(autoincrement())
  adminId   Int
  purpose   String    @db.VarChar(60)
  codeHash  String    @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Relations
  admin User @relation("AdminOtps", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, purpose])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("adminotp")
}

// =========================================================
//  EMAIL VERIFICATION TOKEN MODEL - email verify/change flow
// =========================================================
model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique @db.VarChar(128)
  newEmail  String?  @db.VarChar(190)
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("emailverificationtoken")
}

// =========================================================
//  PHONE OTP MODEL - phone verification flow
// =========================================================
model PhoneOtp {
  id        Int       @id @default(autoincrement())
  userId    Int
  phone     String    @db.VarChar(40)
  codeHash  String    @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phone])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("phoneotp")
}

// =========================================================
//  ADMIN NOTE MODEL - internal notes about owners
// =========================================================
model AdminNote {
  id        Int      @id @default(autoincrement())
  ownerId   Int
  adminId   Int
  text      String   @db.Text
  createdAt DateTime @default(now())

  // Relations
  owner User @relation("AdminNotesOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  admin User @relation("AdminNotesAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([adminId])
  @@map("adminnote")
}

// =========================================================
//  USER DOCUMENT MODEL - For KYC/document management
// =========================================================
model UserDocument {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String? // ID, PASSPORT, BUSINESS_LICENSE, etc.
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reason    String?  @db.Text // Rejection reason
  url       String?  @db.Text // Document URL/storage key
  metadata  Json? // Additional document metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("userdocument")
}

// =========================================================
//  PASSKEY MODEL - For passwordless authentication
// =========================================================
model Passkey {
  id           Int      @id @default(autoincrement())
  userId       Int
  credentialId String   @unique // Unique credential identifier
  publicKey    String   @db.Text // Public key for verification
  transports   Json? // Array of transport methods
  signCount    Int      @default(0) // Signature count for replay protection
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialId])
  @@map("passkey")
}

// =========================================================
//  GROUP BOOKING MODEL - For managing group accommodation reservations
// =========================================================
model GroupBooking {
  id Int @id @default(autoincrement())

  /// Foreign key to User who created this booking
  userId Int

  /// Type of group: family, workers, event, students, team, other
  groupType String

  // ==================== Origin Information ====================
  /// Origin country (optional - where the group is coming from)
  fromCountry  String?
  /// Origin region (optional - where the group is coming from, only for Tanzania)
  fromRegion   String?
  /// Origin district within the region
  fromDistrict String?
  /// Origin ward/mtaa
  fromWard     String?
  /// Exact origin location (street address, landmark, GPS coordinates)
  fromLocation String?

  // ==================== Destination Information ====================
  /// Destination region (required - where accommodation is needed)
  toRegion   String
  /// Destination district within the region
  toDistrict String?
  /// Destination ward/mtaa
  toWard     String?
  /// Exact destination location (street address, landmark, GPS coordinates)
  toLocation String?

  // ==================== Accommodation Details ====================
  /// Type of accommodation: villa, apartment, hotel, hostel, lodge, etc.
  accommodationType String
  /// Minimum acceptable hotel comfort level when accommodationType is hotel
  /// Uses the same labels as owner listings: basic|simple|moderate|high|luxury
  minHotelStarLabel String? @db.VarChar(20)
  /// Total number of people in the group
  headcount         Int
  /// Number of males in the group (for accommodation planning)
  maleCount         Int?
  /// Number of females in the group (for accommodation planning)
  femaleCount       Int?
  /// Number of other/prefer not to say in the group (for accommodation planning)
  otherCount        Int?
  /// Number of persons per room (1-4)
  roomSize          Int
  /// Calculated number of rooms needed based on headcount and room size
  roomsNeeded       Int
  /// Whether private rooms are requested
  needsPrivateRoom  Boolean @default(false)
  /// Number of private rooms requested (if applicable)
  privateRoomCount  Int     @default(0)

  // ==================== Date Information ====================
  /// Check-in date and time
  checkIn  DateTime?
  /// Check-out date and time
  checkOut DateTime?
  /// Whether specific dates are being used (false = flexible dates)
  useDates Boolean   @default(true)

  // ==================== Arrangements ====================
  /// Airport/station pickup service requested
  arrPickup    Boolean @default(false)
  /// Transport between sites requested
  arrTransport Boolean @default(false)
  /// Meals included requested
  arrMeals     Boolean @default(false)
  /// On-site guide/staff requested
  arrGuide     Boolean @default(false)
  /// Special equipment requested
  arrEquipment Boolean @default(false)

  /// Pickup location details (airport terminal, hotel, etc.)
  pickupLocation   String? @db.Text
  /// Pickup time in 12-hour format (e.g., "02:30 PM")
  pickupTime       String?
  /// Additional notes about arrangements
  arrangementNotes String? @db.Text

  // ==================== Passenger Roster ====================
  /// JSON array of passenger details (firstname, lastname, phone, age, gender, nationality)
  /// Stored as JSON for flexibility; separate table available for structured queries
  roster Json?

  // ==================== Property Recommendations ====================
  /// JSON array of recommended property IDs (admin can attach 1-2 properties)
  recommendedPropertyIds Json? // Array of property IDs: [1, 2]
  /// Property ID that user confirmed (after viewing recommendations)
  confirmedPropertyId    Int?
  /// Timestamp when user confirmed a property
  propertyConfirmedAt    DateTime?
  /// Owner ID assigned to handle this group stay (admin assigns)
  assignedOwnerId        Int?
  /// Timestamp when owner was assigned
  ownerAssignedAt        DateTime?
  /// Whether this group stay is open for owners to claim (admin can open for competitive bidding)
  isOpenForClaims        Boolean   @default(false)
  /// Timestamp when opened for claims
  openedForClaimsAt      DateTime?

  // ==================== Status & Financial ====================
  /// Booking status: PENDING, AWAITING_DEPOSIT, CONFIRMED, PROCESSING, CANCELED, COMPLETED
  status            String    @default("PENDING")
  /// Total estimated or confirmed amount for the booking
  totalAmount       Decimal?  @db.Decimal(12, 2)
  /// Currency code (default: TZS)
  currency          String    @default("TZS")
  /// Deposit amount required to confirm the booking. For group stay auctions this is the NoLSAF commission amount.
  depositAmount     Decimal?  @db.Decimal(12, 2)
  /// Whether the deposit has been paid
  depositPaid       Boolean   @default(false)
  /// Timestamp when the deposit was paid
  depositPaidAt     DateTime?
  /// Deadline to pay the deposit before the offer expires (set to 24h after AWAITING_DEPOSIT)
  depositDueAt      DateTime?
  /// Owner's payout amount for this stay (their offered/discounted total, before commission markup)
  ownerAmount       Decimal?  @db.Decimal(12, 2)
  /// Commission percentage applied on top of ownerAmount to derive totalAmount (snapshot at confirm time)
  commissionPercent Decimal?  @db.Decimal(5, 2)
  /// Gateway merchant reference for the deposit payment (set when payment is initiated)
  paymentRef        String?   @unique @db.VarChar(80)
  /// AzamPay transactionId for the deposit checkout
  checkoutSessionId String?   @unique @db.VarChar(120)
  /// Phone number used to pay the deposit
  payerPhone        String?   @db.VarChar(40)
  /// Payment provider used for the deposit (e.g. AZAMPAY)
  paymentProvider   String?   @db.VarChar(40)

  // ==================== Owner Payout (group stay) ====================
  /// Timestamp when the assigned owner marked the group as checked in (triggers the payout obligation)
  checkedInAt       DateTime?
  /// Owner's payout owed by NoLSAF after check-in (deposit minus commission). The remaining balance is
  /// collected by the owner directly from the guest at the property.
  ownerPayoutAmount Decimal?  @db.Decimal(12, 2)
  /// Owner payout lifecycle: NONE | PENDING | PAID
  ownerPayoutStatus String    @default("NONE") @db.VarChar(20)
  /// Timestamp when NoLSAF marked the owner payout as paid
  ownerPayoutPaidAt DateTime?
  /// Reference for the manual payout transfer (bank/mobile money ref) recorded by admin
  ownerPayoutRef    String?   @db.VarChar(120)

  // ==================== Administrative Notes ====================
  /// Internal admin notes about this booking
  adminNotes   String?   @db.Text
  /// Reason for cancellation (if status = CANCELED)
  cancelReason String?   @db.Text
  /// Timestamp when booking was canceled
  canceledAt   DateTime?
  /// Timestamp when booking was confirmed
  confirmedAt  DateTime?

  // ==================== Metadata ====================
  /// Record creation timestamp
  createdAt DateTime @default(now())
  /// Record last update timestamp
  updatedAt DateTime @updatedAt

  // ==================== Relations ====================
  /// User who created this booking
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Owner assigned to handle this group stay
  assignedOwner     User?                   @relation("GroupBookingOwner", fields: [assignedOwnerId], references: [id], onDelete: SetNull)
  /// Property confirmed for this group stay
  confirmedProperty Property?               @relation(fields: [confirmedPropertyId], references: [id], onDelete: SetNull)
  /// Individual passenger records (alternative to JSON roster)
  passengers        GroupBookingPassenger[]
  /// Audit logs for this booking
  auditLogs         GroupBookingAudit[]
  /// Messages in the conversation
  messages          GroupBookingMessage[]
  /// Owner claims/offers for this group stay
  claims            GroupBookingClaim[]
  /// Payment events for the deposit
  paymentEvents     PaymentEvent[]

  // ==================== Indexes ====================
  @@index([userId])
  @@index([status])
  @@index([groupType])
  @@index([toRegion])
  @@index([checkIn, checkOut])
  @@index([createdAt])
  @@index([assignedOwnerId])
  @@index([confirmedPropertyId])
  @@index([ownerPayoutStatus])
  @@map("group_bookings")
}

// =========================================================
//  GROUP BOOKING AUDIT MODEL - Track admin actions
// =========================================================
model GroupBookingAudit {
  id             Int      @id @default(autoincrement())
  groupBookingId Int
  adminId        Int // Admin who performed the action
  action         String   @db.VarChar(100) // e.g., STATUS_CHANGED, MESSAGE_SENT, PROPERTY_RECOMMENDED, SUGGESTIONS_PROVIDED
  description    String?  @db.Text // Human-readable description
  metadata       Json? // Additional data (old status, new status, message content, etc.)
  createdAt      DateTime @default(now())

  // Relations
  groupBooking GroupBooking @relation(fields: [groupBookingId], references: [id], onDelete: Cascade)
  admin        User         @relation("GroupBookingAudits", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([groupBookingId])
  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("groupbookingaudit")
}

// =========================================================
//  GROUP BOOKING MESSAGE MODEL - Conversation messages
// =========================================================
model GroupBookingMessage {
  id             Int @id @default(autoincrement())
  groupBookingId Int

  /// Sender information
  senderId   Int? // User ID if sender is authenticated (admin or customer)
  senderRole String  @db.VarChar(20) // ADMIN, USER, SYSTEM
  senderName String? @db.VarChar(200) // Name for display (if not authenticated)

  /// Message content
  messageType String? @db.VarChar(50) // "Ask for Feedback", "Admin Response", etc.
  body        String  @db.Text // Message content (sanitized)

  /// Metadata
  isInternal Boolean  @default(false) // Internal notes not shown to customers
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  groupBooking GroupBooking @relation(fields: [groupBookingId], references: [id], onDelete: Cascade)
  sender       User?        @relation("GroupBookingMessages", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([groupBookingId])
  @@index([senderId])
  @@index([senderRole])
  @@index([createdAt])
  @@index([groupBookingId, createdAt])
  @@map("group_booking_messages")
}

// =========================================================
//  GROUP BOOKING CLAIM MODEL - Owner competitive offers
// =========================================================
model GroupBookingClaim {
  id Int @id @default(autoincrement())

  /// Foreign key to group booking
  groupBookingId Int
  /// Owner who submitted the claim
  ownerId        Int
  /// Property being offered
  propertyId     Int

  // ==================== Offer Details ====================
  /// Owner's base price per room/night before any offer discount
  offeredPricePerNight Decimal  @db.Decimal(12, 2)
  /// Discount percentage (e.g., 15 for 15% off)
  discountPercent      Decimal? @db.Decimal(5, 2)
  /// Special offers/favors (free breakfast, airport pickup, etc.)
  specialOffers        String?  @db.Text
  /// Additional notes from owner
  notes                String?  @db.Text
  /// Total owner amount for the stay after discount, before NoLSAF commission
  totalAmount          Decimal  @db.Decimal(12, 2)
  /// Currency code
  currency             String   @default("TZS")

  // ==================== Status ====================
  /// Claim status: PENDING, ACCEPTED, REJECTED, WITHDRAWN
  status     String    @default("PENDING")
  /// Timestamp when claim was accepted/rejected
  reviewedAt DateTime?
  /// Admin who reviewed the claim
  reviewedBy Int?

  // ==================== Metadata ====================
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==================== Relations ====================
  groupBooking GroupBooking @relation(fields: [groupBookingId], references: [id], onDelete: Cascade)
  owner        User         @relation("GroupBookingClaims", fields: [ownerId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reviewer     User?        @relation("GroupBookingClaimReviews", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([groupBookingId, ownerId]) // One claim per owner per group booking
  @@index([groupBookingId])
  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@map("group_booking_claims")
}

/// Individual passenger record for group bookings
/// Alternative to storing all passengers in JSON; enables structured queries
model GroupBookingPassenger {
  id Int @id @default(autoincrement())

  /// Foreign key to parent group booking
  groupBookingId Int

  /// Passenger first name
  firstName   String
  /// Passenger last name
  lastName    String
  /// Contact phone number
  phone       String?
  /// Age in years
  age         Int?
  /// Gender: Male, Female, Other, or custom value
  gender      String?
  /// Nationality or country of origin
  nationality String?

  /// Order/sequence number in the passenger list
  sequenceNumber Int?

  /// Record creation timestamp
  createdAt DateTime @default(now())
  /// Record last update timestamp
  updatedAt DateTime @updatedAt

  /// Parent group booking
  groupBooking GroupBooking @relation(fields: [groupBookingId], references: [id], onDelete: Cascade)

  @@index([groupBookingId])
  @@index([lastName, firstName])
  @@map("group_booking_passengers")
}

// =========================================================
//  TRANSPORT BOOKING MODEL - Transportation/Ride Bookings
// =========================================================
model TransportBooking {
  id Int @id @default(autoincrement())

  /// Customer who booked the ride
  userId Int

  /// Driver assigned to the ride (optional - can be assigned later)
  driverId Int?

  /// Property destination (optional - for rides to properties)
  propertyId Int?

  /// Booking status: PENDING, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELED
  status String @default("PENDING") @db.VarChar(40)

  /// Scheduled date for the ride
  scheduledDate DateTime

  /// Pickup time
  pickupTime DateTime?

  /// Dropoff time
  dropoffTime DateTime?

  // ==================== Origin Information ====================
  /// Origin region
  fromRegion    String?  @db.VarChar(120)
  /// Origin district
  fromDistrict  String?  @db.VarChar(120)
  /// Origin ward/mtaa
  fromWard      String?  @db.VarChar(120)
  /// Exact origin address
  fromAddress   String?  @db.VarChar(255)
  /// Origin latitude
  fromLatitude  Decimal? @db.Decimal(10, 6)
  /// Origin longitude
  fromLongitude Decimal? @db.Decimal(10, 6)

  // ==================== Destination Information ====================
  /// Destination region
  toRegion    String?  @db.VarChar(120)
  /// Destination district
  toDistrict  String?  @db.VarChar(120)
  /// Destination ward/mtaa
  toWard      String?  @db.VarChar(120)
  /// Exact destination address
  toAddress   String?  @db.VarChar(255)
  /// Destination latitude
  toLatitude  Decimal? @db.Decimal(10, 6)
  /// Destination longitude
  toLongitude Decimal? @db.Decimal(10, 6)

  // ==================== Ride Details ====================
  /// Vehicle type: BODA, BAJAJI, CAR, XL, PREMIUM
  vehicleType String? @db.VarChar(20)

  /// Total amount for the ride
  amount   Decimal? @db.Decimal(12, 2)
  /// Currency (default: TZS)
  currency String?  @default("TZS") @db.VarChar(3)

  /// Number of passengers
  numberOfPassengers Int? @default(1)

  /// Special instructions or notes
  notes String? @db.Text

  /// Language the passenger would like the driver to speak (e.g. "sw", "en"). Optional — matched
  /// against the driver's User.languages where available.
  requiredLanguage String? @db.VarChar(40)

  // ==================== Arrival Information (for airport, bus station, etc.) ====================
  /// Arrival type: FLIGHT, BUS, TRAIN, FERRY, OTHER
  arrivalType      String?   @db.VarChar(20)
  /// Transport number (flight number, bus number, train number, etc.)
  arrivalNumber    String?   @db.VarChar(40)
  /// Transport company/operator (airline, bus company, train operator, etc.)
  transportCompany String?   @db.VarChar(100)
  /// Expected arrival time
  arrivalTime      DateTime?
  /// Pickup location description (e.g., "Julius Nyerere International Airport - Terminal 1", "Ubungo Bus Terminal")
  pickupLocation   String?   @db.VarChar(255)

  // ==================== Ratings & Reviews ====================
  /// Customer rating for the driver (1-5)
  userRating   Decimal? @db.Decimal(3, 2)
  /// Customer review comment
  userReview   String?  @db.Text
  /// Driver rating for the passenger (1-5)
  driverRating Decimal? @db.Decimal(3, 2)
  /// Driver review comment
  driverReview String?  @db.Text

  /// Legacy: Customer rating for the ride (1-5) - kept for backward compatibility
  rating        Decimal? @db.Decimal(3, 2)
  /// Legacy: Rating comment/review - kept for backward compatibility
  ratingComment String?  @db.Text

  /// Payment status: PENDING, PAID, REFUNDED
  paymentStatus String? @default("PENDING") @db.VarChar(40)
  /// Payment method used
  paymentMethod String? @db.VarChar(40)
  /// Payment reference
  paymentRef    String? @db.VarChar(80)

  /// Public, non-sequential trip code for transport rides (used for reconciliation/payout workflows)
  tripCode     String? @unique @db.VarChar(64)
  /// Hash of tripCode (SHA-256 or HMAC-SHA256 hex), used for safe indexing/verification
  tripCodeHash String? @unique @db.VarChar(64)

  /// Record creation timestamp
  createdAt DateTime @default(now())
  /// Record last update timestamp
  updatedAt DateTime @updatedAt

  // Relations
  user     User      @relation("UserTransportBookings", fields: [userId], references: [id], onDelete: Cascade)
  driver   User?     @relation("DriverTransportBookings", fields: [driverId], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  // Optional: GPS pings linked to this booking (for replay/analytics)
  driverLocationPings DriverLocationPing[]

  // Messages between driver, passenger, and admin
  messages TransportMessage[]

  /// Competitive claims from drivers (max 5 per booking enforced in API)
  claims TransportBookingClaim[]

  /// Targeted offers for instant auto-dispatch (top-N drivers invited to accept)
  offers TransportBookingOffer[] @relation("TransportBookingOffers")

  /// Payout record for this transport booking (admin reconciliation)
  payout TransportPayout?

  @@index([userId])
  @@index([driverId])
  @@index([propertyId])
  @@index([status])
  @@index([scheduledDate])
  @@index([paymentStatus])
  @@index([vehicleType])
  @@index([tripCode])
  @@index([tripCodeHash])
  @@map("transportbooking")
}

// =========================================================
//  TRANSPORT PAYOUT MODEL - Driver payouts + NoLSAF commission
// =========================================================
model TransportPayout {
  id Int @id @default(autoincrement())

  /// Associated transport booking (one payout per booking)
  transportBookingId Int @unique

  /// Driver being paid
  driverId Int

  /// Currency (default: TZS)
  currency String @default("TZS") @db.VarChar(3)

  /// Fare amount (gross) for the trip
  grossAmount Decimal @db.Decimal(12, 2)

  /// Commission percent deducted as NoLSAF revenue
  commissionPercent Decimal @db.Decimal(5, 2)
  /// Commission amount deducted as NoLSAF revenue
  commissionAmount  Decimal @db.Decimal(12, 2)

  /// Net paid to driver (gross - commission)
  netPaid Decimal @db.Decimal(12, 2)

  /// Status: PENDING, APPROVED, PAID
  status String @default("PENDING") @db.VarChar(20)

  /// Approval and payout audit
  approvedAt DateTime?
  approvedBy Int?
  paidAt     DateTime?
  paidBy     Int?

  /// Payment details
  paymentMethod String? @db.VarChar(40)
  paymentRef    String? @db.VarChar(80)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking  TransportBooking @relation(fields: [transportBookingId], references: [id], onDelete: Cascade)
  driver   User             @relation("TransportPayoutDriver", fields: [driverId], references: [id], onDelete: Cascade)
  approver User?            @relation("TransportPayoutApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  payer    User?            @relation("TransportPayoutPayer", fields: [paidBy], references: [id], onDelete: SetNull)

  @@index([driverId])
  @@index([status])
  @@index([approvedAt])
  @@index([paidAt])
  @@map("transport_payouts")
}

// =========================================================
//  TRANSPORT BOOKING CLAIM MODEL - Driver competitive claims
// =========================================================
model TransportBookingClaim {
  id Int @id @default(autoincrement())

  /// Transport booking being claimed
  bookingId Int
  /// Driver who submitted the claim
  driverId  Int

  /// Claim status: PENDING, ACCEPTED, REJECTED, WITHDRAWN
  status String @default("PENDING") @db.VarChar(40)

  /// Timestamp when claim was accepted/rejected
  reviewedAt DateTime?
  /// Admin who reviewed the claim
  reviewedBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking  TransportBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  driver   User             @relation("DriverTransportBookingClaims", fields: [driverId], references: [id], onDelete: Cascade)
  reviewer User?            @relation("TransportBookingClaimReviews", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([bookingId, driverId])
  @@index([bookingId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
  @@map("transport_booking_claims")
}

// =========================================================
//  TRANSPORT BOOKING OFFER MODEL - Targeted offers for instant auto-dispatch
// =========================================================
model TransportBookingOffer {
  id Int @id @default(autoincrement())

  bookingId Int
  driverId  Int

  /// OFFERED, ACCEPTED, DECLINED, EXPIRED, CANCELLED
  status String @default("OFFERED") @db.VarChar(20)

  /// Diagnostic metadata used for ranking/debugging
  radiusKm   Decimal? @db.Decimal(5, 2)
  distanceKm Decimal? @db.Decimal(6, 3)
  score      Decimal? @db.Decimal(8, 2)

  offeredAt   DateTime  @default(now())
  expiresAt   DateTime
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking TransportBooking @relation("TransportBookingOffers", fields: [bookingId], references: [id], onDelete: Cascade)
  driver  User             @relation("DriverTransportBookingOffers", fields: [driverId], references: [id], onDelete: Cascade)

  @@index([bookingId, status, expiresAt])
  @@index([driverId, status, expiresAt])
  @@map("transport_booking_offers")
}

// =========================================================
//  DRIVER LIVE LOCATION - one row per driver (fast map reads)
// =========================================================
model DriverLiveLocation {
  driverId   Int      @id
  lat        Decimal  @db.Decimal(10, 6)
  lng        Decimal  @db.Decimal(10, 6)
  headingDeg Int?
  speedMps   Decimal? @db.Decimal(7, 2)
  accuracyM  Decimal? @db.Decimal(7, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver User @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
  @@index([lat, lng])
  @@map("driver_live_locations")
}

// =========================================================
//  DRIVER LOCATION PING - optional history for replay/analytics
// =========================================================
model DriverLocationPing {
  id                 BigInt   @id @default(autoincrement())
  driverId           Int
  transportBookingId Int?
  lat                Decimal  @db.Decimal(10, 6)
  lng                Decimal  @db.Decimal(10, 6)
  headingDeg         Int?
  speedMps           Decimal? @db.Decimal(7, 2)
  accuracyM          Decimal? @db.Decimal(7, 2)

  createdAt DateTime @default(now())

  driver           User              @relation(fields: [driverId], references: [id], onDelete: Cascade)
  transportBooking TransportBooking? @relation(fields: [transportBookingId], references: [id], onDelete: SetNull)

  @@index([driverId, createdAt])
  @@index([transportBookingId, createdAt])
  @@map("driver_location_pings")
}

// =========================================================
//  TRANSPORT MESSAGE - Communication between driver, passenger, and admin
// =========================================================
model TransportMessage {
  id                 Int @id @default(autoincrement())
  transportBookingId Int

  /// Sender user ID (driver, passenger, or admin)
  senderId Int

  /// Sender type: DRIVER, PASSENGER, ADMIN
  senderType String @db.VarChar(20)

  /// Message content
  message String @db.Text

  /// Message type: TEXT, IMAGE, LOCATION, SYSTEM
  messageType String @default("TEXT") @db.VarChar(20)

  /// When the message was read (null = unread)
  readAt DateTime?

  /// Record creation timestamp
  createdAt DateTime @default(now())

  // Relations
  transportBooking TransportBooking @relation(fields: [transportBookingId], references: [id], onDelete: Cascade)

  @@index([transportBookingId, createdAt])
  @@index([senderId])
  @@index([readAt])
  @@map("transportmessage")
}

// =========================================================
//  TRUST PARTNER MODEL - For "Trusted by" partners displayed on public site
// =========================================================
model TrustPartner {
  id Int @id @default(autoincrement())

  /// Partner name (e.g., "M-Pesa", "Airtel Money")
  name String

  /// URL to partner logo image
  logoUrl String?

  /// Optional link to partner website
  href String?

  /// Display order (lower numbers appear first)
  displayOrder Int @default(0)

  /// Whether this partner is active/visible
  isActive Boolean @default(true)

  /// Record creation timestamp
  createdAt DateTime @default(now())
  /// Record last update timestamp
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([displayOrder])
  @@map("trust_partners")
}

// =========================================================
//  REFERRAL EARNINGS MODEL - For tracking driver referral earnings
// =========================================================
model ReferralEarning {
  id Int @id @default(autoincrement())

  /// Driver who earned this referral (the referrer)
  driverId Int

  /// User who was referred (the new user)
  referredUserId Int

  /// Booking that generated this earning (if applicable)
  bookingId Int?

  /// Invoice that generated this earning (if applicable)
  invoiceId Int?

  /// Amount earned from this referral
  amount Decimal @db.Decimal(12, 2)

  /// Currency code (default: TZS)
  currency String @default("TZS")

  /// Status: PENDING, PAID_AS_BONUS, AVAILABLE_FOR_WITHDRAWAL, WITHDRAWN
  status String @default("PENDING")

  /// Reference to bonus payment if paid as bonus (invoice ID or bonus record ID)
  bonusPaymentRef String?

  /// Reference to withdrawal application if applied for withdrawal
  withdrawalId Int?

  /// Admin notes about this earning
  adminNotes String? @db.Text

  /// Timestamp when marked as paid as bonus
  paidAsBonusAt DateTime?

  /// Timestamp when made available for withdrawal
  availableAt DateTime?

  /// Timestamp when withdrawn
  withdrawnAt DateTime?

  /// Record creation timestamp
  createdAt DateTime @default(now())
  /// Record last update timestamp
  updatedAt DateTime @updatedAt

  // Relations
  driver       User                @relation("DriverReferrals", fields: [driverId], references: [id], onDelete: Cascade)
  referredUser User                @relation("ReferredUsers", fields: [referredUserId], references: [id], onDelete: Cascade)
  booking      Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  invoice      Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  withdrawal   ReferralWithdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)

  @@index([driverId])
  @@index([referredUserId])
  @@index([bookingId])
  @@index([invoiceId])
  @@index([status])
  @@index([withdrawalId])
  @@index([createdAt])
  @@map("referral_earnings")
}

// =========================================================
//  REFERRAL WITHDRAWAL MODEL - For driver withdrawal applications
// =========================================================
model ReferralWithdrawal {
  id Int @id @default(autoincrement())

  /// Driver applying for withdrawal
  driverId Int

  /// Total amount requested for withdrawal
  totalAmount Decimal @db.Decimal(12, 2)

  /// Currency code
  currency String @default("TZS")

  /// Status: PENDING, APPROVED, REJECTED, PAID
  status String @default("PENDING")

  /// Payment method preference (BANK, MPESA, TIGOPESA, etc.)
  paymentMethod String?

  /// Payment reference/account details
  paymentRef String?

  /// Admin who approved/rejected this withdrawal
  processedBy Int?

  /// Reason for rejection (if rejected)
  rejectionReason String? @db.Text

  /// Admin notes
  adminNotes String? @db.Text

  /// Timestamp when approved
  approvedAt DateTime?

  /// Timestamp when rejected
  rejectedAt DateTime?

  /// Timestamp when paid
  paidAt DateTime?

  /// Record creation timestamp
  createdAt DateTime @default(now())
  /// Record last update timestamp
  updatedAt DateTime @updatedAt

  // Relations
  driver          User              @relation("DriverWithdrawals", fields: [driverId], references: [id], onDelete: Cascade)
  processedByUser User?             @relation("ProcessedWithdrawals", fields: [processedBy], references: [id], onDelete: SetNull)
  earnings        ReferralEarning[]

  @@index([driverId])
  @@index([status])
  @@index([createdAt])
  @@map("referral_withdrawals")
}

// =========================================================
//  SYSTEM SETTING MODEL - Singleton configuration table (id = 1)
// =========================================================
model SystemSetting {
  id Int @id @default(1)

  /// Property/accommodation commission percentage charged to property owners (e.g., 10.00 for 10%)
  commissionPercent Decimal? @default(10.00) @db.Decimal(5, 2)

  /// Currency for property/accommodation commission (ISO 4217, e.g. "TZS")
  commissionCurrency String? @default("TZS") @db.VarChar(3)

  /// Transport driver commission percentage deducted from driver trip payouts (e.g., 10.00 for 10%)
  driverCommissionPercent Decimal? @default(10.00) @db.Decimal(5, 2)

  /// Currency for driver transport commission (ISO 4217, e.g. "TZS")
  driverCommissionCurrency String? @default("TZS") @db.VarChar(3)

  /// Tax percentage (e.g., 0.00 for 0%)
  taxPercent Decimal? @default(0.00) @db.Decimal(5, 2)

  /// Default currency for the platform (ISO 4217, e.g., "TZS")
  currency String? @default("TZS") @db.VarChar(3)

  /// Display FX rates as JSON (presentation only — TZS remains the money of record).
  /// Shape: { base: "TZS", tzsPerUnit: { USD: 2600, EUR: 2800, KES: 20 },
  ///          updatedAt: ISO8601, source: "manual"|"auto", locked: { USD: true } }
  /// tzsPerUnit[X] = how many TZS equal 1 unit of currency X. Display = amountTZS / tzsPerUnit[X].
  fxRates Json?

  /// Invoice number prefix (e.g., "INV")
  invoicePrefix String? @default("INV")

  /// Receipt number prefix (e.g., "RCPT")
  receiptPrefix String? @default("RCPT")

  /// Branding configuration (JSON: logoUrl, primaryColor, etc.)
  branding Json?

  /// Whether email notifications are enabled
  emailEnabled Boolean? @default(true)

  /// Whether SMS notifications are enabled
  smsEnabled Boolean? @default(true)

  /// Support contact email shown in UI/receipts (optional)
  supportEmail String? @db.VarChar(191)

  /// Support contact phone shown in UI/receipts (optional)
  supportPhone String? @db.VarChar(40)

  // ==================== Security & Cybersecurity Fields ====================
  /// Require two-factor authentication for admin accounts
  requireAdmin2FA Boolean? @default(false)

  /// Minimum password length
  minPasswordLength Int? @default(8)

  /// Require uppercase letters in passwords
  requirePasswordUppercase Boolean? @default(false)

  /// Require lowercase letters in passwords
  requirePasswordLowercase Boolean? @default(false)

  /// Require numbers in passwords
  requirePasswordNumber Boolean? @default(false)

  /// Require special characters in passwords
  requirePasswordSpecial Boolean? @default(false)

  /// Session idle timeout in minutes
  sessionIdleMinutes Int? @default(30)

  /// Session TTL by role (minutes). If null, falls back to sessionIdleMinutes.
  sessionMaxMinutesAdmin    Int?
  sessionMaxMinutesOwner    Int?
  sessionMaxMinutesDriver   Int?
  sessionMaxMinutesCustomer Int?
  sessionMaxMinutesAgent    Int?

  /// Maximum session duration in hours
  maxSessionDurationHours Int? @default(24)

  /// Force logout all sessions when password is changed
  forceLogoutOnPasswordChange Boolean? @default(true)

  /// Admin IP allowlist (CSV CIDR format)
  ipAllowlist String?

  /// Enable IP allowlist enforcement
  enableIpAllowlist Boolean? @default(false)

  /// API rate limit (requests per minute per IP)
  apiRateLimitPerMinute Int? @default(100)

  /// Maximum login attempts before lockout
  maxLoginAttempts Int? @default(5)

  /// Account lockout duration in minutes
  accountLockoutDurationMinutes Int? @default(30)

  /// Enable security audit logging
  enableSecurityAuditLogging Boolean? @default(true)

  /// Log failed login attempts
  logFailedLoginAttempts Boolean? @default(true)

  /// Alert on suspicious activity
  alertOnSuspiciousActivity Boolean? @default(false)

  // ==================== Business Configuration Fields ====================
  /// Referral credit percentage as decimal (e.g., 0.0035 for 0.35%)
  referralCreditPercent Decimal? @default(0.0035) @db.Decimal(10, 6)

  /// Driver level threshold for Gold (in TZS)
  driverLevelGoldThreshold Int? @default(500000)

  /// Driver level threshold for Diamond (in TZS)
  driverLevelDiamondThreshold Int? @default(2000000)

  /// Agent promotion: Minimum trips required for promotion (default: 30)
  agentPromotionMinTrips Int? @default(30)

  /// Agent promotion: Maximum trips required for promotion (default: 50, for flexibility)
  agentPromotionMaxTrips Int? @default(50)

  /// Agent promotion: Minimum revenue required for promotion (in TZS, default: 20,000,000)
  agentPromotionMinRevenue Int? @default(20000000)

  /// Operator tier ladder overrides (JSON). Editable per-tier thresholds for
  /// SILVER/GOLD/PLATINUM: { SILVER: {minTours,minRevenue,minRating,minReviews}, ... }.
  /// Null/blank falls back to the hardcoded defaults in lib/agentLevel.ts.
  agentTierLadder Json?

  /// Agent commission percentage (default: 15% of trip budget goes to NoLSAF)
  agentCommissionPercent Decimal? @default(15.0) @db.Decimal(5, 2)

  /// Currency for tour agent commission (ISO 4217, e.g. "USD")
  agentCommissionCurrency String? @default("USD") @db.VarChar(3)

  /// Goal calculation multiplier (e.g., 1.1 for 10% above average)
  goalMultiplier Decimal? @default(1.1) @db.Decimal(5, 2)

  /// Minimum monthly earnings goal (in TZS)
  goalMinimumMonthly Int? @default(3000000)

  /// Record creation timestamp
  createdAt DateTime @default(now())

  /// Record last update timestamp
  updatedAt DateTime @updatedAt

  // ==================== NoLScope Configuration ====================
  /// Default currency for NoLScope cost estimates (ISO 4217, e.g. "USD")
  nolScopeDefaultCurrency      String?  @default("USD") @db.VarChar(3)
  /// Service charge % applied on top of all NoLScope estimates (e.g. 5.00 = 5%)
  nolScopeServiceChargePercent Decimal? @default(5.00) @db.Decimal(5, 2)
  /// Days a NoLScope estimate remains valid before it expires
  nolScopeEstimateValidDays    Int?     @default(7)
  /// Base confidence level before data-quality bonuses are applied (0–1)
  nolScopeBaseConfidence       Decimal? @default(0.70) @db.Decimal(3, 2)
  /// Variance % used for min/max cost range (e.g. 10.00 = ±10%)
  nolScopeCostVariancePercent  Decimal? @default(10.00) @db.Decimal(5, 2)
  /// Whether NoLScope is live for users
  nolScopeEnabled              Boolean? @default(true)

  @@map("systemsetting")
}

// =========================================================
//  PROPERTY REVIEW MODEL - For guest reviews and ratings
// =========================================================
model PropertyReview {
  id Int @id @default(autoincrement())

  /// Property being reviewed
  propertyId Int

  /// User who wrote the review (guest/customer)
  userId Int

  /// Overall rating (1-5 stars)
  rating Int // 1-5

  /// Review title/subject
  title String? @db.VarChar(200)

  /// Review text content
  comment String? @db.Text

  /// Category ratings (JSON: cleanliness, location, value, service, etc.)
  categoryRatings Json? // e.g., { cleanliness: 5, location: 4, value: 5, service: 4 }

  /// Whether this review is verified (guest actually stayed)
  isVerified Boolean @default(false)

  /// Whether this review is published/visible
  isPublished Boolean @default(true)

  /// Admin can hide inappropriate reviews
  isHidden Boolean @default(false)

  /// Booking ID that this review is associated with (if applicable)
  bookingId Int?

  /// Response from property owner/host
  ownerResponse   String?   @db.Text
  ownerResponseAt DateTime?

  /// Record creation timestamp
  createdAt DateTime @default(now())
  /// Record last update timestamp
  updatedAt DateTime @updatedAt

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([userId])
  @@index([bookingId])
  @@index([rating])
  @@index([isPublished, isHidden])
  @@index([createdAt])
  @@map("property_reviews")
}

// =========================================================
//  PROPERTY IMAGE MODEL - For managing property photos with moderation
// =========================================================
model PropertyImage {
  id Int @id @default(autoincrement())

  /// Property this image belongs to
  propertyId Int

  /// Storage key (S3 key or file identifier)
  storageKey String? @unique

  /// Original image URL
  url String? @db.Text

  /// Thumbnail storage key
  thumbnailKey String?

  /// Thumbnail URL
  thumbnailUrl String? @db.Text

  /// Image width in pixels
  width Int?

  /// Image height in pixels
  height Int?

  /// Processing status: PENDING, PROCESSING, READY, REJECTED
  status String @default("PENDING")

  /// Moderation note (if rejected or needs review)
  moderationNote String? @db.Text

  /// Timestamp when image was moderated
  moderatedAt DateTime?

  /// Record creation timestamp
  createdAt DateTime @default(now())

  /// Record last update timestamp
  updatedAt DateTime @updatedAt

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([status])
  @@index([storageKey])
  @@index([createdAt])
  // Composite index for optimized queries filtering by propertyId, status, and ordering by createdAt
  @@index([propertyId, status, createdAt])
  @@map("property_images")
}

// =========================================================
//  TOUR BOOKING MODEL - Paid No4P tour package bookings
// =========================================================
model TourBooking {
  id Int @id @default(autoincrement())

  /// Human-friendly internal booking code, e.g. TOUR-20260517-AB12
  bookingCode String @unique @db.VarChar(40)

  /// No4P tour operator receiving this booking
  operatorAgentId Int

  /// Customer account, when booked by a logged-in user
  customerId Int?

  /// Package identifier from Agent.operatorProfile.packageItems
  packageId String? @db.VarChar(120)

  /// Snapshots preserve the purchased package/operator details even if profile data changes later.
  packageSnapshot  Json?
  operatorSnapshot Json?

  title       String    @db.VarChar(200)
  destination String?   @db.VarChar(200)
  category    String?   @db.VarChar(80)
  startDate   DateTime?
  endDate     DateTime?

  guestName     String? @db.VarChar(160)
  guestEmail    String? @db.VarChar(160)
  guestPhone    String? @db.VarChar(40)
  nationality   String? @db.VarChar(80)
  travelerCount Int     @default(1)

  status        String @default("PENDING_PAYMENT") @db.VarChar(40) // PENDING_PAYMENT, PAID, CONFIRMED, COMPLETED, CANCELED, REFUNDED
  paymentStatus String @default("UNPAID") @db.VarChar(40) // UNPAID, PENDING, PAID, FAILED, REFUNDED
  payoutStatus  String @default("NOT_READY") @db.VarChar(40) // NOT_READY, AVAILABLE, CLAIMED, VERIFIED, APPROVED, DISBURSED, REJECTED, HELD

  currency             String  @default("TZS") @db.VarChar(3)
  unitPrice            Decimal @default(0.00) @db.Decimal(12, 2)
  grossAmount          Decimal @default(0.00) @db.Decimal(12, 2)
  commissionPercent    Decimal @default(15.00) @db.Decimal(5, 2)
  commissionAmount     Decimal @default(0.00) @db.Decimal(12, 2)
  operatorPayoutAmount Decimal @default(0.00) @db.Decimal(12, 2)

  paymentProvider    String? @db.VarChar(40)
  paymentRef         String? @unique @db.VarChar(100)
  /// Immutable reference for the customer's incoming payment. `paymentRef` is retained for legacy reads.
  customerPaymentRef String? @unique @db.VarChar(120)
  /// Reference for the outgoing transfer to the operator; never overwrites the customer payment reference.
  operatorPayoutRef  String? @unique @db.VarChar(120)
  checkoutSessionId  String? @unique @db.VarChar(120)
  payerPhone         String? @db.VarChar(40)

  paidAt              DateTime?
  confirmedAt         DateTime?
  completedAt         DateTime?
  operatorCompletedAt DateTime?
  customerConfirmedAt DateTime?
  disputeWindowEndsAt DateTime?
  canceledAt          DateTime?
  payoutRequestedAt   DateTime?
  payoutApprovedAt    DateTime?
  payoutPaidAt        DateTime?

  notes    String? @db.Text
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  operator              Agent                      @relation("AgentTourBookings", fields: [operatorAgentId], references: [id], onDelete: Cascade)
  customer              User?                      @relation("UserTourBookings", fields: [customerId], references: [id], onDelete: SetNull)
  paymentEvents         PaymentEvent[]
  agentReview           AgentReview?               @relation("AgentReviewsTourBooking")
  cases                 TourCase[]
  travelers             TourTraveler[]
  financialTransactions TourFinancialTransaction[]

  @@index([operatorAgentId])
  @@index([customerId])
  @@index([packageId])
  @@index([status])
  @@index([paymentStatus])
  @@index([payoutStatus])
  @@index([startDate])
  @@index([createdAt])
  @@index([paidAt])
  @@index([operatorAgentId, status, createdAt])
  @@index([paymentStatus, createdAt])
  @@map("tour_bookings")
}

/// Versioned, searchable package record. Legacy operatorProfile.packageItems remains a compatibility source.
model TourPackage {
  id              Int             @id @default(autoincrement())
  operatorAgentId Int
  legacyPackageId String          @db.VarChar(120)
  version         Int             @default(1)
  status          String          @default("DRAFT") @db.VarChar(30)
  name            String          @db.VarChar(200)
  destination     String?         @db.VarChar(200)
  category        String?         @db.VarChar(100)
  currency        String          @default("TZS") @db.VarChar(3)
  pricePerPerson  Decimal         @default(0.00) @db.Decimal(12, 2)
  minPax          Int?
  maxPax          Int?
  content         Json
  publishedAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  operator        Agent           @relation(fields: [operatorAgentId], references: [id], onDelete: Cascade)
  departures      TourDeparture[]

  @@unique([operatorAgentId, legacyPackageId, version])
  @@index([status, destination])
  @@map("tour_packages")
}

model TourDeparture {
  id              Int         @id @default(autoincrement())
  tourPackageId   Int
  startDate       DateTime
  endDate         DateTime?
  capacity        Int
  reservedCount   Int         @default(0)
  status          String      @default("OPEN") @db.VarChar(30)
  bookingCutoffAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tourPackage     TourPackage @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  @@unique([tourPackageId, startDate])
  @@index([status, startDate])
  @@map("tour_departures")
}

model TourTraveler {
  id             Int         @id @default(autoincrement())
  tourBookingId  Int
  legacyMemberId String?     @db.VarChar(120)
  fullName       String      @db.VarChar(180)
  email          String?     @db.VarChar(180)
  phone          String?     @db.VarChar(50)
  nationality    String?     @db.VarChar(100)
  documentType   String?     @db.VarChar(40)
  documentNumber String?     @db.VarChar(100)
  documentUrl    String?     @db.VarChar(1000)
  permitStatus   String      @default("NOT_REQUIRED") @db.VarChar(40)
  status         String      @default("ACTIVE") @db.VarChar(30)
  metadata       Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  booking        TourBooking @relation(fields: [tourBookingId], references: [id], onDelete: Cascade)

  @@unique([tourBookingId, legacyMemberId])
  @@index([tourBookingId, status])
  @@map("tour_travelers")
}

/// Append-only operational case. Withdrawal changes status but never deletes the record or its events.
model TourCase {
  id                 Int             @id @default(autoincrement())
  tourBookingId      Int
  type               String          @db.VarChar(40)
  status             String          @default("OPEN") @db.VarChar(40)
  severity           String          @default("MEDIUM") @db.VarChar(20)
  title              String          @db.VarChar(180)
  description        String          @db.Text
  requestedByUserId  Int?
  assignedToUserId   Int?
  requestedStartDate DateTime?
  requestedEndDate   DateTime?
  resolution         String?         @db.Text
  resolutionAmount   Decimal?        @db.Decimal(12, 2)
  withdrawnAt        DateTime?
  closedAt           DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  booking            TourBooking     @relation(fields: [tourBookingId], references: [id], onDelete: Cascade)
  events             TourCaseEvent[]

  @@index([tourBookingId, status])
  @@index([type, status, severity])
  @@map("tour_cases")
}

model TourCaseEvent {
  id          Int      @id @default(autoincrement())
  tourCaseId  Int
  actorUserId Int?
  type        String   @db.VarChar(50)
  message     String?  @db.Text
  data        Json?
  createdAt   DateTime @default(now())
  tourCase    TourCase @relation(fields: [tourCaseId], references: [id], onDelete: Cascade)

  @@index([tourCaseId, createdAt])
  @@map("tour_case_events")
}

model TourFinancialTransaction {
  id             Int         @id @default(autoincrement())
  tourBookingId  Int
  kind           String      @db.VarChar(30)
  status         String      @db.VarChar(30)
  provider       String?     @db.VarChar(50)
  reference      String?     @unique @db.VarChar(160)
  idempotencyKey String?     @unique @db.VarChar(160)
  currency       String      @db.VarChar(3)
  amount         Decimal     @db.Decimal(12, 2)
  metadata       Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  booking        TourBooking @relation(fields: [tourBookingId], references: [id], onDelete: Cascade)

  @@index([tourBookingId, kind, status])
  @@map("tour_financial_transactions")
}

// =========================================================
//  PAYMENT EVENT MODEL - For tracking payment gateway events
// =========================================================
model PaymentEvent {
  id Int @id @default(autoincrement())

  /// Payment provider (AZAMPAY, MPESA, TIGOPESA, etc.)
  provider String

  /// Unique event ID from the payment provider
  eventId String @unique

  /// Invoice this payment event is associated with
  invoiceId Int?

  /// Tour booking this payment event is associated with
  tourBookingId Int?

  /// Group booking this payment event is associated with (deposit payments)
  groupBookingId Int?

  /// Payment amount
  amount Decimal @db.Decimal(12, 2)

  /// Currency code (default: TZS)
  currency String @default("TZS")

  /// Payment status: SUCCESS, FAILED, PENDING
  status String @default("PENDING")

  /// Payment channel: MNO (mobile money), BANK, or CARD
  paymentChannel String? @map("payment_channel") @db.VarChar(10)

  /// E.164 phone number for MNO payments (e.g. +255712345678)
  phone String? @db.VarChar(20)

  /// Original status string from AzamPay before normalization
  rawStatus String? @map("raw_status") @db.VarChar(80)

  /// Card redirect URL returned by AzamPay CardCheckout
  checkoutUrl String? @map("checkout_url") @db.VarChar(2048)

  /// Raw payload from payment provider (JSON)
  payload Json?

  /// Record creation timestamp
  createdAt DateTime @default(now())

  /// Record last update timestamp
  updatedAt DateTime @updatedAt

  // Relations
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  tourBooking  TourBooking?  @relation(fields: [tourBookingId], references: [id], onDelete: SetNull)
  groupBooking GroupBooking? @relation(fields: [groupBookingId], references: [id], onDelete: SetNull)

  @@index([provider])
  @@index([eventId])
  @@index([invoiceId])
  @@index([tourBookingId])
  @@index([groupBookingId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentChannel])
  @@index([paymentChannel, status, createdAt])
  @@map("payment_events")
}

// =========================================================
//  NOTIFICATION MODEL - For user notifications (owners, drivers, admins, customers)
// =========================================================
model Notification {
  id Int @id @default(autoincrement())

  /// User who receives this notification (can be owner, driver, admin, or customer)
  userId Int?

  /// Owner-specific notifications (legacy field for backward compatibility)
  ownerId Int?

  /// Notification title
  title String @db.VarChar(200)

  /// Notification body/content
  body String @db.Text

  /// Whether this notification has been read
  unread Boolean @default(true)

  /// Additional metadata (JSON: can store template, action links, etc.)
  meta Json?

  /// Notification type/category (e.g., 'property', 'booking', 'invoice', 'system')
  type String? @db.VarChar(50)

  /// Timestamp when notification was read
  readAt DateTime?

  /// Record creation timestamp
  createdAt DateTime @default(now())

  /// Record last update timestamp
  updatedAt DateTime @updatedAt

  // Relations
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  owner User? @relation("OwnerNotifications", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ownerId])
  @@index([unread])
  @@index([type])
  @@index([createdAt])
  @@index([userId, unread])
  @@index([ownerId, unread])
  @@map("notification")
}

// =========================================================
//  PLAN REQUEST MODEL - For "Plan With Us" custom trip planning requests
// =========================================================
model PlanRequest {
  id Int @id @default(autoincrement())

  /// Role of the requester: Event planner, School / Teacher, University, Community group, Other
  role String @db.VarChar(100)

  /// Type of trip: Local tourism, Safari, Cultural, Adventure / Hiking, Other
  tripType String @db.VarChar(100)

  /// Request status: NEW, PENDING, IN_PROGRESS, COMPLETED
  status String @default("NEW") @db.VarChar(50)

  /// Customer contact information
  fullName String  @db.VarChar(200)
  email    String  @db.VarChar(255)
  phone    String? @db.VarChar(40)

  /// Optional reference to User account (if user is logged in)
  /// If null, request was submitted anonymously (matched by email/phone)
  userId Int?

  /// Trip details
  destinations String?   @db.VarChar(500)
  dateFrom     DateTime?
  dateTo       DateTime?
  groupSize    Int?
  budget       Decimal?  @db.Decimal(12, 2)
  notes        String?   @db.Text

  /// Transport requirements
  transportRequired   Boolean? @default(false)
  vehicleType         String?  @db.VarChar(100)
  pickupLocation      String?  @db.VarChar(500)
  dropoffLocation     String?  @db.VarChar(500)
  vehiclesNeeded      Int?
  passengerCount      Int?
  vehicleRequirements String?  @db.Text

  /// Role-specific data stored as JSON (for event planner, school, university, community fields)
  roleSpecificData Json?

  /// Admin response fields
  adminResponse        String?   @db.Text
  suggestedItineraries String?   @db.Text
  requiredPermits      String?   @db.Text
  estimatedTimeline    String?   @db.Text
  assignedAgent        String?   @db.VarChar(200) // Legacy field (name string)
  assignedAgentId      Int? // New field (reference to Agent)
  respondedAt          DateTime?

  /// Record creation timestamp
  createdAt DateTime @default(now())
  /// Record last update timestamp
  updatedAt DateTime @updatedAt

  // Relations
  user                  User?                @relation("PlanRequestsUser", fields: [userId], references: [id], onDelete: SetNull)
  assignedAgentRelation Agent?               @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  agentReviews          AgentReview[]        @relation("AgentReviewsPlanRequest")
  messages              PlanRequestMessage[]

  @@index([role])
  @@index([tripType])
  @@index([status])
  @@index([email])
  @@index([phone])
  @@index([userId])
  @@index([assignedAgentId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([userId, status])
  @@map("plan_requests")
}

// =========================================================
//  PLAN REQUEST MESSAGE MODEL - For conversation history
// =========================================================
model PlanRequestMessage {
  id            Int @id @default(autoincrement())
  planRequestId Int

  /// Sender information
  senderId   Int? // User ID if sender is authenticated (admin or customer)
  senderRole String  @db.VarChar(20) // ADMIN, USER, SYSTEM
  senderName String? @db.VarChar(200) // Name for display (if not authenticated)

  /// Message content
  messageType String? @db.VarChar(50) // "Ask for Feedback", "Admin Response", etc.
  body        String  @db.Text // Message content (sanitized)

  /// Metadata
  isInternal Boolean  @default(false) // Internal notes not shown to customers
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  planRequest PlanRequest @relation(fields: [planRequestId], references: [id], onDelete: Cascade)
  sender      User?       @relation("PlanRequestMessages", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([planRequestId])
  @@index([senderId])
  @@index([senderRole])
  @@index([createdAt])
  @@index([planRequestId, createdAt])
  @@map("plan_request_messages")
}

// =========================================================
//  AGENT MODEL - For managing travel/tour agents
// =========================================================
model Agent {
  id Int @id @default(autoincrement())

  /// Reference to User account (agents are Users with role 'AGENT')
  userId Int @unique

  /// Agent status: ACTIVE, INACTIVE, SUSPENDED
  status String @default("ACTIVE") @db.VarChar(50)

  /// Education level: HIGH_SCHOOL, DIPLOMA, BACHELORS, MASTERS, PHD, OTHER
  educationLevel String? @db.VarChar(100)

  /// Area of operations (JSON array of regions/districts)
  /// Example: ["Dar es Salaam", "Arusha", "Zanzibar"]
  areasOfOperation Json? // Array of strings

  /// Certifications (JSON array)
  /// Example: [{"name": "Tourism Certificate", "issuer": "Tanzania Tourism Board", "year": 2020}]
  certifications Json? // Array of {name, issuer, year, expiryDate?}

  /// Languages spoken (JSON array)
  /// Example: ["English", "Swahili", "French"]
  languages Json? // Array of strings

  /// Years of experience in tourism/travel industry
  yearsOfExperience Int?

  /// Specializations (JSON array)
  /// Example: ["Safari Tours", "Cultural Tours", "Adventure Tourism", "Group Travel"]
  specializations Json? // Array of strings

  /// Bio/Description
  bio String? @db.Text

  /// Availability status
  isAvailable Boolean @default(true)

  /// Maximum number of active requests this agent can handle simultaneously
  maxActiveRequests Int @default(10)

  /// Current workload (number of active requests assigned)
  currentActiveRequests Int @default(0)

  /// Performance metrics (JSON)
  /// Example: {totalRequests: 50, completedRequests: 45, averageRating: 4.5, responseTime: 2.5}
  performanceMetrics Json?

  /// Customer-facing operator/company marketplace profile
  operatorProfile Json?

  /// Agent level/rank: BRONZE, SILVER, GOLD, PLATINUM
  level String @default("BRONZE") @db.VarChar(20)

  /// Total completed trips/requests (count of COMPLETED or CLOSED plan requests)
  totalCompletedTrips Int @default(0)

  /// Total revenue generated for NoLSAF (in TZS) - sum of commissions from completed trips
  totalRevenueGenerated Decimal @default(0) @db.Decimal(15, 2)

  /// Suspension metadata — populated when status = SUSPENDED
  suspendedAt      DateTime? /// Timestamp when the suspension was applied
  suspensionReason String?   @db.VarChar(1000) /// Reason recorded by the admin (max 1000 chars)
  suspendedBy      Int? /// Admin user ID who applied the suspension

  /// Restoration metadata — populated when agent is reinstated from suspension
  restoredAt DateTime? /// Timestamp when access was reinstated
  restoredBy Int? /// Admin user ID who reinstated the agent

  /// Created and updated timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedPlanRequests PlanRequest[]    @relation("AssignedAgent")
  applications         JobApplication[] @relation // All job applications that resulted in this agent's hire
  reviews              AgentReview[] // Reviews received from users
  tourBookings         TourBooking[]    @relation("AgentTourBookings")
  tourPackages         TourPackage[]

  @@index([status])
  @@index([isAvailable])
  @@index([userId])
  @@index([status, isAvailable])
  @@map("agent")
}

// =========================================================
//  AGENT REVIEW MODEL - For user ratings of agents
// =========================================================
model AgentReview {
  id Int @id @default(autoincrement())

  /// Agent being reviewed
  agentId Int

  /// User who wrote the review (customer who worked with the agent)
  userId Int

  /// Optional: Link to the plan request that this review is for (legacy Plan-With-Us flow)
  planRequestId Int?

  /// Optional: Link to the tour booking this review is for (current operator flow).
  /// Unique so a completed booking can be reviewed at most once.
  tourBookingId Int? @unique

  /// Punctuality rating (1-5)
  punctualityRating Int // 1-5

  /// Customer care rating (1-5)
  customerCareRating Int // 1-5

  /// Communication rating (1-5)
  communicationRating Int // 1-5

  /// Optional review comment
  comment String? @db.Text

  /// Record creation timestamp
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  agent       Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user        User         @relation("AgentReviewsUser", fields: [userId], references: [id], onDelete: Cascade)
  planRequest PlanRequest? @relation("AgentReviewsPlanRequest", fields: [planRequestId], references: [id], onDelete: SetNull)
  tourBooking TourBooking? @relation("AgentReviewsTourBooking", fields: [tourBookingId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([userId])
  @@index([planRequestId])
  @@index([tourBookingId])
  @@index([createdAt])
  @@index([agentId, createdAt])
  @@map("agent_reviews")
}

// =========================================================
//  JOB MODEL - For career/job postings
// =========================================================
model Job {
  id Int @id @default(autoincrement())

  /// Job title
  title String @db.VarChar(200)

  /// Department/Category: ENGINEERING, DESIGN, MARKETING, SALES, OPERATIONS, SUPPORT, MANAGEMENT, OTHER
  category String @db.VarChar(50)

  /// Job type: FULL_TIME, PART_TIME, CONTRACT, INTERNSHIP, FREELANCE
  type String @db.VarChar(50)

  /// Location type: REMOTE, ONSITE, HYBRID
  location String @db.VarChar(50)

  /// Specific location detail (e.g., "Dar es Salaam, Tanzania")
  locationDetail String? @db.VarChar(200)

  /// Department name (e.g., "Engineering", "Design")
  department String @db.VarChar(100)

  /// Job description
  description String @db.Text

  /// Key responsibilities (stored as JSON array)
  responsibilities Json // Array of strings

  /// Requirements (stored as JSON array)
  requirements Json // Array of strings

  /// Benefits (stored as JSON array)
  benefits Json // Array of strings

  /// Experience level: ENTRY, MID, SENIOR, LEAD
  experienceLevel String @db.VarChar(20)

  /// Required education level for this job (when set, applications must match)
  /// Values: HIGH_SCHOOL, DIPLOMA, BACHELORS, MASTERS, PHD, OTHER
  requiredEducationLevel String? @db.VarChar(100)

  /// Salary information (stored as JSON: { min, max, currency, period })
  salary Json? // { min?: number, max?: number, currency?: string, period?: "MONTHLY" | "YEARLY" }

  /// Date when job was posted
  postedDate DateTime @default(now())

  /// Application deadline
  applicationDeadline DateTime?

  /// Whether this job is featured
  featured Boolean @default(false)

  /// Whether this job is a Travel Agent recruitment position
  isTravelAgentPosition Boolean @default(false)

  /// Job status: ACTIVE, CLOSED, DRAFT
  status String @default("ACTIVE") @db.VarChar(20)

  /// Created by admin user ID
  createdBy Int?

  /// Last updated by admin user ID
  updatedBy Int?

  /// Record creation timestamp
  createdAt DateTime @default(now())

  /// Record last update timestamp
  updatedAt DateTime @updatedAt

  // Relations
  createdByUser User? @relation("JobsCreated", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("JobsUpdated", fields: [updatedBy], references: [id], onDelete: SetNull)

  // Job applications submitted for this job
  applications JobApplication[]

  @@index([category])
  @@index([type])
  @@index([location])
  @@index([status])
  @@index([featured])
  @@index([postedDate])
  @@index([applicationDeadline])
  @@index([status, applicationDeadline])
  @@index([createdBy])
  @@map("job")
}

// =========================================================
//  JOB APPLICATION MODEL - For career/job applications
// =========================================================
model JobApplication {
  id Int @id @default(autoincrement())

  /// Job this application is for
  jobId Int

  /// Applicant information
  fullName String @db.VarChar(200)
  email    String @db.VarChar(255)
  phone    String @db.VarChar(40)

  /// Applicant location (Tanzania: Region & District)
  region   String? @db.VarChar(100)
  district String? @db.VarChar(100)

  /// Applicant nationality (selected from dataset in UI)
  nationality String? @db.VarChar(100)

  /// Applicant education level (if captured)
  educationLevel String? @db.VarChar(40)

  /// Applicant years of experience (if captured)
  yearsOfExperience Int?

  /// Applicant languages (array of strings)
  languages Json?

  /// Application content
  coverLetter String @db.Text

  /// Optional fields
  portfolio  String? @db.VarChar(500)
  linkedIn   String? @db.VarChar(500)
  referredBy String? @db.VarChar(200)

  /// Resume file information
  resumeFileName   String? @db.VarChar(255)
  resumeStorageKey String? @db.VarChar(500) // S3 key or storage path
  resumeUrl        String? @db.Text // Full URL to resume
  resumeSize       Int? // File size in bytes
  resumeType       String? @db.VarChar(100) // MIME type

  /// Application status: PENDING, REVIEWING, SHORTLISTED, REJECTED, HIRED
  status String @default("PENDING") @db.VarChar(20)

  /// Track which statuses have been used (prevents duplicate status changes)
  usedStatuses Json? // Array of status strings that have been set

  /// Admin notes
  adminNotes String? @db.Text

  /// Review timestamps
  reviewedAt DateTime?
  reviewedBy Int? // Admin user ID

  /// Agent-specific application data (for Travel Agent positions)
  /// Stores: educationLevel, yearsOfExperience, areasOfOperation, certifications, languages, specializations, bio, maxActiveRequests
  agentApplicationData Json? // Object with agent profile fields

  /// Link to Agent profile if application is approved (status = HIRED)
  /// Not @unique — same agent may be linked from multiple applications over time.
  agentId Int?

  /// Record creation timestamp
  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  job            Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewedByUser User?  @relation("JobApplicationsReviewed", fields: [reviewedBy], references: [id], onDelete: SetNull)
  agent          Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([email])
  @@index([status])
  @@index([submittedAt])
  @@index([status, submittedAt])
  @@index([reviewedBy])
  @@map("jobapplication")
}

// =========================================================
//  CANCELLATION REQUEST MODEL - Customer-initiated cancellations (subject to policy)
// =========================================================
model CancellationRequest {
  id          Int    @id @default(autoincrement())
  bookingId   Int
  userId      Int
  bookingCode String @db.VarChar(32)

  /// Workflow status: SUBMITTED, REVIEWING, NEED_INFO, APPROVED, REFUND_PENDING, REFUNDED, REJECTED
  status String  @default("SUBMITTED") @db.VarChar(20)
  reason String? @db.Text

  /// Snapshot of policy evaluation at submission time
  policyEligible      Boolean @default(false)
  policyRefundPercent Int? // 0, 50, 100
  policyRule          String? @db.VarChar(40)

  /// Admin review fields (optional)
  reviewedAt   DateTime?
  reviewedBy   Int?
  decisionNote String?   @db.Text
  approvedAt        DateTime?
  approvedByAdminId Int?
  refundAmount      Decimal?  @db.Decimal(12, 2)
  refundProvider    String?   @db.VarChar(80)
  refundReference   String?   @db.VarChar(160)
  refundInitiatedAt DateTime?
  refundedAt        DateTime?
  /// Itemised payment-channel and administrative charges applied to the refund (policy section 8.4)
  refundChargesJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  booking        Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedByUser User?                 @relation("CancellationReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  messages       CancellationMessage[]

  @@index([bookingId])
  @@index([userId])
  @@index([bookingCode])
  @@index([status])
  @@map("cancellation_requests")
}

// =========================================================
//  CANCELLATION MESSAGE MODEL - Admin <-> Customer communication for claims
// =========================================================
model CancellationMessage {
  id                    Int      @id @default(autoincrement())
  cancellationRequestId Int
  senderId              Int
  senderRole            String   @db.VarChar(20) // ADMIN | USER
  body                  String   @db.Text
  createdAt             DateTime @default(now())

  // Relations
  request CancellationRequest @relation(fields: [cancellationRequestId], references: [id], onDelete: Cascade)
  sender  User                @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([cancellationRequestId])
  @@index([senderId])
  @@index([createdAt])
  @@map("cancellation_messages")
}

// =========================================================
//  DRIVER REMINDER MODEL - Reminders for drivers (license expiry, insurance, etc.)
// =========================================================
model DriverReminder {
  id         Int       @id @default(autoincrement())
  driverId   Int
  type       String    @db.VarChar(30) // INFO, WARNING, ALERT, PROMOTION, POLICY_VIOLATION, SAFETY, LICENSE_EXPIRY, INSURANCE_EXPIRY
  message    String    @db.Text
  action     String?   @db.VarChar(100) // Optional action button text
  actionLink String?   @db.VarChar(255) // Optional action link
  expiresAt  DateTime? // Optional expiration date for the reminder
  meta       Json? // Additional metadata (documentId, autoGenerated, etc.)
  read       Boolean   @default(false) // Whether the driver has read this reminder

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  driver User @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([type])
  @@index([read])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("driver_reminders")
}

// =========================================================
//  CHATBOT CONVERSATION MODEL - For Twiga chatbot conversations
// =========================================================
model ChatbotConversation {
  id            Int       @id @default(autoincrement())
  userId        Int? // Optional: user ID if authenticated
  sessionId     String    @unique @db.VarChar(100) // Unique session identifier for anonymous users
  language      String    @default("en") @db.VarChar(10) // Language code: en, es, fr, pt, ar, zh
  needsFollowUp Boolean   @default(false) // Track if conversation needs agent follow-up
  followUpNotes String?   @db.Text // Notes for agents about the conversation
  followedUpAt  DateTime? // When an agent followed up
  followedUpBy  Int? // Agent/admin user ID who followed up
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user     User?            @relation("ChatbotConversations", fields: [userId], references: [id], onDelete: SetNull)
  messages ChatbotMessage[]

  @@index([userId])
  @@index([sessionId])
  @@index([language])
  @@index([createdAt])
  @@index([needsFollowUp])
  @@map("chatbot_conversations")
}

// =========================================================
//  CHATBOT MESSAGE MODEL - Individual messages in chatbot conversations
// =========================================================
model ChatbotMessage {
  id             Int      @id @default(autoincrement())
  conversationId Int
  role           String   @db.VarChar(20) // "user" | "assistant"
  content        String   @db.Text
  language       String   @default("en") @db.VarChar(10) // Language code at time of message
  createdAt      DateTime @default(now())

  // Relations
  conversation ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([role])
  @@index([createdAt])
  @@index([conversationId, createdAt])
  @@map("chatbot_messages")
}

// =========================================================
//  SAVED PROPERTY MODEL - For users to save/favorite properties
// =========================================================
model SavedProperty {
  id         Int       @id @default(autoincrement())
  userId     Int // User who saved the property
  propertyId Int // Property that was saved
  savedAt    DateTime  @default(now()) // When the property was saved
  sharedAt   DateTime? // When the property was shared (optional)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Ensure a user can only save a property once
  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@index([savedAt])
  @@index([sharedAt])
  @@map("savedproperty")
}

// =========================================================
//  PROPERTY AVAILABILITY BLOCK MODEL
//  Tracks manual availability blocks for external bookings
//  (Airbnb, Booking.com, walk-ins, etc.)
// =========================================================
model PropertyAvailabilityBlock {
  id         Int @id @default(autoincrement())
  propertyId Int
  ownerId    Int // Owner who created the block

  /// Start date of the block
  startDate DateTime
  /// End date of the block (exclusive, like checkout)
  endDate   DateTime

  /// Optional room code if blocking specific room
  roomCode String? @db.VarChar(60)

  /// Source of the booking (e.g., "AIRBNB", "BOOKING_COM", "WALK_IN", "OTHER")
  source String? @db.VarChar(50)

  /// Guest details for external bookings
  guestName   String? @db.VarChar(160)
  guestPhone  String? @db.VarChar(40)
  nationality String? @db.VarChar(80)

  /// Pricing snapshot for external bookings
  roomRate         Decimal? @db.Decimal(12, 2)
  calculatedAmount Decimal? @db.Decimal(12, 2)
  amountPaid       Decimal? @db.Decimal(12, 2)
  paidVia          String?  @db.VarChar(20)
  currency         String?  @db.VarChar(8)

  /// Optional notes about the block
  notes String? @db.Text

  /// Number of beds/rooms blocked (for room-type level tracking)
  bedsBlocked Int? @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner    User     @relation("PropertyAvailabilityBlocks", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([ownerId])
  @@index([startDate, endDate])
  @@index([propertyId, startDate, endDate])
  @@index([roomCode])
  @@map("propertyavailabilityblock")
}

// =========================================================
//  KYC AUDIT LOG
// =========================================================
model KycAuditLog {
  id             Int      @id @default(autoincrement())
  driverId       Int
  adminId        Int?
  action         String   @db.VarChar(32) // approve | reject | request_info | field_review
  note           String?  @db.Text
  fieldApprovals Json? // snapshot of kycFieldApprovals at time of action
  createdAt      DateTime @default(now())

  driver User @relation("DriverKycAuditLogs", fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([driverId, createdAt])
  @@map("kyc_audit_log")
}

// =========================================================
//  PODCAST EPISODES
// =========================================================
model PodcastEpisode {
  id           String    @id @db.VarChar(64)
  title        String    @db.VarChar(300)
  description  String    @db.Text
  youtubeUrl   String    @db.VarChar(500)
  thumbnailUrl String?   @db.VarChar(500)
  guestName    String?   @db.VarChar(200)
  guestRole    String?   @db.VarChar(200)
  tags         Json? // e.g. ["interview","stakeholder","update"]
  duration     String?   @db.VarChar(20) // e.g. "12:34"
  published    Boolean   @default(false)
