model NrmsReviewRequest {
  id             Int       @id @default(autoincrement())
  propertyId     Int
  reservationId  Int       @unique
  guestProfileId Int?
  channel        String    @default("SMS") @db.VarChar(20)
  status         String    @default("SCHEDULED") @db.VarChar(20)
  publicToken    String    @unique @db.VarChar(80)
  sendAfter      DateTime
  sentAt         DateTime?
  openedAt       DateTime?
  respondedAt    DateTime?
  rating         Int?
  feedback       String?   @db.VarChar(1000)
  /// Per-category scores, same JSON shape as PropertyReview.categoryRatings.
  /// Only the categories the property opted into are stored. e.g. { "security": 5, "customerCare": 4 }
  categoryRatings Json?
  /// Guest answer to "would you book through NoLSAF again": YES, MAYBE or NO.
  platformIntent  String?  @db.VarChar(10)
  /// Set when the overall rating is low enough to need a private follow-up
  /// instead of a public recommendation prompt. Drives the owner recovery queue.
  needsRecovery   Boolean  @default(false)
  recoveredAt     DateTime?
  recoveryNote    String?  @db.VarChar(500)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation  Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guestProfile GuestProfile? @relation(fields: [guestProfileId], references: [id], onDelete: SetNull)

  @@index([propertyId, status, sendAfter])
  @@index([propertyId, needsRecovery, recoveredAt])
  @@map("nrms_review_request")
}

model NrmsJourneyTemplate {
