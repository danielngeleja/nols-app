{
  "name": "@nolsaf/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm --prefix ../../packages/prisma run generate && npm --prefix ../../packages/prisma run build",
    "dev": "tsx watch src/index.ts",
    "prebuild": "node scripts/prepare-eb-package-lock.mjs --validate && npm --prefix ../../packages/prisma run generate && npm --prefix ../../packages/prisma run build",
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-imports.mjs && node scripts/write-release-metadata.mjs",
    "eb:lock:validate": "node scripts/prepare-eb-package-lock.mjs --validate",
    "start": "node dist/src/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/dev/seed.ts",
    "seed:nolscope": "tsx src/dev/seed-nolscope.ts",
    "bootstrap:admin": "tsx src/dev/bootstrap-admin.ts",
    "bootstrap:admin:staging": "tsx src/dev/bootstrap-admin.ts --staging",
    "bootstrap:admin:production": "tsx src/dev/bootstrap-admin.ts --production",
    "pretest": "npm --prefix ../../packages/prisma run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "load:test": "tsx scripts/load-test.ts",
    "load:test:socket": "tsx scripts/socket-load-test.ts",
    "load:test:capacity": "tsx scripts/capacity-suite.ts",
    "smoke:driver-payouts": "tsx scripts/seed-driver-payout-smoke.ts",
    "azp:disbursement:test": "tsx scripts/test-azampay-disbursement.ts",
    "generate:encryption-key": "node scripts/generate-encryption-key.js",
    "azp:ids": "tsx scripts/collect-azp-ids.ts",
    "ngrok:dev": "ngrok http 4000"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.956.0",
    "@aws-sdk/client-ses": "^3.956.0",
    "@aws-sdk/s3-presigned-post": "^3.956.0",
    "@aws-sdk/s3-request-presigner": "^3.956.0",
    "@prisma/adapter-mariadb": "7.9.1",
    "@prisma/client": "7.9.1",
    "@simplewebauthn/server": "^8.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@stripe/stripe-js": "^8.5.3",
    "@types/multer": "^2.0.0",
    "@types/pdfkit": "^0.17.5",
    "argon2": "^0.44.0",
    "axios": "^1.16.0",
    "body-parser": "^1.20.3",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "fast-xml-parser": "5.7.1",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.1",
    "ipaddr.js": "^2.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "resend": "^6.9.3",
    "sanitize-html": "^2.17.4",
    "socket.io": "^4.7.5",
    "stripe": "^20.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.20",
    "@types/nodemailer": "^7.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "4.1.4",
    "@vitest/pretty-format": "4.1.4",
    "baseline-browser-mapping": "^2.9.13",
    "eslint": "^9.39.5",
    "prisma": "7.9.1",
    "supertest": "^7.2.2",
    "tinyrainbow": "^3.0.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.65.0",
    "vitest": "4.1.4"
  }
}
