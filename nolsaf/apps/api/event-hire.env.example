# Reference only. This file is not loaded automatically and contains no secrets.
# Keep requests and collections disabled until both migrations are approved and
# applied, Prisma is generated, and isolated MySQL concurrency tests pass:
#   20261127170000_event_hire_requests
#   20261127200000_event_hire_workspace
EVENT_HIRE_REQUESTS_ENABLED=false
EVENT_HIRE_PAYMENTS_ENABLED=false

# Web build-time flag (configure on the web deployment, not only the API).
NEXT_PUBLIC_EVENT_HIRE_REQUESTS_ENABLED=false

# Collection uses the existing secure CORAL_UCF_* credentials and WEB_ORIGIN.
# Use provider-approved values. No sandbox defaults are accepted in production.
EVENT_HIRE_CARD_CALLBACK_URL=
EVENT_HIRE_CARD_CHECKOUT_HOSTS=
EVENT_HIRE_CARD_CALLBACK_ALLOWED_IPS=
EVENT_HIRE_CARD_CALLBACK_VERIFIED=false

# Callback URL path must be /api/event-hire/card-callback over HTTPS.
# CHECKOUT_HOSTS: comma-separated exact HTTPS redirect hostnames, no wildcards.
# CALLBACK_ALLOWED_IPS: comma-separated exact provider IPs, not CDN addresses.
# Verify trusted ingress req.ip behavior and direct-origin callback routing.
# Redact callback query strings (including cap) and encrypted bodies from logs.
# Set CALLBACK_VERIFIED=true only after sandbox/end-to-end proof is reviewed.
# Existing payout provider configuration and finance approval controls still apply.

# Optional, disposable LOCAL test database only; never production DATABASE_URL.
# Database name must start nolsaf_event_test_ and migrations must already exist.
EVENT_HIRE_TEST_DATABASE_URL=
EVENT_HIRE_TEST_DB_ALLOW_WRITE=false
