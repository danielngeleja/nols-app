{
  "expo": {
    "name": "NoLSAF",
    "slug": "nolsaf",
    "version": "0.1.2",
    "userInterfaceStyle": "light",
    "scheme": "nolsaf",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "7",
      "bundleIdentifier": "com.nolsaf.app",
      "associatedDomains": [
        "webcredentials:nolsaf.com",
        "applinks:nolsaf.com"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "NoLSAF uses your location to set your pickup point so a driver can collect you and bring you to your booked stay.",
        "NSFaceIDUsageDescription": "NoLSAF uses Face ID to unlock the app so only you can open your bookings and payments."
      }
    },
    "android": {
      "package": "com.nolsaf.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 48,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "nolsaf.com",
              "pathPrefix": "/register"
            },
            {
              "scheme": "https",
              "host": "www.nolsaf.com",
              "pathPrefix": "/register"
            },
            {
              "scheme": "https",
              "host": "nolsaf.com",
              "pathPrefix": "/verify/property"
            },
            {
              "scheme": "https",
              "host": "www.nolsaf.com",
              "pathPrefix": "/verify/property"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1C7975"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NoLSAF uses your location to set your pickup point so a driver can collect you and bring you to your booked stay."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/Splash.png",
          "backgroundColor": "#ffffff",
          "resizeMode": "contain",
          "imageWidth": 240
        }
      ],
      "expo-web-browser",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "0cc4c67d-243c-43ab-82cf-4fb6d76612a0"
      }
    }
  }
}
