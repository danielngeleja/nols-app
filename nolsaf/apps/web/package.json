{
  "name": "@nolsaf/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "node -e \"require('fs').rmSync('.next',{ recursive:true, force:true, maxRetries:10, retryDelay:100 })\"",
    "prebuild": "node -e \"require('fs').rmSync('.next',{ recursive:true, force:true, maxRetries:10, retryDelay:100 })\"",
    "dev": "next dev --webpack -p 3000",
    "build": "npm --prefix ../../packages/shared run build && node scripts/run-next-build.mjs && node scripts/collect-private-source-maps.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test middleware.auth-login-redirect.test.mjs middleware.post-auth-routing.test.mjs post-auth-routing.test.mjs public-mobile-navigation.test.mjs nrms-report-pdf.test.mjs cookie-consent.test.mjs partnership-workspaces.test.mjs password-policy.test.mjs otp-rate-limit.test.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@nolsaf/shared": "file:../../packages/shared",
    "@react-google-maps/api": "^2.20.7",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.5.3",
    "@types/mapbox-gl": "^3.4.1",
    "axios": "^1.16.0",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.23.26",
    "html2pdf.js": "^0.14.0",
    "ioredis": "^5.4.1",
    "ipaddr.js": "^2.0.1",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.545.0",
    "mapbox-gl": "^3.17.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "page-flip": "^2.0.7",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.1",
    "react": "^18.2.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.7",
    "sanitize-html": "^2.17.4",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "20.19.20",
    "@types/papaparse": "^5.5.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/sanitize-html": "^2.16.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "autoprefixer": "^10.4.23",
    "baseline-browser-mapping": "^2.9.13",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
